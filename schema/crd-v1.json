  "schema": {
    "type": "object",
    "properties": {
      "apiVersion": {
        "type": "string"
      },
      "kind": {
        "type": "string"
      },
      "metadata": {
        "type": "object"
      },
      "spec": {
        "type": "object",
        "properties": {
          "group": {
            "type": "string"
          },
          "scope": {
            "type": "string",
