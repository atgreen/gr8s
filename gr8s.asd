                                           (:file "podtemplates")
                                           (:file "workload-resources")
                                           (:file "statefulset-resources")
                                           (:file "batch-resources")
                                           (:file "budget-resources")
                                           (:file "cron-schedule")
                                           (:file "cronjob-resources")
                                           (:file "re2")
                                           (:file "admission-cel")
                                           (:file "cel-library")
                                           (:file "admission-resources")
                                           (:file "storage-api")
                                           (:file "namespace-lifecycle")
                                           (:file "policy-resources")
                                           (:file "typed-apis")
                                           (:file "pod-admission-policy")
                                           (:file "resource-quota")
                                           (:file "pod-resource-fit")
                                           (:file "pod-affinity")
                                           (:file "pod-level-resources")
                                           (:file "pod-topology-spread")
                                           (:file "node-taints")
                                           (:file "pod-node-admission")
                                           (:file "endpointslice-api")
                                           (:file "work-queue")
                                           (:file "storage-provisioner")
                                           (:file "networking-api")
                                           (:file "storage-controller")
                                           (:file "csi-api")
                                           (:file "events")
                                           (:file "node-runtime-events")
                                           (:file "csr-resources")
                                           (:file "csr-signer")
                                           (:file "crd-formats")
                                           (:file "crd-schema")
                                           (:file "crd-conversion")
                                           (:file "crd-validation-rules")
                                           (:file "crd-structural")
                                           (:file "crd-resources")
                                           (:file "crd-protobuf")
                                           (:file "crd-deletion")
                                           (:file "node-lease")
                                           (:file "compat")))
                             (:module "apiserver-node-session"
                              :pathname "apiserver/"
                              :serial t
                              :components ((:file "node-session-integration")
                                           (:file "node-session")
                                           (:file "node-session-compat")))
                             (:module "runtime"
