;;;; SPDX-FileCopyrightText: 2026 Anthony Green
;;;; SPDX-License-Identifier: MIT
;;;;
;;;; Purpose:
;;;; Describe the serial load order and dependencies of the gr8s control plane,
;;;; node agent, networking dataplane, and their FiveAM test system.  The order
;;;; mirrors architectural dependencies so later modules can rely on the public
;;;; abstractions established by earlier files.

(asdf:defsystem "gr8s"
  :description "A small Kubernetes-compatible control plane in Common Lisp"
  :author "gr8s contributors"
  :license "MIT"
  :version "0.1.0"
  :depends-on ("0conf/dns-wire" "ag-grpc" "bordeaux-threads" "cl-cancel"
               "com.inuoe.jzon" "hunchentoot" "cl-ppcre"
               "pure-tls/acme" "drakma"
               "sb-posix" "trivial-utf-8" "usocket" "whistler/loader")
  :serial t
  :components ((:static-file "schema/podtemplate-v1.json")
               (:static-file "schema/crd-v1.json")
               (:static-file "schema/crd-wire-v1.json")
               (:static-file "schema/workloads-v1.json")

               (:static-file "schema/storage-v1.json")
               (:static-file "schema/certificates-v1.json")
               (:static-file "schema/endpointslices-v1.json")
               (:module "src"
                :serial t
                :components ((:file "package")
                             (:file "grpc-close-compat")
                             (:file "cri-v1-generated")
                             (:file "cri-wire-compat")
                             (:file "node-v1-generated")
                             (:file "node-protocol")
                             (:file "grpc-unix")
                             (:file "websocket")
                             (:file "dns")
                             (:file "model")
                             (:file "pod-runtime-model")
                             (:file "container-resources")
                             (:file "container-probe-spec")
                             (:file "store")
                             (:file "pod-status-store")
                             (:file "pod-finalizers")
                             (:file "pod-deletion")
                             (:file "scheduler")
                             (:file "certificate-profiles")
                             (:file "pki")
                             (:file "node-tls")
                             (:file "csr-crypto")
                             (:file "core-resources")
                             (:file "podtemplate-history")
                             (:file "bootstrap-resources")
                             (:file "service-account")
                             (:file "api-identity")
                             (:file "core-resource-protobuf")
                             (:file "podtemplates")
                             (:file "workload-resources")
                             (:file "batch-resources")

                             (:file "storage-api")
                             (:file "endpointslice-api")
                             (:file "storage-controller")
                             (:file "events")
                             (:file "node-runtime-events")
                             (:file "csr-resources")
                             (:file "csr-signer")
                             (:file "crd-schema")
                             (:file "crd-structural")
                             (:file "crd-resources")
                             (:file "crd-protobuf")
                             (:file "crd-deletion")
                             (:file "node-session")
                             (:file "runtime")
                             (:file "runtime-deletion")
                             (:file "pod-conditions")
                             (:file "runtime-assets")
                             (:file "cni")
                             (:file "node-ipam")
                             (:file "rtnetlink")
                             (:file "endpoint-policy")
                             (:file "vxlan")
                             (:file "agent-cni")
                             (:file "routed-cni")
                             (:file "managed-containerd")
                             (:file "cri")
                             (:file "container-expansion")
                             (:file "containerd")
                             (:file "pod-hostname")
                             (:file "pod-dns-config")
                             (:file "container-lifecycle")
                             (:file "init-containers")
                             (:file "containerd-pod-finalizers")
                             (:file "container-probe-transport")
                             (:file "container-probe-manager")
                             (:file "podman")
                             (:file "reconciler")
                             (:file "service-dns")
                             (:file "service-dns-reverse")
                             (:file "control-plane-runtime")
                             (:file "pod-volumes")
                             (:file "pod-subpaths")
                             (:file "storage-volumes")
                             (:file "telemetry")
                             (:file "agent-runtime")
                             (:file "pod-http-proxy")
                             (:file "http")
                             (:file "core-resource-http")
                             (:file "storage-http")
                             (:file "csr-http")
                             (:file "podtemplate-watch")
                             (:file "pod-watch")
                             (:file "crd-http")
                             (:file "crd-status")
                             (:file "crd-openapi")
                             (:file "server")
                             (:file "in-cluster-api")
                             (:file "services")
                             (:file "endpointslice-controller")
                             (:file "endpointslice-http")
                             (:file "garbage-collection")
                             (:file "crd-garbage-collection")
                             (:file "workload-controller")
                             (:file "job-policy")
                             (:file "job-controller")
                             (:file "workload-deletion")
                             (:file "workload-http")
                             (:file "main"))))
  :in-order-to ((test-op (test-op "gr8s/tests"))))

(asdf:defsystem "gr8s/tests"
  :depends-on ("gr8s" "drakma" "fiveam")
  :serial t
  :components ((:module "tests"
                :serial t
                :components ((:file "package")
                             (:file "websocket-test")
                             (:file "node-protocol-test")
                             (:file "dns-test")
                             (:file "dns-port-pair-test")
                             (:file "model-test")
                             (:file "store-test")
                             (:file "core-resources-test")
                             (:file "crd-schema-test")
                             (:file "scheduler-test")
                             (:file "pki-test")
                             (:file "node-session-test")
                             (:file "reconciler-test")
                             (:file "agent-runtime-test")
                             (:file "grpc-unix-test")
                             (:file "grpc-close-test")
                             (:file "cri-test")
                             (:file "runtime-assets-test")
                             (:file "cni-test")
                             (:file "node-ipam-test")
                             (:file "rtnetlink-test")
                             (:file "managed-containerd-test")
                             (:file "containerd-test")
                             (:file "container-lifecycle-test")
                             (:file "init-containers-test")
                             (:file "container-probe-test")
                             (:file "container-probe-manager-test")
                             (:file "container-probe-events-test")
                             (:file "podman-test")
                             (:file "main-test")
                             (:file "http-test")
                             (:file "pod-http-proxy-test")
                             (:file "core-resource-http-test")
                             (:file "crd-api-test")
                             (:file "crd-protobuf-test")
                             (:file "csr-crypto-test")
                             (:file "csr-api-test")
                             (:file "certificate-profiles-test")
                             (:file "podtemplates-test")
                             (:file "durable-resource-watches-test")
                             (:file "bootstrap-resource-test")
                             (:file "pod-volumes-test")
                             (:file "pod-subpaths-test")
                             (:file "container-resources-test")
                             (:file "pod-watch-test")
                             (:file "batch-resources-test")
                             (:file "job-policy-test")
                             (:file "job-controller-test")
                             (:file "storage-api-test")
                             (:file "storage-http-test")
                             (:file "service-account-test")
                             (:file "api-client-certificate-test")
                             (:file "bootstrap-protobuf-test")
                             (:file "events-test")
                             (:file "pod-deletion-test")
                             (:file "pod-finalizers-test")
                             (:file "generated-pod-names-test")
                             (:file "pod-conditions-test")
                             (:file "node-log-delivery-test")
                             (:file "garbage-collection-test")
                             (:file "services-test")
                             (:file "endpointslices-test")
                             (:file "service-dns-test")
                             (:file "container-expansion-test")
                             (:file "pod-hostname-test")
                             (:file "pod-dns-config-test")
                             (:file "telemetry-test")
                             (:file "workloads-test"))))
  :perform (test-op (operation component)
             (declare (ignore operation component))
             (unless (uiop:symbol-call
                      :fiveam :run!
                      (find-symbol "GR8S" "GR8S/TESTS"))
               (error "gr8s tests failed"))))
