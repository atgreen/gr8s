;;;;
;;;; Purpose:
;;;; Describe the serial load order and dependencies of the gr8s control plane,
;;;; node agent, networking dataplane, and their FiveAM test system.  The order
;;;; mirrors architectural dependencies so later modules can rely on the public
;;;; abstractions established by earlier files.

(asdf:defsystem "gr8s"
  :description "A small Kubernetes-compatible control plane in Common Lisp"
  :author "gr8s contributors"
  :license "Apache-2.0"
  ;; The Kubernetes API version gr8s implements. The gr8s release itself is this
  ;; base plus a "-gr8s.N" suffix carried in a git tag (e.g. v1.37.2-gr8s.0),
  ;; surfaced through VERSION-STRING as +GR8S-VERSION+ (see src/version.lisp).
  :version "1.37.2"
  :depends-on ("0conf/dns-wire" "ag-grpc" "bordeaux-threads" "cffi" "chipz" "cl-cancel"
               "com.inuoe.jzon" "hunchentoot" "cl-ppcre"
               "pure-tls/acme" "drakma" "ironclad"
               "sb-posix" "slynk" "trivial-utf-8" "usocket" "version-string"
               "whistler/loader" "whistler/bpftrace")
  :serial t
  :components ((:static-file "schema/podtemplate-v1.json")
               (:static-file "schema/crd-v1.json")
               (:static-file "schema/crd-wire-v1.json")
               (:static-file "schema/workloads-v1.json")
               (:static-file "schema/budget-v1.json")
               (:static-file "schema/admissionregistration-v1.json")

               (:static-file "schema/storage-v1.json")
               (:static-file "schema/policy-v1.json")
               (:static-file "schema/typed-apis-v1.json")
               (:static-file "schema/certificates-v1.json")
               (:static-file "schema/endpointslices-v1.json")
               (:static-file "schema/networking-v1.json")
               (:static-file "schema/openapi-v1.json")
               (:module "src"
                :serial t
                :components ((:file "generated/package")
                             (:module "raft"
                              :serial t
                              :components ((:file "package")
                                           (:file "core")
                                           (:file "log")))
                             (:file "package")
                             (:file "version")
                             (:module "generated"
                              :serial t
                              :components ((:file "cri-v1-generated")
                                           (:file "csi-v1-generated")
                                           (:file "pluginregistration-v1-generated")
                                           (:file "dra-v1-generated")
                                           (:file "containerd-tasks-v1-generated")
                                           (:file "containerd-transfer-v1-generated")
                                           (:file "cri-wire-compat")
                                           (:file "node-v1-generated")))
                             (:module "protocol-interface"
                              :pathname "protocol/"
                              :serial t
                              :components ((:file "package")
                                           (:file "node-protocol")))
                             (:file "foundation/dns")
                             (:file "foundation/json")
                             (:module "patch"
                              :serial t
                              :components ((:file "package") (:file "artifact")
                                           (:file "publisher") (:file "executor") (:file "coordinator")
                                           (:file "cli")))
                             (:file "foundation/network-steering")
                             (:module "image-distribution"
                              :serial t
                              :components ((:file "package")
                                           (:file "bencode")
                                           (:file "torrent-v2")
                                           (:file "tracker")
                                           (:file "peer-wire")
                                           (:file "piece-store")
                                           (:file "oci-cache")
                                           (:file "oci-mirror")))
                             (:module "model"
                              :serial t
                              :components ((:file "package")
                                           (:file "types")
                                           (:file "parsing")))
                             (:file "resources/package")
                             (:file "controllers/package")
                             (:file "apiserver/package")
                             (:file "runtime/package")
                             (:file "runtime/containerd/package")
                             (:file "store/package")
                             (:file "network/package")
                             (:file "security/package")
                             (:file "kubelet/package")
                             (:file "server/package")
                             (:file "kubelet/pod-parser-policy")
                             (:file "kubelet/env-files")
                             (:file "kubelet/user-namespaces")
                             (:file "kubelet/pod-runtime-model")
                             (:file "kubelet/pod-host-settings")
                             (:file "kubelet/pod-ephemeral")
                             (:file "kubelet/container-resources")
                             (:file "kubelet/container-probe-spec")
                             (:module "store"
                              :serial t
                              :components ((:file "types")
                                           (:file "policy")
                                           (:file "observations")
                                           (:file "journal")
                                           (:file "persistence")))
                             (:module "raft/transport"
                              :serial t
                              :components ((:file "package")
                                           (:file "member")
                                           (:file "cluster")))
                             (:module "ha"
                              :serial t
                              :components ((:file "package")
                                           (:file "store")
                                           (:file "plane")
                                           (:file "control-plane")))
                             (:file "kubelet/pod-status-store")
                             (:file "kubelet/pod-finalizers")
                             (:file "kubelet/pod-deletion")
                             (:file "controllers/scheduler")
                             (:module "security"
                              :serial t
                              :components ((:file "integration")
                                           (:file "certificate-profiles")
                                           (:file "pki")
                                           (:file "node-tls")
                                           (:file "image-peer-tls")
                                           (:file "raft-tls")
                                           (:file "csr-crypto")
                                           (:file "compat")))
                             (:module "resources"
                              :serial t
                              :components ((:file "integration")
                                           (:file "core-resources")
                                           (:file "api-defaults")
                                           (:file "yaml")
                                           (:file "podtemplate-history")
                                           (:file "bootstrap-resources")
                                           (:file "service-account-tokens")
