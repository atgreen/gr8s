;;;;
;;;; Purpose:
;;;; Describe the serial load order and dependencies of the gr8s control plane,
;;;; node agent, networking dataplane, and their FiveAM test system.  The order
;;;; mirrors architectural dependencies so later modules can rely on the public
;;;; abstractions established by earlier files.

(asdf:defsystem "gr8s"
  :description "A small Kubernetes-compatible control plane in Common Lisp"
  :author "gr8s contributors"
  :license "MIT"
  :version "0.1.0"
  :depends-on ("0conf/dns-wire" "ag-grpc" "bordeaux-threads" "cl-cancel"
               "com.inuoe.jzon" "hunchentoot" "cl-ppcre"
               "pure-tls/acme" "drakma"
               "sb-posix" "slynk" "trivial-utf-8" "usocket" "whistler/loader")
  :serial t
  :components ((:static-file "schema/podtemplate-v1.json")
               (:static-file "schema/crd-v1.json")
               (:static-file "schema/crd-wire-v1.json")
               (:static-file "schema/workloads-v1.json")
               (:static-file "schema/budget-v1.json")
               (:static-file "schema/admissionregistration-v1.json")

               (:static-file "schema/storage-v1.json")
               (:static-file "schema/policy-v1.json")
               (:static-file "schema/typed-apis-v1.json")
               (:static-file "schema/certificates-v1.json")
               (:static-file "schema/endpointslices-v1.json")
               (:static-file "schema/networking-v1.json")
               (:module "src"
                :serial t
                :components ((:file "package")
                             (:file "grpc-close-compat")
                             (:file "cri-v1-generated")
                             (:file "csi-v1-generated")
                             (:file "pluginregistration-v1-generated")
                             (:file "cri-wire-compat")
                             (:file "node-v1-generated")
                             (:file "node-protocol")
                             (:file "grpc-unix")
                             (:file "websocket")
                             (:file "dns")
                             (:file "model")
                             (:file "pod-runtime-model")
                             (:file "pod-host-settings")
                             (:file "pod-ephemeral")
                             (:file "container-resources")
                             (:file "container-probe-spec")
                             (:file "store")
                             (:file "pod-status-store")
                             (:file "pod-finalizers")
                             (:file "pod-deletion")
                             (:file "scheduler")
                             (:file "certificate-profiles")
                             (:file "pki")
                             (:file "node-tls")
                             (:file "csr-crypto")
                             (:file "core-resources")
                             (:file "yaml")
                             (:file "podtemplate-history")
                             (:file "bootstrap-resources")
                             (:file "service-account-tokens")
                             (:file "service-account")
                             (:file "api-identity")
                             (:file "auth-reviews")
                             (:file "core-resource-protobuf")
                             (:file "podtemplates")
                             (:file "workload-resources")
                             (:file "statefulset-resources")
                             (:file "batch-resources")
                             (:file "budget-resources")
                             (:file "cron-schedule")
                             (:file "cronjob-resources")
                             (:file "admission-cel")
                             (:file "admission-resources")

                             (:file "storage-api")
                             (:file "namespace-lifecycle")
                             (:file "policy-resources")
                             (:file "typed-apis")
                             (:file "pod-admission-policy")
                             (:file "resource-quota")
                             (:file "pod-resource-fit")
                             (:file "node-taints")
                             (:file "pod-node-admission")
                             (:file "endpointslice-api")
                             (:file "storage-provisioner")
                             (:file "networking-api")
                             (:file "storage-controller")
                             (:file "csi-api")
                             (:file "events")
                             (:file "node-runtime-events")
                             (:file "csr-resources")
                             (:file "csr-signer")
                             (:file "crd-schema")
                             (:file "crd-structural")
                             (:file "crd-resources")
                             (:file "crd-protobuf")
                             (:file "crd-deletion")
                             (:file "node-session")
                             (:file "runtime")
                             (:file "runtime-deletion")
                             (:file "pod-conditions")
                             (:file "runtime-assets")
                             (:file "cni")
                             (:file "node-ipam")
                             (:file "rtnetlink")
                             (:file "endpoint-policy")
                             (:file "service-lb")
                             (:file "egress-guard-program")
                             (:file "egress-guard")
                             (:file "service-lb-program")
                             (:file "service-lb-dataplane")
                             (:file "network-policy-program")
                             (:file "network-policy")
                             (:file "vxlan")
                             (:file "agent-cni")
                             (:file "routed-cni")
                             (:file "managed-containerd")
                             (:file "cri")
                             (:file "container-expansion")
                             (:file "containerd")
                             (:file "pod-hostname")
                             (:file "pod-dns-config")
                             (:file "container-lifecycle")
                             (:file "init-containers")
                             (:file "containerd-pod-finalizers")
                             (:file "container-probe-transport")
                             (:file "container-probe-manager")
                             (:file "container-hooks")
                             (:file "pod-resize")
                             (:file "container-images")
                             (:file "reconciler")
                             (:file "service-dns")
                             (:file "service-dns-reverse")
                             (:file "control-plane-runtime")
                             (:file "pod-volumes")
                             (:file "pod-volume-projection")
                             (:file "pod-subpaths")
                             (:file "pod-host-ports")
                             (:file "storage-volumes")
                             (:file "nfs-volumes")
                             (:file "csi-node")
                             (:file "telemetry")
                             (:file "agent-runtime")
                             (:file "pod-pool")
                             (:file "pod-http-proxy")
                             (:file "debug-server")
                             (:file "autoscaling-api")
                             (:file "http")
                             (:file "aggregated-discovery")
                             (:file "core-resource-http")
                             (:file "storage-http")
                             (:file "policy-http")
                             (:file "csr-http")
                             (:file "podtemplate-watch")
                             (:file "pod-watch")
                             (:file "pod-status-http")
                             (:file "pod-eviction")
                             (:file "pod-logs")
                             (:file "crd-http")
                             (:file "crd-status")
                             (:file "crd-openapi")
                             (:file "field-validation")
                             (:file "server-side-apply")
                             (:file "admission-webhooks")
                             (:file "admission-policies")
                             (:file "admission-http")
                             (:file "server")
                             (:file "in-cluster-api")
                             (:file "services")
                             (:file "endpointslice-controller")
                             (:file "endpoints-controller")
                             (:file "service-lb-controller")
                             (:file "endpointslice-http")
                             (:file "gateway-sni")
                             (:file "gateway-router")
                             (:file "gateway-http")
                             (:file "gateway-proxy")
                             (:file "gateway-l4")
                             (:file "gateway-sklookup")
                             (:file "gateway-controller")
                             (:file "cert-manager-http")
                             (:file "cert-manager")
                             (:file "garbage-collection")
                             (:file "crd-garbage-collection")
                             (:file "workload-controller")
                             (:file "daemonset-controller")
                             (:file "statefulset-controller")
                             (:file "job-policy")
                             (:file "job-controller")
                             (:file "disruption-controller")
                             (:file "cronjob-controller")
                             (:file "workload-deletion")
                             (:file "workload-http")
                             (:file "budget-http")
                             (:file "doctor")
                             (:file "main"))))
  :in-order-to ((test-op (test-op "gr8s/tests"))))

(asdf:defsystem "gr8s/tests"
  :depends-on ("gr8s" "drakma" "fiveam")
  :serial t
  :components ((:module "tests"
                :serial t
                :components ((:file "package")
                             (:file "websocket-test")
                             (:file "node-protocol-test")
                             (:file "dns-test")
                             (:file "dns-port-pair-test")
                             (:file "model-test")
                             (:file "store-test")
                             (:file "core-resources-test")
                             (:file "crd-schema-test")
                             (:file "yaml-test")
                             (:file "scheduler-test")
                             (:file "pod-pool-test")
                             (:file "pki-test")
                             (:file "node-session-test")
                             (:file "reconciler-test")
                             (:file "agent-runtime-test")
                             (:file "grpc-unix-test")
                             (:file "grpc-close-test")
                             (:file "cri-test")
                             (:file "runtime-assets-test")
                             (:file "cni-test")
                             (:file "node-ipam-test")
                             (:file "rtnetlink-test")
                             (:file "managed-containerd-test")
                             (:file "containerd-test")
                             (:file "container-lifecycle-test")
                             (:file "init-containers-test")
                             (:file "container-probe-test")
                             (:file "container-probe-manager-test")
                             (:file "container-probe-events-test")
                             (:file "main-test")
                             (:file "http-test")
                             (:file "pod-http-proxy-test")
                             (:file "core-resource-http-test")
                             (:file "pod-runtime-gaps-test")
                             (:file "crd-api-test")
                             (:file "server-side-apply-test")
                             (:file "crd-protobuf-test")
                             (:file "csr-crypto-test")
                             (:file "csr-api-test")
                             (:file "certificate-profiles-test")
                             (:file "podtemplates-test")
                             (:file "durable-resource-watches-test")
                             (:file "bootstrap-resource-test")
                             (:file "gateway-api-test")
                             (:file "gateway-sni-test")
                             (:file "gateway-router-test")
                             (:file "gateway-proxy-test")
                             (:file "gateway-l4-test")
                             (:file "gateway-controller-test")
                             (:file "cert-manager-test")
                             (:file "pod-volumes-test")
                             (:file "pod-volume-projection-test")
                             (:file "debug-server-test")
                             (:file "pod-subpaths-test")
                             (:file "container-resources-test")
                             (:file "pod-watch-test")
                             (:file "pod-status-http-test")
                             (:file "pod-logs-test")
                             (:file "batch-resources-test")
                             (:file "admission-webhooks-test")
                             (:file "job-policy-test")
                             (:file "job-controller-test")
                             (:file "job-indexed-test")
                             (:file "cron-schedule-test")
                             (:file "cronjob-test")
                             (:file "pod-eviction-test")
                             (:file "storage-api-test")
                             (:file "storage-http-test")
                             (:file "typed-apis-test")
                             (:file "storage-provisioner-test")
                             (:file "csi-test")
                             (:file "policy-api-test")
                             (:file "service-account-test")
                             (:file "api-client-certificate-test")
                             (:file "bootstrap-protobuf-test")
                             (:file "events-test")
                             (:file "pod-deletion-test")
                             (:file "pod-finalizers-test")
                             (:file "generated-pod-names-test")
                             (:file "pod-conditions-test")
                             (:file "node-log-delivery-test")
                             (:file "garbage-collection-test")
                             (:file "doctor-test")
                             (:file "service-lb-test")
                             (:file "egress-guard-test")
                             (:file "network-policy-test")
                             (:file "network-policy-resolution-test")
                             (:file "services-test")
                             (:file "endpointslices-test")
                             (:file "networking-test")
                             (:file "service-dns-test")
                             (:file "container-expansion-test")
                             (:file "pod-hostname-test")
                             (:file "pod-dns-config-test")
                             (:file "telemetry-test")
                             (:file "workloads-test")
                             (:file "disruption-budget-test")
                             (:file "statefulset-test")
                             (:file "rc-daemonset-test")
                             (:file "suite-watchdog"))))
  :perform (test-op (operation component)
             (declare (ignore operation component))
             (uiop:symbol-call :gr8s/tests :start-suite-watchdog)
             (unless (uiop:symbol-call
                      :fiveam :run!
                      (find-symbol "GR8S" "GR8S/TESTS"))
               (error "gr8s tests failed"))))
