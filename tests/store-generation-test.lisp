(in-package #:gr8s/tests)
(def-suite store-generation :in gr8s)
(in-suite store-generation)

(defparameter *test-store-generation-id* "01234567-89ab-4cde-8fab-0123456789ab")
(defparameter *test-store-generation-digest* (make-string 64 :initial-element #\a))

(defun make-test-generation-store (root)
  (let* ((path (gr8s.store::create-store-generation root *test-store-generation-id*))
         (store (gr8s::make-pod-store root)))
    (setf (gr8s.store::pod-store-data-root store) path)
    store))

(defun finish-test-generation (root)
  (gr8s.store::complete-store-generation root *test-store-generation-id* 42 7 *test-store-generation-digest*))

(test application-generations-reopen-with-independent-data-and-stable-identity
  (with-temporary-store (legacy root)
    (ha-make-pod legacy "legacy-pod")
    (let* ((credential (merge-pathnames "pki/member-private.key" root))
           (staged (make-test-generation-store root))
           (pod (ha-make-pod staged "generation-pod"))
           (uid (gr8s:pod-uid pod)))
      (gr8s.security::write-private-text-exclusively credential "member-private-sentinel")
      (gr8s:register-node staged (gr8s:make-node-record :id "generation-node" :name "generation-node" :pod-cidr "10.88.0.0/20"))
      (gr8s::update-pod-observed-status staged pod (gr8s::core-object "phase" "Running"))
      (gr8s::create-core-resource staged "configmaps" (core-fixture "ConfigMap" "generation-config") "default")
      (gr8s.store::save-consensus-pod-revision-unlocked staged)
      (let ((clock (gr8s::pod-store-pod-revision staged))
            (signing-path (gr8s::service-account-signing-key-path staged)))
        (finish-test-generation root)
        (is (null (gr8s.store::selected-store-generation-root root)))
        (gr8s.store::publish-store-generation root *test-store-generation-id*)
        (let ((reopened (gr8s:open-store root)))
          (is (equal root (gr8s::pod-store-path reopened)))
          (is (equal (gr8s.store:store-data-path staged) (gr8s.store:store-data-path reopened)))
          (is (equal uid (gr8s:pod-uid (gr8s:get-pod reopened "default" "generation-pod"))))
          (signals gr8s:kubernetes-error (gr8s:get-pod reopened "default" "legacy-pod"))
          (is (equal "10.88.0.0/20" (ha-node-cidr reopened "generation-node")))
          (is (equal "Running" (gethash "phase" (gr8s::pod-observed-status reopened (gr8s:get-pod reopened "default" "generation-pod")))))
          (is (= clock (gr8s::pod-store-pod-revision reopened)))
          (is (hash-table-p (gr8s::get-core-resource reopened "configmaps" "default" "generation-config")))
          (is (equal signing-path (gr8s::service-account-signing-key-path reopened)))
          (is (equal "member-private-sentinel" (uiop:read-file-string credential)))
          (setf (gr8s::pod-store-consensus-commit-fn reopened)
                (lambda (tag payload)
                  (ecase tag
                    (:pod-delta (gr8s::install-pod-state-delta reopened payload))
                    (:node-delta (gr8s::install-node-state-delta reopened payload))
                    (:core-delta (gr8s::install-core-state-delta reopened payload)))))
          (let ((new (ha-make-pod reopened "after-selection")))
            (is (uiop:subpathp (gr8s::pod-path reopened new) (gr8s.store:store-data-path reopened)))
            (is (null (probe-file (merge-pathnames (format nil "~A.json" (gr8s:pod-uid new)) root)))))
          (gr8s::update-node-kubelet-port reopened "generation-node" 12345)
          (gr8s::create-core-resource reopened "configmaps" (core-fixture "ConfigMap" "after-selection") "default")
          (let ((again (gr8s:open-store root)))
            (is (stringp (gr8s:pod-uid (gr8s:get-pod again "default" "after-selection"))))
            (is (= 12345 (gr8s::node-record-kubelet-port (gr8s:get-node again "generation-node"))))
            (is (hash-table-p (gr8s::get-core-resource again "configmaps" "default" "after-selection"))))
          (is (probe-file (gr8s::pod-path legacy (gr8s:get-pod legacy "default" "legacy-pod")))))))))

(test incomplete-generation-is-not-selectable-and-markers-are-immutable
  (with-temporary-store (legacy root)
    (declare (ignore legacy))
    (let* ((staged (make-test-generation-store root))
           (marker (gr8s.store::store-generation-complete-path root *test-store-generation-id*)))
      (declare (ignore staged))
      (signals error (gr8s.store::publish-store-generation root *test-store-generation-id*))
      (is (null (probe-file (gr8s.store::store-generation-selector-path root))))
      (finish-test-generation root)
      (let ((before (uiop:read-file-string marker)))
        (signals error (finish-test-generation root))
        (is (equal before (uiop:read-file-string marker))))
      (gr8s.store::publish-store-generation root *test-store-generation-id*)
      (is (= #o600 (logand #o777 (sb-posix:stat-mode
                                (sb-posix:stat (namestring (gr8s.store::store-generation-selector-path root)))))))
      (is (= #o700 (logand #o777 (sb-posix:stat-mode
                                (sb-posix:stat (namestring (gr8s.store::store-generation-root root *test-store-generation-id*))))))))))

(test generation-selection-rejects-invalid-descriptors-and-private-path-violations
  (with-temporary-store (legacy root)
    (declare (ignore legacy))
    (let* ((staged (make-test-generation-store root))
           (selector (gr8s.store::store-generation-selector-path root))
           (marker (gr8s.store::store-generation-complete-path root *test-store-generation-id*)))
      (declare (ignore staged))
      (finish-test-generation root)
      (gr8s.store::publish-store-generation root *test-store-generation-id*)
      (let ((descriptor (gr8s.store::read-store-generation-descriptor selector)))
        (setf (gethash "generation" descriptor) "../outside")
        (gr8s.security::write-private-text-atomically selector (com.inuoe.jzon:stringify descriptor))
        (signals error (gr8s:open-store root)))
      (delete-file selector)
      (gr8s.store::publish-store-generation root *test-store-generation-id*)
      (sb-posix:chmod (namestring selector) #o644)
      (signals error (gr8s:open-store root))
      (sb-posix:chmod (namestring selector) #o600)
      (let ((descriptor (gr8s.store::read-store-generation-descriptor marker)))
        (incf (gethash "index" descriptor))
        (gr8s.security::write-private-text-atomically marker (com.inuoe.jzon:stringify descriptor))
        (signals error (gr8s:open-store root)))
      (delete-file selector)
      (sb-posix:symlink (namestring marker) (namestring selector))
      (signals error (gr8s:open-store root)))))

(test generation-selection-rejects-links-public-directories-and-nonregular-metadata
  (with-temporary-store (legacy root)
    (declare (ignore legacy))
    (make-test-generation-store root)
    (finish-test-generation root)
    (gr8s.store::publish-store-generation root *test-store-generation-id*)
    (let* ((base (gr8s.store::store-generation-base root))
           (generation (gr8s.store::store-generation-root root *test-store-generation-id*))
           (selector (gr8s.store::store-generation-selector-path root))
           (marker (gr8s.store::store-generation-complete-path root *test-store-generation-id*))
           (link (merge-pathnames "marker-link.meta" root)))
      (sb-posix:chmod (namestring base) #o755)
      (signals error (gr8s:open-store root))
      (sb-posix:chmod (namestring base) #o700)
      (sb-posix:link (namestring marker) (namestring link))
      (unwind-protect (signals error (gr8s:open-store root))
        (sb-posix:unlink (namestring link)))
      (let ((parked (merge-pathnames "parked-generation/" root))
            (literal (string-right-trim "/" (namestring generation))))
        (sb-posix:rename literal (namestring parked))
        (unwind-protect
             (progn
               (sb-posix:symlink (namestring parked) literal)
               (signals error (gr8s:open-store root)))
          (sb-posix:unlink literal)
          (sb-posix:rename (namestring parked) literal)))
      (delete-file selector)
      (sb-posix:mkfifo (namestring selector) #o600)
      (signals error (gr8s:open-store root))
      (sb-posix:unlink (namestring selector))
      (gr8s.store::publish-store-generation root *test-store-generation-id*)
      (is (equal generation (gr8s.store:store-data-path (gr8s:open-store root)))))))

(test generation-publication-failure-boundaries-preserve-complete-choices
  (with-temporary-store (legacy root)
    (declare (ignore legacy))
    (make-test-generation-store root)
    (finish-test-generation root)
    (gr8s.store::publish-store-generation root *test-store-generation-id*)
    (let* ((old-id *test-store-generation-id*)
           (new-id "fedcba98-7654-4321-8abc-fedcba987654")
           (selector (gr8s.store::store-generation-selector-path root))
           (before (uiop:read-file-string selector)))
      (let ((*test-store-generation-id* new-id))
        (make-test-generation-store root) (finish-test-generation root))
      (let ((original (symbol-function 'com.inuoe.jzon:stringify)))
        (unwind-protect
             (progn
               (setf (symbol-function 'com.inuoe.jzon:stringify)
                     (lambda (&rest arguments) (declare (ignore arguments)) (error "Injected metadata write failure")))
               (signals error (gr8s.store::publish-store-generation root new-id)))
          (setf (symbol-function 'com.inuoe.jzon:stringify) original)))
      (is (equal before (uiop:read-file-string selector)))
      (is (equal (gr8s.store::store-generation-root root old-id)
                 (gr8s.store::selected-store-generation-root root)))
      (is (null (directory (merge-pathnames "*.tmp" (uiop:pathname-directory-pathname selector)))))
      (let ((original (symbol-function 'gr8s.store::sync-store-generation-directory)))
        (unwind-protect
             (progn
               (setf (symbol-function 'gr8s.store::sync-store-generation-directory)
                     (lambda (path)
                       (if (equal path (uiop:pathname-directory-pathname selector))
                           (error "Injected post-rename directory sync failure")
                           (funcall original path))))
               (signals error (gr8s.store::publish-store-generation root new-id)))
          (setf (symbol-function 'gr8s.store::sync-store-generation-directory) original)))
      ;; Publication already happened. Do not roll back or remove either complete generation.
      (is (equal (gr8s.store::store-generation-root root new-id)
                 (gr8s.store::selected-store-generation-root root)))
      (is (probe-file (gr8s.store::store-generation-complete-path root old-id)))
      (is (probe-file (gr8s.store::store-generation-complete-path root new-id))))))

(test generation-selection-preserves-service-account-key-and-issuer-records
  (with-temporary-store (legacy root)
    (declare (ignore legacy))
    (let* ((staged (make-test-generation-store root))
           (digest (make-array 32 :element-type '(unsigned-byte 8) :initial-element 0))
           (key-path (gr8s::service-account-signing-key-path staged))
           (issuer-path (gr8s::service-account-issuer-record-path staged digest)))
      (gr8s::load-service-account-signing-key staged)
      (gr8s.security::write-private-text-exclusively issuer-path "{\"testIssuer\":true}")
      (let ((key-before (uiop:read-file-string key-path))
            (issuer-before (uiop:read-file-string issuer-path)))
        (finish-test-generation root)
        (gr8s.store::publish-store-generation root *test-store-generation-id*)
        (let ((reopened (gr8s:open-store root)))
          (gr8s::load-service-account-signing-key reopened)
          (is (equal key-path (gr8s::service-account-signing-key-path reopened)))
          (is (equal issuer-path (gr8s::service-account-issuer-record-path reopened digest)))
          (is (equal key-before (uiop:read-file-string key-path)))
          (is (equal issuer-before (uiop:read-file-string issuer-path)))
          (is (null (probe-file (merge-pathnames "pki/" (gr8s.store:store-data-path reopened)))))
          (is (null (probe-file (merge-pathnames "credentials/" (gr8s.store:store-data-path reopened))))))))))
