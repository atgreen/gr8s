(in-package #:gr8s/tests)
(def-suite store-generation :in gr8s)
(in-suite store-generation)

(defparameter *test-store-generation-id* "01234567-89ab-4cde-8fab-0123456789ab")
(defparameter *test-store-generation-digest* (make-string 64 :initial-element #\a))

(defun make-test-generation-store (root)
  (let* ((path (gr8s.store::create-store-generation root *test-store-generation-id*))
         (store (gr8s::make-pod-store root)))
    (setf (gr8s.store::pod-store-data-root store) path)
    store))

(defun finish-test-generation (root)
  (gr8s.store::complete-store-generation root *test-store-generation-id* 42 7 *test-store-generation-digest*))

(test application-generations-reopen-with-independent-data-and-stable-identity
  (with-temporary-store (legacy root)
    (ha-make-pod legacy "legacy-pod")
    (let* ((credential (merge-pathnames "pki/member-private.key" root))
           (staged (make-test-generation-store root))
           (pod (ha-make-pod staged "generation-pod"))
           (uid (gr8s:pod-uid pod)))
      (gr8s.security::write-private-text-exclusively credential "member-private-sentinel")
      (gr8s:register-node staged (gr8s:make-node-record :id "generation-node" :name "generation-node" :pod-cidr "10.88.0.0/20"))
      (gr8s::update-pod-observed-status staged pod (gr8s::core-object "phase" "Running"))
      (gr8s::create-core-resource staged "configmaps" (core-fixture "ConfigMap" "generation-config") "default")
      (gr8s.store::save-consensus-pod-revision-unlocked staged)
      (let ((clock (gr8s::pod-store-pod-revision staged))
            (signing-path (gr8s::service-account-signing-key-path staged)))
        (finish-test-generation root)
        (is (null (gr8s.store::selected-store-generation-root root)))
        (gr8s.store::publish-store-generation root *test-store-generation-id*)
        (let ((reopened (gr8s:open-store root)))
          (is (equal root (gr8s::pod-store-path reopened)))
          (is (equal (gr8s.store:store-data-path staged) (gr8s.store:store-data-path reopened)))
          (is (equal uid (gr8s:pod-uid (gr8s:get-pod reopened "default" "generation-pod"))))
          (signals gr8s:kubernetes-error (gr8s:get-pod reopened "default" "legacy-pod"))
          (is (equal "10.88.0.0/20" (ha-node-cidr reopened "generation-node")))
          (is (equal "Running" (gethash "phase" (gr8s::pod-observed-status reopened (gr8s:get-pod reopened "default" "generation-pod")))))
          (is (= clock (gr8s::pod-store-pod-revision reopened)))
          (is (hash-table-p (gr8s::get-core-resource reopened "configmaps" "default" "generation-config")))
          (is (equal signing-path (gr8s::service-account-signing-key-path reopened)))
          (is (equal "member-private-sentinel" (uiop:read-file-string credential)))
          (setf (gr8s::pod-store-consensus-commit-fn reopened)
                (lambda (tag payload)
                  (ecase tag
                    (:pod-delta (gr8s::install-pod-state-delta reopened payload))
                    (:node-delta (gr8s::install-node-state-delta reopened payload))
                    (:core-delta (gr8s::install-core-state-delta reopened payload)))))
          (let ((new (ha-make-pod reopened "after-selection")))
            (is (uiop:subpathp (gr8s::pod-path reopened new) (gr8s.store:store-data-path reopened)))
            (is (null (probe-file (merge-pathnames (format nil "~A.json" (gr8s:pod-uid new)) root)))))
          (gr8s::update-node-kubelet-port reopened "generation-node" 12345)
          (gr8s::create-core-resource reopened "configmaps" (core-fixture "ConfigMap" "after-selection") "default")
          (let ((again (gr8s:open-store root)))
            (is (stringp (gr8s:pod-uid (gr8s:get-pod again "default" "after-selection"))))
            (is (= 12345 (gr8s::node-record-kubelet-port (gr8s:get-node again "generation-node"))))
            (is (hash-table-p (gr8s::get-core-resource again "configmaps" "default" "after-selection"))))
          (is (probe-file (gr8s::pod-path legacy (gr8s:get-pod legacy "default" "legacy-pod")))))))))

(test incomplete-generation-is-not-selectable-and-markers-are-immutable
  (with-temporary-store (legacy root)
    (declare (ignore legacy))
    (let* ((staged (make-test-generation-store root))
           (marker (gr8s.store::store-generation-complete-path root *test-store-generation-id*)))
      (declare (ignore staged))
      (signals error (gr8s.store::publish-store-generation root *test-store-generation-id*))
      (is (null (probe-file (gr8s.store::store-generation-selector-path root))))
      (finish-test-generation root)
      (let ((before (uiop:read-file-string marker)))
        (signals error (finish-test-generation root))
        (is (equal before (uiop:read-file-string marker))))
      (gr8s.store::publish-store-generation root *test-store-generation-id*)
      (is (= #o600 (logand #o777 (sb-posix:stat-mode
                                (sb-posix:stat (namestring (gr8s.store::store-generation-selector-path root)))))))
      (is (= #o700 (logand #o777 (sb-posix:stat-mode
                                (sb-posix:stat (namestring (gr8s.store::store-generation-root root *test-store-generation-id*))))))))))

(test generation-selection-rejects-invalid-descriptors-and-private-path-violations
  (with-temporary-store (legacy root)
    (declare (ignore legacy))
    (let* ((staged (make-test-generation-store root))
           (selector (gr8s.store::store-generation-selector-path root))
           (marker (gr8s.store::store-generation-complete-path root *test-store-generation-id*)))
      (declare (ignore staged))
      (finish-test-generation root)
      (gr8s.store::publish-store-generation root *test-store-generation-id*)
      (let ((descriptor (gr8s.store::read-store-generation-descriptor selector)))
        (setf (gethash "generation" descriptor) "../outside")
        (gr8s.security::write-private-text-atomically selector (com.inuoe.jzon:stringify descriptor))
        (signals error (gr8s:open-store root)))
      (delete-file selector)
      (gr8s.store::publish-store-generation root *test-store-generation-id*)
      (sb-posix:chmod (namestring selector) #o644)
      (signals error (gr8s:open-store root))
      (sb-posix:chmod (namestring selector) #o600)
      (let ((descriptor (gr8s.store::read-store-generation-descriptor marker)))
        (incf (gethash "index" descriptor))
        (gr8s.security::write-private-text-atomically marker (com.inuoe.jzon:stringify descriptor))
        (signals error (gr8s:open-store root)))
      (delete-file selector)
      (sb-posix:symlink (namestring marker) (namestring selector))
      (signals error (gr8s:open-store root)))))

(test generation-selection-rejects-links-public-directories-and-nonregular-metadata
  (with-temporary-store (legacy root)
    (declare (ignore legacy))
    (make-test-generation-store root)
    (finish-test-generation root)
    (gr8s.store::publish-store-generation root *test-store-generation-id*)
    (let* ((base (gr8s.store::store-generation-base root))
           (generation (gr8s.store::store-generation-root root *test-store-generation-id*))
           (selector (gr8s.store::store-generation-selector-path root))
           (marker (gr8s.store::store-generation-complete-path root *test-store-generation-id*))
           (link (merge-pathnames "marker-link.meta" root)))
      (sb-posix:chmod (namestring base) #o755)
      (signals error (gr8s:open-store root))
      (sb-posix:chmod (namestring base) #o700)
      (sb-posix:link (namestring marker) (namestring link))
      (unwind-protect (signals error (gr8s:open-store root))
        (sb-posix:unlink (namestring link)))
      (let ((parked (merge-pathnames "parked-generation/" root))
            (literal (string-right-trim "/" (namestring generation))))
        (sb-posix:rename literal (namestring parked))
        (unwind-protect
             (progn
               (sb-posix:symlink (namestring parked) literal)
               (signals error (gr8s:open-store root)))
          (sb-posix:unlink literal)
          (sb-posix:rename (namestring parked) literal)))
      (delete-file selector)
      (sb-posix:mkfifo (namestring selector) #o600)
      (signals error (gr8s:open-store root))
      (sb-posix:unlink (namestring selector))
      (gr8s.store::publish-store-generation root *test-store-generation-id*)
      (is (equal generation (gr8s.store:store-data-path (gr8s:open-store root)))))))

(test generation-publication-failure-boundaries-preserve-complete-choices
  (with-temporary-store (legacy root)
    (declare (ignore legacy))
    (make-test-generation-store root)
    (finish-test-generation root)
    (gr8s.store::publish-store-generation root *test-store-generation-id*)
    (let* ((old-id *test-store-generation-id*)
           (new-id "fedcba98-7654-4321-8abc-fedcba987654")
           (selector (gr8s.store::store-generation-selector-path root))
           (before (uiop:read-file-string selector)))
      (let ((*test-store-generation-id* new-id))
        (make-test-generation-store root) (finish-test-generation root))
      (let ((original (symbol-function 'com.inuoe.jzon:stringify)))
        (unwind-protect
             (progn
               (setf (symbol-function 'com.inuoe.jzon:stringify)
                     (lambda (&rest arguments) (declare (ignore arguments)) (error "Injected metadata write failure")))
               (signals error (gr8s.store::publish-store-generation root new-id)))
          (setf (symbol-function 'com.inuoe.jzon:stringify) original)))
      (is (equal before (uiop:read-file-string selector)))
      (is (equal (gr8s.store::store-generation-root root old-id)
                 (gr8s.store::selected-store-generation-root root)))
      (is (null (directory (merge-pathnames "*.tmp" (uiop:pathname-directory-pathname selector)))))
      (let ((original (symbol-function 'gr8s.store::sync-store-generation-directory)))
        (unwind-protect
             (progn
               (setf (symbol-function 'gr8s.store::sync-store-generation-directory)
                     (lambda (path)
                       (if (equal path (uiop:pathname-directory-pathname selector))
                           (error "Injected post-rename directory sync failure")
                           (funcall original path))))
               (signals error (gr8s.store::publish-store-generation root new-id)))
          (setf (symbol-function 'gr8s.store::sync-store-generation-directory) original)))
      ;; Publication already happened. Do not roll back or remove either complete generation.
      (is (equal (gr8s.store::store-generation-root root new-id)
                 (gr8s.store::selected-store-generation-root root)))
      (is (probe-file (gr8s.store::store-generation-complete-path root old-id)))
      (is (probe-file (gr8s.store::store-generation-complete-path root new-id))))))

(test generation-selection-preserves-service-account-key-and-issuer-records
  (with-temporary-store (legacy root)
    (declare (ignore legacy))
    (let* ((staged (make-test-generation-store root))
           (digest (make-array 32 :element-type '(unsigned-byte 8) :initial-element 0))
           (key-path (gr8s::service-account-signing-key-path staged))
           (issuer-path (gr8s::service-account-issuer-record-path staged digest)))
      (gr8s::load-service-account-signing-key staged)
      (gr8s.security::write-private-text-exclusively issuer-path "{\"testIssuer\":true}")
      (let ((key-before (uiop:read-file-string key-path))
            (issuer-before (uiop:read-file-string issuer-path)))
        (finish-test-generation root)
        (gr8s.store::publish-store-generation root *test-store-generation-id*)
        (let ((reopened (gr8s:open-store root)))
          (gr8s::load-service-account-signing-key reopened)
          (is (equal key-path (gr8s::service-account-signing-key-path reopened)))
          (is (equal issuer-path (gr8s::service-account-issuer-record-path reopened digest)))
          (is (equal key-before (uiop:read-file-string key-path)))
          (is (equal issuer-before (uiop:read-file-string issuer-path)))
          (is (null (probe-file (merge-pathnames "pki/" (gr8s.store:store-data-path reopened)))))
          (is (null (probe-file (merge-pathnames "credentials/" (gr8s.store:store-data-path reopened))))))))))

(test ha-store-open-preserves-restore-intent-until-wal-validation
  (with-temporary-store (legacy root)
    (declare (ignore legacy))
    (make-test-generation-store root)
    (finish-test-generation root)
    (let* ((intent (gr8s.store::begin-store-restore root *test-store-generation-id*))
           (opened (gr8s:open-store root :defer-restore-completion t)))
      (is-true (gr8s.store::read-store-restore-intent root))
      (is (equal (gr8s.store::store-generation-root root *test-store-generation-id*)
                 (gr8s.store:store-data-path opened)))
      (gr8s.store::finish-store-restore opened intent)
      (is (null (gr8s.store::read-store-restore-intent root))))))

(defun make-retirement-test-generations (root)
  (let ((ids '("01234567-89ab-4cde-8fab-0123456789ab"
               "11234567-89ab-4cde-8fab-0123456789ab"
               "21234567-89ab-4cde-8fab-0123456789ab")))
    (dolist (id ids)
      (gr8s.store::create-store-generation root id)
      (gr8s.store::complete-store-generation root id 42 7 *test-store-generation-digest*))
    (gr8s.store::publish-store-generation root (first ids))
    ids))

(test generation-retirement-records-only-selected-predecessors-before-intent
  (with-temporary-store (store root)
    (declare (ignore store))
    (destructuring-bind (old new staged) (make-retirement-test-generations root)
      (let ((marker (gr8s.store::store-generation-retirement-path root old)))
        (is-false (probe-file marker))
        (gr8s.store::publish-store-generation root old)
        (is-false (probe-file marker))
        (gr8s.store::begin-store-restore root new)
        (is (equal old (gethash "generation" (gr8s.store::read-store-generation-descriptor marker))))
        (is (equal (gr8s.store::store-generation-root root old)
                   (gr8s.store::selected-store-generation-root root)))
        (is (equal new (gethash "generation" (gr8s.store::read-store-restore-intent root))))
        (let ((before (uiop:read-file-string marker)))
          (gr8s.store::begin-store-restore root new)
          (is (equal before (uiop:read-file-string marker)))
          (gr8s.store::resume-store-restore-selection root)
          (is (equal before (uiop:read-file-string marker))))
        (is (equal (gr8s.store::store-generation-root root new)
                   (gr8s.store::selected-store-generation-root root)))
        (dolist (id (list new staged))
          (is-false (probe-file (gr8s.store::store-generation-retirement-path root id))))))))

(test retirement-durability-failure-cannot-publish-intent-or-selector
  (with-temporary-store (store root)
    (declare (ignore store))
    (destructuring-bind (old new staged) (make-retirement-test-generations root)
      (declare (ignore staged))
      (let ((original (symbol-function 'gr8s.store::write-store-generation-descriptor))
            (marker (gr8s.store::store-generation-retirement-path root old)))
        (unwind-protect
             (progn
               (setf (symbol-function 'gr8s.store::write-store-generation-descriptor)
                     (lambda (path descriptor &rest args)
                       (if (equal path marker) (error "Injected retirement failure")
                           (apply original path descriptor args))))
               (signals error (gr8s.store::begin-store-restore root new))
               (signals error (gr8s.store::publish-store-generation root new)))
          (setf (symbol-function 'gr8s.store::write-store-generation-descriptor) original))
        (is-false (gr8s.store::read-store-restore-intent root))
        (is (equal (gr8s.store::store-generation-root root old)
                   (gr8s.store::selected-store-generation-root root)))
        ;; Simulate interruption after retirement is durable but before intent.
        (unwind-protect
             (progn
               (setf (symbol-function 'gr8s.store::write-store-generation-descriptor)
                     (lambda (path descriptor &rest args)
                       (if (equal path (gr8s.store::store-restore-intent-path root))
                           (error "Injected pre-intent interruption")
                           (apply original path descriptor args))))
               (signals error (gr8s.store::begin-store-restore root new)))
          (setf (symbol-function 'gr8s.store::write-store-generation-descriptor) original))
        (is-true (probe-file marker))
        (is-false (gr8s.store::read-store-restore-intent root))
        (finishes (gr8s.store::begin-store-restore root new))
        (finishes (gr8s.store::resume-store-restore-selection root))))))

(test retirement-refuses-symlink-metadata-before-selection
  (with-temporary-store (store root)
    (declare (ignore store))
    (destructuring-bind (old new staged) (make-retirement-test-generations root)
      (declare (ignore staged))
      (let* ((marker (gr8s.store::store-generation-retirement-path root old))
             (directory (uiop:pathname-directory-pathname marker)))
        (gr8s.store::ensure-store-generation-directory directory (merge-pathnames "metadata/" root))
        (sb-posix:symlink (namestring (gr8s.store::store-generation-complete-path root old))
                          (namestring marker))
        (signals error (gr8s.store::begin-store-restore root new))
        (is-false (gr8s.store::read-store-restore-intent root))
        (is (equal (gr8s.store::store-generation-root root old)
                   (gr8s.store::selected-store-generation-root root)))))))

(defun set-test-generation-current (store id)
  (gr8s.store::publish-store-generation (gr8s::pod-store-path store) id)
  (setf (gr8s.store::pod-store-data-root store)
        (gr8s.store::store-generation-root (gr8s::pod-store-path store) id)))

(test retired-generation-reaper-protects-live-readers-and-cleans-after-release
  (with-temporary-store (store root)
    (destructuring-bind (old new staged) (make-retirement-test-generations root)
      (setf (gr8s.store::pod-store-data-root store) (gr8s.store::store-generation-root root old))
      (let ((data (merge-pathnames "pod-revision.ceiling" (gr8s.store:store-data-path store))))
        (gr8s.security::write-private-text-exclusively data "17")
        (gr8s.store::call-with-store-data-reader
         store (lambda (path)
                 (set-test-generation-current store new)
                 (is (= 0 (gr8s.store::reap-retired-store-generations store)))
                 (is (equal "17" (uiop:read-file-string (merge-pathnames "pod-revision.ceiling" path))))
                 (is-true (probe-file (gr8s.store::store-generation-root root old)))))
        (is (= 1 (gr8s.store::reap-retired-store-generations store)))
        (is-false (probe-file (gr8s.store::store-generation-root root old)))
        (is-false (probe-file (gr8s.store::store-generation-trash-path root old)))
        (is-false (probe-file (gr8s.store::store-generation-retirement-path root old)))
        (is-true (probe-file (gr8s.store::store-generation-root root new)))
        (is-true (probe-file (gr8s.store::store-generation-root root staged)))))))

(test retired-generation-pruning-is-batched-and-resumes-after-detachment
  (with-temporary-store (store root)
    (destructuring-bind (old new staged) (make-retirement-test-generations root)
      (declare (ignore staged))
      (let ((path (gr8s.store::store-generation-root root old)))
        (dotimes (i 9)
          (gr8s.security::write-private-text-exclusively
           (merge-pathnames (format nil "~8,'0x-89ab-4cde-8fab-0123456789ab.json" i) path) "{}"))
        (set-test-generation-current store new)
        (let* ((descriptor (gr8s.store::read-store-generation-descriptor
                            (gr8s.store::store-generation-retirement-path root old)))
               (trash (gr8s.store::claim-retired-store-generation store descriptor)))
          ;; Simulate interruption after durable rename; no in-memory task is needed.
          (is-true (probe-file trash))
          (is-false (probe-file path))
          (let ((removed (gr8s.store::reap-retired-store-generations store :maximum-entries 2)))
            (is (<= removed 2)) (is-true (probe-file trash)))
          (dotimes (i 12)
            (declare (ignore i))
            (is (<= (gr8s.store::reap-retired-store-generations store :maximum-entries 2) 2)))
          (is-false (probe-file trash)))))))

(test retired-generation-reaper-preserves-unknown-files-links-and-pending-state
  (with-temporary-store (store root)
    (destructuring-bind (old new staged) (make-retirement-test-generations root)
      (let* ((path (gr8s.store::store-generation-root root old))
             (outside (merge-pathnames "sentinel.txt" root)))
        (gr8s.security::write-private-text-exclusively outside "keep")
        (gr8s.security::write-private-text-exclusively (merge-pathnames "unknown.txt" path) "unknown")
        (sb-posix:symlink (namestring outside) (namestring (merge-pathnames "pod-revision.ceiling" path)))
        (gr8s.store::begin-store-restore root new)
        (setf (gr8s.store::pod-store-data-root store) path)
        (is (= 0 (gr8s.store::reap-retired-store-generations store)))
        (is-true (probe-file path))
        (gr8s.store::resume-store-restore-selection root)
        (setf (gr8s.store::pod-store-data-root store) (gr8s.store::store-generation-root root new))
        ;; Pending intent still protects everything, even after selection.
        (is (= 0 (gr8s.store::reap-retired-store-generations store)))
        (gr8s.store::finish-store-restore store (gr8s.store::read-store-restore-intent root))
        (gr8s.store::reap-retired-store-generations store)
        (let ((trash (gr8s.store::store-generation-trash-path root old)))
          (is (equal "unknown" (uiop:read-file-string (merge-pathnames "unknown.txt" trash))))
          (is (sb-posix:s-islnk (sb-posix:stat-mode
                                (gr8s.store::store-generation-stat (merge-pathnames "pod-revision.ceiling" trash))))))
        (is (equal "keep" (uiop:read-file-string outside)))
        (is-true (probe-file (gr8s.store::store-generation-root root staged)))))))

(test generation-reader-pins-clean-up-on-errors-and-nonlocal-exits
  (with-temporary-store (store root)
    (destructuring-bind (old new staged) (make-retirement-test-generations root)
      (declare (ignore new staged))
      (setf (gr8s.store::pod-store-data-root store) (gr8s.store::store-generation-root root old))
      (is (equal '(1 2) (multiple-value-list
                        (gr8s.store::call-with-store-data-reader
                         store (lambda (path) (declare (ignore path)) (values 1 2))))))
      (signals simple-error
        (gr8s.store::call-with-store-data-reader store (lambda (path) (declare (ignore path)) (error "reader error"))))
      (is (eq :left (catch 'leave
                      (gr8s.store::call-with-store-data-reader
                       store (lambda (path) (declare (ignore path)) (throw 'leave :left))))))
      (is (= 0 (hash-table-count (gr8s.store::pod-store-generation-readers store)))))))

(test retired-generation-detach-sync-failure-is-restartable
  (with-temporary-store (store root)
    (destructuring-bind (old new staged) (make-retirement-test-generations root)
      (declare (ignore staged))
      (set-test-generation-current store new)
      (let ((original (symbol-function 'gr8s.store::sync-store-generation-directory)))
        (unwind-protect
             (progn
               (setf (symbol-function 'gr8s.store::sync-store-generation-directory)
                     (lambda (path)
                       (if (equal path (gr8s.store::store-generation-base root))
                           (error "Injected detach sync uncertainty")
                           (funcall original path))))
               (signals error (gr8s.store::reap-retired-store-generations store)))
          (setf (symbol-function 'gr8s.store::sync-store-generation-directory) original)))
      (is-false (probe-file (gr8s.store::store-generation-root root old)))
      (is-true (probe-file (gr8s.store::store-generation-trash-path root old)))
      (is-true (probe-file (gr8s.store::store-generation-retirement-path root old)))
      (finishes (gr8s.store::reap-retired-store-generations store))
      (is-false (probe-file (gr8s.store::store-generation-trash-path root old))))))

(test retired-generation-reaper-retains-hardlinks-and-unrecognized-subdirectories
  (with-temporary-store (store root)
    (destructuring-bind (old new staged) (make-retirement-test-generations root)
      (declare (ignore staged))
      (let* ((path (gr8s.store::store-generation-root root old))
             (outside (merge-pathnames "outside.txt" root))
             (unknown (merge-pathnames "unknown/" path)))
        (gr8s.security::write-private-text-exclusively outside "keep")
        (gr8s.store::ensure-store-generation-directory unknown path)
        (gr8s.security::write-private-text-exclusively (merge-pathnames "inside.txt" unknown) "unknown")
        (sb-posix:link (namestring outside) (namestring (merge-pathnames "pod-revision.ceiling" path)))
        (set-test-generation-current store new)
        (gr8s.store::reap-retired-store-generations store)
        (let ((trash (gr8s.store::store-generation-trash-path root old)))
          (is (equal "keep" (uiop:read-file-string (merge-pathnames "pod-revision.ceiling" trash))))
          (is (equal "unknown" (uiop:read-file-string (merge-pathnames "unknown/inside.txt" trash)))))
        (is (equal "keep" (uiop:read-file-string outside)))))))

(test retired-generation-reaper-handles-older-pod-file-modes-inside-private-directories
  (with-temporary-store (store root)
    (destructuring-bind (old new staged) (make-retirement-test-generations root)
      (declare (ignore staged))
      (let ((pod (merge-pathnames "31234567-89ab-4cde-8fab-0123456789ab.json"
                                  (gr8s.store::store-generation-root root old))))
        (gr8s.security::write-private-text-exclusively pod "{}")
        (sb-posix:chmod (namestring pod) #o644)
        (set-test-generation-current store new)
        (is (= 1 (gr8s.store::reap-retired-store-generations store)))
        (is-false (probe-file (gr8s.store::store-generation-trash-path root old)))))))

(test repeated-real-snapshot-reloads-reclaim-old-generations-and-preserve-data
  (with-temporary-store (store root)
    (let* ((descriptor (make-restore-intent-fixture store root))
           (uid (gr8s:pod-uid (gr8s:get-pod store "default" "snapshot-pod")))
           (key (progn (gr8s::load-service-account-signing-key store)
                       (uiop:read-file-string (gr8s::service-account-signing-key-path store)))))
      (dotimes (round 5)
        (let ((previous (gr8s.store:store-data-path store)))
          (gr8s.store::call-with-store-data-reader
           store (lambda (reader-path)
                   (gr8s.store::quiesce-store-access store)
                   (gr8s.store::reload-store-application store (gethash "generation" descriptor))
                   (gr8s.store::resume-store-access store)
                   (gr8s.store::reap-retired-store-generations store)
                   ;; The old reader still owns its filesystem root after same-object reload.
                   (is-true (probe-file reader-path))))
          (gr8s.store::reap-retired-store-generations store)
          (when (plusp round) (is-false (probe-file previous)))
          (is (equal uid (gr8s:pod-uid (gr8s:get-pod store "default" "snapshot-pod"))))
          (is (hash-table-p (gr8s::get-core-resource store "configmaps" "default" "snapshot-config")))
          (gr8s::load-service-account-signing-key store)
          (is (equal key (uiop:read-file-string (gr8s::service-account-signing-key-path store))))
          (let ((artifact (merge-pathnames (format nil "reload-~D.jsonl" round) root)))
            (gr8s.resources::capture-store-snapshot store artifact (+ 43 round) 7)
            (setf descriptor (nth-value 1 (materialize-live-test-snapshot store root artifact)))))))))
