;;;;
;;;; Purpose:
;;;; Exercise cumulative probe Event delivery across real target retirement,
;;;; exact Pod UID wire validation, durable native reconstruction and fair
;;;; bounded pages. Expiry and capacity bound retained history while repeated
;;;; counts do not churn the API journal or leak transport fields into status.

(in-package #:gr8s/tests)
(def-suite container-probe-events :in gr8s)
(in-suite container-probe-events)

(defun event-outbox-pod (store &optional (count 1))
  "Create an assigned Pod with COUNT independently named containers."
  (let ((object (com.inuoe.jzon:parse *valid-pod-json*)))
    (setf (gethash "nodeName" (gethash "spec" object)) "probe-node"
          (gethash "containers" (gethash "spec" object))
          (coerce (loop for index below count collect (gr8s::core-object "name" (format nil "c~D" index) "image" "busybox")) 'vector))
    (create-pod store (parse-pod object))))

(defun event-outbox-target (manager pod name now &key (attempt "attempt0"))
  "Attach one measured failing readiness attempt without starting worker threads."
  (let* ((worker (gr8s::make-container-probe-worker :kind "readinessProbe"
                  :spec (checked-probe "{\"exec\":{\"command\":[\"false\"]}}")))
         (target (gr8s::make-container-probe-target :uid (pod-uid pod) :name name :id attempt :workers (list worker))))
    (gr8s::record-container-probe-result worker nil "actual failed occurrence" now)
    (setf (gethash (gr8s::probe-target-key target) (gr8s::container-probe-manager-targets manager)) target)
    target))

(defun deliver-probe-event-page (store pod page &optional (node "probe-node"))
  "Pass a real encoded node envelope through assigned UID/RV validation."
  (let* ((status (gr8s::core-object "phase" "Running"))
         (message (gr8s::pod-observed-status-message pod status page))
         (envelope (gr8s:make-agent-envelope :status (make-instance 'gr8s.node.v1::node-status :pods (list message))))
         (wire (ag-proto:serialize-to-bytes envelope))
         (decoded (ag-proto:deserialize-from-bytes 'gr8s.node.v1::agent-envelope wire)))
    (gr8s::handle-node-agent-envelope (gr8s::%make-node-grpc-server :store store) node decoded)
    (is-false (gethash "gr8sRuntimeEvents" status))))

(test retired-attempt-event-survives-wire-publication-and-native-reconstruction
  (with-temporary-store (store directory)
    (let* ((now 4000000000) (gr8s::*event-clock* (lambda () now))
           (pod (event-outbox-pod store)) (runtime (gr8s::make-containerd-runtime :log-root directory))
           (manager (gr8s::make-container-probe-manager :clock (lambda () now)))
           (target (event-outbox-target manager pod "c0" now)))
      (setf (gr8s::containerd-runtime-probes runtime) manager)
      (gr8s::checkpoint-container-probes runtime pod manager)
      (gr8s::retire-container-probe-targets manager (constantly t))
      (is-false (gethash (gr8s::probe-target-key target) (gr8s::container-probe-manager-targets manager)))
      (is (= 1 (length (gr8s::runtime-events runtime (pod-uid pod)))))
      (let ((reopened (gr8s::make-containerd-runtime :log-root directory)))
        (setf (gr8s::containerd-runtime-probes reopened) (gr8s::make-container-probe-manager :clock (lambda () now)))
        (let ((page (gr8s::runtime-events reopened (pod-uid pod))))
          (is (= 1 (length page)))
          (deliver-probe-event-page store pod page "other-node")
          (is (null (gr8s::list-core-resources store "events" "default")))
          (deliver-probe-event-page store pod page)
          (is (= 1 (length (gr8s::list-core-resources store "events" "default"))))))
      (is-false (gethash "gr8sRuntimeEvents" (gethash (pod-uid pod) (gr8s::pod-store-pod-observed-statuses store))))
      ;; A CID replacement retains the original occurrence but owns fresh probe
      ;; state. A new UID never inherits the old UID's retained event records.
      (event-outbox-target manager pod "c0" now :attempt "attempt1")
      (is (= 2 (length (gr8s::runtime-events runtime (pod-uid pod)))))
      (is-false (gr8s::runtime-events runtime "replacement-pod-uid"))
      (let ((old-page (gr8s::runtime-events runtime (pod-uid pod))))
        (gr8s::remove-pod store (pod-namespace pod) (pod-name pod))
        (let ((replacement (event-outbox-pod store)))
          (is (not (equal (pod-uid pod) (pod-uid replacement))))
          (deliver-probe-event-page store pod old-page)
          (is (= 1 (length (gr8s::list-core-resources store "events" "default"))))
          (is-false (gethash (pod-uid replacement) (gr8s::pod-store-pod-observed-statuses store))))))))

(test large-pod-events-use-fair-pages-and-replays-do-not-churn-api-history
  (with-temporary-store (store directory)
    (let* ((now 4000000000) (gr8s::*event-clock* (lambda () now))
           (pod (event-outbox-pod store 130)) (runtime (gr8s::make-containerd-runtime :log-root directory))
           (manager (gr8s::make-container-probe-manager :clock (lambda () now))))
      (setf (gr8s::containerd-runtime-probes runtime) manager)
      (loop for container across (pod-containers pod) do (event-outbox-target manager pod (container-spec-name container) now))
      (dotimes (page 3)
        (let ((events (gr8s::runtime-events runtime (pod-uid pod))))
          (is (= 64 (length events))) (deliver-probe-event-page store pod events)))
      (is (= 130 (length (gr8s::list-core-resources store "events" "default"))))
      (let ((revision (gr8s::pod-store-resource-revision store)))
        (dotimes (page 4) (deliver-probe-event-page store pod (gr8s::runtime-events runtime (pod-uid pod))))
        (is (= revision (gr8s::pod-store-resource-revision store))))
      (gr8s::retire-container-probe-targets manager (constantly t))
      (gr8s::checkpoint-container-probes runtime pod manager)
      (setf runtime (gr8s::make-containerd-runtime :log-root directory)
            (gr8s::containerd-runtime-probes runtime) (gr8s::make-container-probe-manager :clock (lambda () now)))
      (let ((seen (make-hash-table :test #'equal)))
        (dotimes (page 3)
          (loop for event across (gr8s::runtime-events runtime (pod-uid pod)) do (setf (gethash (gethash "id" event) seen) t)))
        (is (= 130 (hash-table-count seen)))))))

(test receiver-accepts-valid-oversize-pages-without-dropping-entire-batch
  (with-temporary-store (store directory)
    (let* ((now 4000000000) (gr8s::*event-clock* (lambda () now))
           (pod (event-outbox-pod store 65)) (runtime (gr8s::make-containerd-runtime :log-root directory))
           (manager (gr8s::make-container-probe-manager :clock (lambda () now))))
      (setf (gr8s::containerd-runtime-probes runtime) manager)
      (loop for container across (pod-containers pod) do (event-outbox-target manager pod (container-spec-name container) now))
      (let ((records (gr8s::collect-container-probe-events manager (pod-uid pod) nil)))
        (deliver-probe-event-page store pod (coerce (loop for event being the hash-values of records collect event) 'vector)))
      (is (= 65 (length (gr8s::list-core-resources store "events" "default")))))))

(test probe-outbox-coalesces-expires-and-evicts-oldest-before-unbounded-growth
  (with-temporary-store (store directory)
    (let* ((now 4000000000) (gr8s::*event-clock* (lambda () now))
           (gr8s::*container-probe-event-capacity* 2)
           (pod (event-outbox-pod store 3)) (runtime (gr8s::make-containerd-runtime :log-root directory))
           (manager (gr8s::make-container-probe-manager :clock (lambda () now)))
           (old (event-outbox-target manager pod "c0" now)))
      (setf (gr8s::containerd-runtime-probes runtime) manager)
      (incf now) (event-outbox-target manager pod "c1" now)
      (incf now) (event-outbox-target manager pod "c2" now)
      (let ((page (gr8s::runtime-events runtime (pod-uid pod))))
        (is (= 2 (length page)))
        (is-false (find "c0" page :test #'equal :key (lambda (event) (gethash "container" event)))))
      (let ((worker (first (gr8s::container-probe-target-workers old))))
        (incf now) (gr8s::record-container-probe-result worker nil "second real occurrence" now))
      (let* ((page (gr8s::runtime-events runtime (pod-uid pod)))
             (coalesced (find "c0" page :test #'equal :key (lambda (event) (gethash "container" event)))))
        (is (= 2 (length page))) (is (= 2 (gethash "count" coalesced)))
        (deliver-probe-event-page store pod page)
        (incf now gr8s::*event-ttl-seconds*)
        (is-false (gr8s::runtime-events runtime (pod-uid pod)))
        (is (= 0 (hash-table-count (gr8s::container-probe-manager-event-outbox manager))))
        (is (= 0 (hash-table-count (gr8s::container-probe-manager-event-cursors manager))))
        (is (null (gr8s::list-core-resources store "events" "default"))))
      ;; Even a delayed old peer page cannot recreate expired API Events.
      (let ((record (gr8s::copy-core-object (gethash "Unhealthy" (gr8s::container-probe-worker-events (first (gr8s::container-probe-target-workers old)))))))
        (setf (gethash "container" record) "c0" (gethash "kind" record) "readinessProbe")
        (deliver-probe-event-page store pod (vector record))
        (is (null (gr8s::list-core-resources store "events" "default")))))))

(test concurrent-cumulative-replays-commit-one-event-count-update
  (with-temporary-store (store directory)
    (let* ((now 4000000000) (gr8s::*event-clock* (lambda () now))
           (pod (event-outbox-pod store)) (runtime (gr8s::make-containerd-runtime :log-root directory))
           (manager (gr8s::make-container-probe-manager :clock (lambda () now)))
           (target (event-outbox-target manager pod "c0" now))
           (entered (bt:make-semaphore)) (release (bt:make-semaphore))
           (original (symbol-function 'gr8s::get-core-resource)) (threads nil))
      (setf (gr8s::containerd-runtime-probes runtime) manager)
      (gr8s::record-node-runtime-events store pod "probe-node" (gr8s::runtime-events runtime (pod-uid pod)))
      (incf now)
      (gr8s::record-container-probe-result (first (gr8s::container-probe-target-workers target)) nil "second occurrence" now)
      (let ((page (gr8s::runtime-events runtime (pod-uid pod)))
            (revision (gr8s::pod-store-resource-revision store)))
        (unwind-protect
             (progn
               (setf (symbol-function 'gr8s::get-core-resource)
                     (lambda (&rest arguments)
                       (let ((result (apply original arguments)))
                         (bt:signal-semaphore entered) (bt:wait-on-semaphore release) result)))
               (dotimes (index 2)
                 (push (bt:make-thread (lambda ()
                                        (let ((gr8s::*event-clock* (lambda () now)))
                                          (gr8s::record-node-runtime-events store pod "probe-node" page)))) threads))
               (is (bt:wait-on-semaphore entered :timeout 3))
               (is (bt:wait-on-semaphore entered :timeout 3))
               (bt:signal-semaphore release :count 2)
               (mapc #'bt:join-thread threads)
               (is (= (1+ revision) (gr8s::pod-store-resource-revision store)))
               (is (= 2 (gethash "count" (first (gr8s::list-core-resources store "events" "default"))))))
          (setf (symbol-function 'gr8s::get-core-resource) original)
          (bt:signal-semaphore release :count 2)
          (mapc #'bt:join-thread threads))))))
