(in-package #:gr8s/tests)
(def-suite store-snapshot-materialize :in gr8s)
(in-suite store-snapshot-materialize)

(defun snapshot-test-digest (path)
  (gr8s.raft.transport::raft-snapshot-file-digest path))

(test encrypted-secret-snapshot-restores-with-cluster-identity
  (with-temporary-store (store root)
    (let ((artifact (merge-pathnames "encrypted.jsonl" root))
          (sentinel "c25hcHNob3Qtc2VudGluZWw="))
      (gr8s::enable-secret-encryption store)
      (gr8s::create-core-resource
       store "secrets"
       (gr8s::core-object
        "apiVersion" "v1" "kind" "Secret"
        "metadata" (gr8s::core-object "name" "restored" "namespace" "default")
        "data" (gr8s::core-object "password" sentinel))
       "default")
      (gr8s.resources::capture-store-snapshot store artifact 17 3)
      (is (null (search sentinel (uiop:read-file-string artifact))))
      (multiple-value-bind (path descriptor)
          (gr8s.resources::materialize-store-snapshot
           root artifact (snapshot-test-digest artifact)
           :expected-index 17 :expected-term 3)
        (declare (ignore path))
        (gr8s.store::publish-store-generation root (gethash "generation" descriptor))
        (let* ((restored (gr8s:open-store root))
               (secret (gr8s::get-core-resource
                        restored "secrets" "default" "restored")))
          (is (equal sentinel (gethash "password" (gethash "data" secret))))
          (is-true (gethash "enabled"
                            (gr8s::secret-encryption-status restored))))))))

(test snapshot-materialization-reopens-application-state-and-preserves-member-root
  (with-temporary-store (store root)
    (let* ((artifact (merge-pathnames "source.jsonl" root))
           (pod (ha-make-pod store "materialized"))
           (uid (gr8s:pod-uid pod))
           (sentinel (merge-pathnames "pki/member-private.key" root)))
      (gr8s::create-core-resource store "configmaps" (core-fixture "ConfigMap" "captured" "data" (gr8s::core-object "unicode" "λ☃")) "default")
      (gr8s::create-core-resource store "customresourcedefinitions" (crd-fixture) nil)
      (gr8s::create-core-resource store "custom:widgets.example.test/widgets" (crd-instance) "default")
      (gr8s:register-node store (gr8s:make-node-record :id "materialized-node" :name "materialized-node" :pod-cidr "10.88.0.0/20"))
      (gr8s::update-pod-observed-status store pod (gr8s::core-object "phase" "Running" "message" "observation"))
      (gr8s.store:with-store-lock (store)
        (gr8s.store:publish-pod-status-unlocked store pod (gr8s::core-object "phase" "Running" "reason" "Published")))
      (setf (gethash "deleting" (gr8s::pod-store-workload-deletions store))
            (gr8s::core-object "policy" "Foreground")
            (gethash "job" (gr8s::pod-store-job-controller-states store))
            (gr8s::core-object "finished" 2))
      (gr8s.security::write-private-text-exclusively sentinel "member-private-sentinel")
      (gr8s.resources::capture-store-snapshot store artifact 42 7)
      (let ((view (gr8s::pod-published-view store (gr8s:get-pod store "default" "materialized")))
            (clock (gr8s::pod-store-pod-revision store))
            (revision (gr8s::pod-store-resource-revision store)))
        (multiple-value-bind (path descriptor count)
            (gr8s.resources::materialize-store-snapshot root artifact (snapshot-test-digest artifact)
                                                       :expected-index 42 :expected-term 7)
          (is (plusp count))
          (is (= 42 (gethash "index" descriptor)))
          (is (= 7 (gethash "term" descriptor)))
          (is (equal (snapshot-test-digest artifact) (gethash "artifactSha256" descriptor)))
          (is (null (gr8s.store::selected-store-generation-root root)))
          (is (null (directory (merge-pathnames "*.part" path))))
          (is (not (probe-file (merge-pathnames "pki/" path))))
          (is (equalp view (gr8s::pod-published-view store (gr8s:get-pod store "default" "materialized"))))
          (gr8s.store::publish-store-generation root (gethash "generation" descriptor))
          (let* ((restored (gr8s:open-store root))
                 (restored-pod (gr8s:get-pod restored "default" "materialized")))
            (is (equal uid (gr8s:pod-uid restored-pod)))
            (is (equalp view (gr8s::pod-published-view restored restored-pod)))
            (is (= clock (gr8s::pod-store-pod-revision restored)))
            (is (= revision (gr8s::pod-store-resource-revision restored)))
            (is (equal "observation" (gethash "message" (gethash uid (gr8s::pod-store-pod-observed-statuses restored)))))
            (is (equal "10.88.0.0/20" (ha-node-cidr restored "materialized-node")))
            (is (gr8s::get-core-resource restored "configmaps" "default" "captured"))
            (is (gr8s::get-core-resource restored "custom:widgets.example.test/widgets" "default" "one"))
            (is (equal "λ☃" (gethash "unicode" (gethash "data" (gr8s::get-core-resource restored "configmaps" "default" "captured")))))
            (is (equal "Foreground" (gethash "policy" (gethash "deleting" (gr8s::pod-store-workload-deletions restored)))))
            (is (= 2 (gethash "finished" (gethash "job" (gr8s::pod-store-job-controller-states restored)))))
            (is (equalp (gr8s::pod-store-template-history store) (gr8s::pod-store-template-history restored)))
            (is (= (gr8s::pod-store-resource-history-start store) (gr8s::pod-store-resource-history-start restored)))
            (is (equalp (gr8s::pod-store-template-token-key store) (gr8s::pod-store-template-token-key restored)))
            (is (equal "member-private-sentinel" (uiop:read-file-string sentinel)))
            (is (= #o600 (logand #o777 (sb-posix:stat-mode (sb-posix:stat (namestring (gr8s.resources::core-resource-state-path restored)))))))))))))

(test snapshot-materialization-rejects-checksum-and-semantic-errors-without-selection
  (with-temporary-store (store root)
    (let ((artifact (merge-pathnames "source.jsonl" root))
          (id "01234567-89ab-4cde-8fab-0123456789ab"))
      (capture-valid-store-snapshot store artifact)
      (signals error (gr8s.resources::materialize-store-snapshot root artifact (make-string 64 :initial-element #\0) :generation-id id))
      (is (null (probe-file (gr8s.store::store-generation-complete-path root id))))
      (signals error (gr8s.store::publish-store-generation root id))
      (is (null (gr8s.store::selected-store-generation-root root)))
      (let* ((records (read-store-snapshot-records artifact))
             (duplicate (snapshot-index-copy (snapshot-index-row records "pod")))
             (bad (snapshot-index-records-path root (append (butlast records) (list duplicate (car (last records))))))
             (bad-id "fedcba98-7654-4321-8abc-fedcba987654"))
        (signals error (gr8s.resources::materialize-store-snapshot root bad (snapshot-test-digest bad) :generation-id bad-id))
        (is (null (probe-file (gr8s.store::store-generation-complete-path root bad-id))))
        (is (null (gr8s.store::selected-store-generation-root root))))
      (is (gr8s:get-pod store "default" "snapshot-pod")))))

(test snapshot-materialization-failure-keeps-staged-generation-incomplete-and-allows-fresh-retry
  (with-temporary-store (store root)
    (let* ((artifact (merge-pathnames "source.jsonl" root))
           (id "01234567-89ab-4cde-8fab-0123456789ab")
           (original (symbol-function 'gr8s.resources::write-snapshot-generation-json))
           (writes 0))
      (capture-valid-store-snapshot store artifact)
      (unwind-protect
           (progn
             (setf (symbol-function 'gr8s.resources::write-snapshot-generation-json)
                   (lambda (&rest arguments)
                     (when (= 2 (incf writes)) (error "Injected staged file failure"))
                     (apply original arguments)))
             (signals error (gr8s.resources::materialize-store-snapshot root artifact (snapshot-test-digest artifact) :generation-id id)))
        (setf (symbol-function 'gr8s.resources::write-snapshot-generation-json) original))
      (is (null (probe-file (gr8s.store::store-generation-complete-path root id))))
      (is (null (gr8s.store::selected-store-generation-root root)))
      (multiple-value-bind (path descriptor)
          (gr8s.resources::materialize-store-snapshot root artifact (snapshot-test-digest artifact))
        (is (probe-file path))
        (is (gr8s.store::checked-store-generation-descriptor root (gethash "generation" descriptor)))))))

(test empty-store-materializes-without-a-template-token-key
  (with-temporary-store (store root)
    (let ((artifact (merge-pathnames "empty.jsonl" root)))
      (gr8s.resources::capture-store-snapshot store artifact 0 0)
      (multiple-value-bind (path descriptor count)
          (gr8s.resources::materialize-store-snapshot root artifact (snapshot-test-digest artifact))
        (declare (ignore path))
        (is (= 4 count))
        (gr8s.store::publish-store-generation root (gethash "generation" descriptor))
        (let ((restored (gr8s:open-store root)))
          (is (= 0 (hash-table-count (gr8s::pod-store-resources restored))))
          (is (null (gr8s::pod-store-template-token-key restored))))))))

(test materializer-parses-only-the-hashed-private-source-copy
  (with-temporary-store (store root)
    (let* ((artifact (merge-pathnames "source.jsonl" root))
           (original (symbol-function 'gr8s.resources::copy-snapshot-generation-source)))
      (capture-valid-store-snapshot store artifact)
      (let ((digest (snapshot-test-digest artifact)))
        (unwind-protect
             (progn
               (setf (symbol-function 'gr8s.resources::copy-snapshot-generation-source)
                     (lambda (&rest args)
                       (apply original args)
                       (with-open-file (stream artifact :direction :output :if-exists :supersede)
                         (write-string "replaced caller source" stream))))
               (multiple-value-bind (path descriptor)
                   (gr8s.resources::materialize-store-snapshot root artifact digest)
                 (is (probe-file path))
                 (is (equal digest (gethash "artifactSha256" descriptor)))
                 (is (not (equal digest (snapshot-test-digest artifact))))
                 (gr8s.store::publish-store-generation root (gethash "generation" descriptor))
                 (is (gr8s:get-pod (gr8s:open-store root) "default" "snapshot-pod"))))
          (setf (symbol-function 'gr8s.resources::copy-snapshot-generation-source) original))))))

(test materializer-directory-sync-failure-cannot-complete-or-select-generation
  (with-temporary-store (store root)
    (let* ((artifact (merge-pathnames "source.jsonl" root))
           (id "01234567-89ab-4cde-8fab-0123456789ab")
           (path (gr8s.store::store-generation-root root id))
           (objects (merge-pathnames "objects/" path))
           (original (symbol-function 'gr8s.store::sync-store-generation-directory))
           (injected nil))
      (capture-valid-store-snapshot store artifact)
      (unwind-protect
           (progn
             (setf (symbol-function 'gr8s.store::sync-store-generation-directory)
                   (lambda (directory)
                     (when (equal directory objects)
                       (setf injected t)
                       (error "Injected payload directory sync failure"))
                     (funcall original directory)))
             (signals error (gr8s.resources::materialize-store-snapshot root artifact (snapshot-test-digest artifact) :generation-id id)))
        (setf (symbol-function 'gr8s.store::sync-store-generation-directory) original))
      (is-true injected)
      (is (probe-file (merge-pathnames "objects/state.json" path)))
      (is (null (probe-file (gr8s.store::store-generation-complete-path root id))))
      (is (null (gr8s.store::selected-store-generation-root root))))))
