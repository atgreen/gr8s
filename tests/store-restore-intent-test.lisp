(in-package #:gr8s/tests)
(def-suite store-restore-intent :in gr8s)
(in-suite store-restore-intent)

(defun materialize-live-test-snapshot (store root artifact)
  (gr8s.resources::materialize-store-snapshot
   root artifact (snapshot-test-digest artifact)
   :minimum-resource-revision (1+ (gr8s.store::pod-store-resource-revision store))
   :minimum-pod-revision (1+ (gr8s.store::pod-store-pod-revision-ceiling store))))

(defun make-restore-intent-fixture (store root)
  (let ((artifact (merge-pathnames "restore-source.jsonl" root)))
    (capture-valid-store-snapshot store artifact)
    (let ((descriptor (nth-value 1 (materialize-live-test-snapshot store root artifact))))
      (ha-make-pod store "legacy-later")
      descriptor)))

(test restore-intent-resumes-before-data-loading-and-clears-only-after-success
  (with-temporary-store (store root)
    (let* ((descriptor (make-restore-intent-fixture store root))
           (id (gethash "generation" descriptor))
           (intent (gr8s.store::store-restore-intent-path root)))
      (gr8s.store::begin-store-restore root id)
      (is (probe-file intent))
      (is (null (gr8s.store::selected-store-generation-root root)))
      (is (gr8s.store::get-pod store "default" "legacy-later"))
      (let ((restored (gr8s.store::open-store root)))
        (is (equal (gr8s.store::store-generation-root root id) (gr8s.store:store-data-path restored)))
        (is (gr8s.store::get-pod restored "default" "snapshot-pod"))
        (signals gr8s.model::kubernetes-error (gr8s.store::get-pod restored "default" "legacy-later"))
        (is (null (probe-file intent)))
        (is (equal root (gr8s.store:store-data-path store)))
        (is (gr8s.store::finish-store-restore restored descriptor))))))

(test interrupted-selection-and-load-failure-retain-intent-for-retry
  (with-temporary-store (store root)
    (let* ((descriptor (make-restore-intent-fixture store root))
           (id (gethash "generation" descriptor))
           (intent (gr8s.store::store-restore-intent-path root))
           (checkpoint (merge-pathnames "objects/state.json" (gr8s.store::store-generation-root root id)))
           (bytes (uiop:read-file-string checkpoint)))
      (gr8s.store::begin-store-restore root id)
      (gr8s.store::resume-store-restore-selection root)
      (signals error (gr8s.store::finish-store-restore store descriptor))
      (gr8s.security::write-private-text-atomically checkpoint "{")
      (signals error (gr8s.store::open-store root))
      (is (probe-file intent))
      (is (equal (gr8s.store::store-generation-root root id) (gr8s.store::selected-store-generation-root root)))
      (gr8s.security::write-private-text-atomically checkpoint bytes)
      (is (gr8s.store::get-pod (gr8s.store::open-store root) "default" "snapshot-pod"))
      (is (null (probe-file intent))))))

(test pending-restore-rejects-conflicting-intent-and-generation-selection
  (with-temporary-store (store root)
    (let* ((one (make-restore-intent-fixture store root))
           (artifact (merge-pathnames "restore-source.jsonl" root))
           (two (nth-value 1 (gr8s.resources::materialize-store-snapshot root artifact (snapshot-test-digest artifact))))
           (id (gethash "generation" one)))
      (gr8s.store::begin-store-restore root id)
      (is (gr8s.store::begin-store-restore root id))
      (signals error (gr8s.store::begin-store-restore root (gethash "generation" two)))
      (signals error (gr8s.store::publish-store-generation root (gethash "generation" two)))
      (is (equal id (gethash "generation" (gr8s.store::read-store-restore-intent root))))
      (is (gr8s.store::open-store root))
      (is (gr8s.store::begin-store-restore root (gethash "generation" two)))
      (is (gr8s.store::open-store root)))))

(test invalid-restore-intent-fails-before-old-data-can-be-exposed
  (with-temporary-store (store root)
    (let* ((descriptor (make-restore-intent-fixture store root))
           (path (gr8s.store::store-restore-intent-path root)))
      (gr8s.store::begin-store-restore root (gethash "generation" descriptor))
      (sb-posix:chmod (namestring path) #o644)
      (signals error (gr8s.store::open-store root))
      (sb-posix:chmod (namestring path) #o600)
      (let ((bad (snapshot-index-copy descriptor)))
        (incf (gethash "term" bad))
        (gr8s.store::write-store-generation-descriptor path bad :replace t))
      (signals error (gr8s.store::open-store root))
      (is (null (gr8s.store::selected-store-generation-root root)))
      (is (gr8s.store::get-pod store "default" "legacy-later")))))

(test selection-write-failure-preserves-intent-and-retries-on-next-open
  (with-temporary-store (store root)
    (let* ((descriptor (make-restore-intent-fixture store root))
           (id (gethash "generation" descriptor))
           (original (symbol-function 'gr8s.store::write-store-generation-descriptor)))
      (gr8s.store::begin-store-restore root id)
      (unwind-protect
           (progn
             (setf (symbol-function 'gr8s.store::write-store-generation-descriptor)
                   (lambda (path value &rest options)
                     (when (equal path (gr8s.store::store-generation-selector-path root))
                       (error "Injected selection publication failure"))
                     (apply original path value options)))
             (signals error (gr8s.store::open-store root)))
        (setf (symbol-function 'gr8s.store::write-store-generation-descriptor) original))
      (is (null (gr8s.store::selected-store-generation-root root)))
      (is (gr8s.store::read-store-restore-intent root))
      (is (gr8s.store::open-store root))
      (is (null (gr8s.store::read-store-restore-intent root))))))

(test intent-cleanup-sync-failure-reports-uncertainty-and-reopen-uses-complete-target
  (with-temporary-store (store root)
    (let* ((descriptor (make-restore-intent-fixture store root))
           (id (gethash "generation" descriptor))
           (intent (gr8s.store::store-restore-intent-path root))
           (metadata (uiop:pathname-directory-pathname intent))
           (original (symbol-function 'gr8s.store::sync-store-generation-directory))
           (injected nil))
      (gr8s.store::begin-store-restore root id)
      (unwind-protect
           (progn
             (setf (symbol-function 'gr8s.store::sync-store-generation-directory)
                   (lambda (directory)
                     (when (and (equal directory metadata) (not (gr8s.store::store-generation-stat intent)))
                       (setf injected t)
                       (error "Injected intent unlink synchronization failure"))
                     (funcall original directory)))
             (signals error (gr8s.store::open-store root)))
        (setf (symbol-function 'gr8s.store::sync-store-generation-directory) original))
      (is-true injected)
      (is (null (probe-file intent)))
      (is (equal (gr8s.store::store-generation-root root id) (gr8s.store::selected-store-generation-root root)))
      (is (gr8s.store::get-pod (gr8s.store::open-store root) "default" "snapshot-pod")))))

(test restore-publication-sync-errors-retain-recoverable-intent
  (dolist (phase '(:intent :selector))
    (with-temporary-store (store root)
      (let* ((descriptor (make-restore-intent-fixture store root))
             (id (gethash "generation" descriptor))
             (intent (gr8s.store::store-restore-intent-path root))
             (selector (gr8s.store::store-generation-selector-path root))
             (metadata (uiop:pathname-directory-pathname intent))
             (original (symbol-function 'gr8s.store::sync-store-generation-directory))
             (injected nil))
        (when (eq phase :selector) (gr8s.store::begin-store-restore root id))
        (unwind-protect
             (progn
               (setf (symbol-function 'gr8s.store::sync-store-generation-directory)
                     (lambda (directory)
                       (when (and (equal directory metadata)
                                  (gr8s.store::store-generation-stat (if (eq phase :intent) intent selector)))
                         (setf injected t)
                         (error "Injected restore publication directory sync failure"))
                       (funcall original directory)))
               (signals error
                 (if (eq phase :intent) (gr8s.store::begin-store-restore root id) (gr8s.store::open-store root))))
          (setf (symbol-function 'gr8s.store::sync-store-generation-directory) original))
        (is-true injected)
        (is (probe-file intent))
        (is (equal id (gethash "generation" (gr8s.store::read-store-restore-intent root))))
        (is (eq (not (null (probe-file selector))) (eq phase :selector)))
        (is (gr8s.store::get-pod (gr8s.store::open-store root) "default" "snapshot-pod"))
        (is (null (probe-file intent)))))))
