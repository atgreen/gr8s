(in-package #:gr8s/tests)
(def-suite pod-transactions :in gr8s)
(in-suite pod-transactions)

(defun apply-pod-test-command (store kind json)
  (ecase kind
    (:pod-delta (gr8s.store::install-pod-state-delta store json))
    (:core-delta (gr8s.resources::install-core-state-delta store json))
    (:node-delta (gr8s.store::install-node-state-delta store json))))

(defun changed-pod-label (pod value)
  (let ((object (gr8s.store::copy-pod-status-value (gr8s.model::pod-to-object pod))))
    (setf (gethash "labels" (gethash "metadata" object)) (gr8s.resources::core-object "changed" value))
    (gr8s.kubelet::parse-pod object)))

(test pod-proposal-is-not-visible-or-durable-before-consensus
  (with-temporary-store (store path)
    (declare (ignore path))
    (let ((proposed nil))
      (setf (gr8s.store::pod-store-consensus-commit-fn store)
            (lambda (kind json)
              (when (eq kind :pod-delta)
                (let* ((entry (aref (gethash "changes" (com.inuoe.jzon:parse json)) 0))
                       (uid (gethash "uid" entry)))
                  (is (null (gethash "default/new" (gr8s.store::pod-store-pods store))))
                  (is-false (probe-file (merge-pathnames (format nil "~A.json" uid) (gr8s.store::pod-store-path store))))
                  (is (= 0 (gr8s.store::pod-store-pod-watch-journal-length store)))
                  (setf proposed t)))
              (apply-pod-test-command store kind json)))
      (ha-make-pod store "new")
      (is-true proposed)
      (is (stringp (ha-pod-uid store "new")))
      (is (= 1 (gr8s.store::pod-store-pod-watch-journal-length store))))))

(test failed-pod-proposals-preserve-create-update-delete-and-watch-state
  (with-temporary-store (store path)
    (let* ((pod (ha-make-pod store "existing"))
           (version (gr8s.model::pod-resource-version pod))
           (journal (gr8s.store::pod-store-pod-watch-journal store))
           (file (gr8s.store::pod-path store pod))
           (bytes (uiop:read-file-string file)))
      (setf (gr8s.store::pod-store-consensus-commit-fn store)
            (lambda (&rest ignored) (declare (ignore ignored)) (error "No quorum")))
      (signals error (ha-make-pod store "uncommitted"))
      (is (null (ha-pod-uid store "uncommitted")))
      (signals error (gr8s.store::update-pod store (changed-pod-label pod "yes") version))
      (is (eq pod (gr8s.store::get-pod store "default" "existing")))
      (is (equal bytes (uiop:read-file-string file)))
      (signals error (gr8s.store::delete-pod store "default" "existing"))
      (is (eq pod (gr8s.store::get-pod store "default" "existing")))
      (is (equal bytes (uiop:read-file-string file)))
      (is (eq journal (gr8s.store::pod-store-pod-watch-journal store)))
      (let ((reopened (gr8s.store::open-store path)))
        (is (equal (gr8s.model::pod-uid pod) (ha-pod-uid reopened "existing")))
        (is (null (ha-pod-uid reopened "uncommitted")))))))

(test per-pod-commands-preserve-unrelated-stale-member-keys
  (with-temporary-store (left lp)
    (with-temporary-store (right rp)
      (with-temporary-store (replica sp)
        (declare (ignore lp rp sp))
        (let ((commands nil))
          (dolist (store (list left right))
            (setf (gr8s.store::pod-store-consensus-commit-fn store)
                  (lambda (kind json) (push (cons kind json) commands))))
          (ha-make-pod left "left")
          (ha-make-pod right "right")
          (dolist (command (reverse commands))
            (is (eq :pod-delta (car command)))
            (is (= 1 (length (gethash "changes" (com.inuoe.jzon:parse (cdr command))))))
            (apply-pod-test-command replica (car command) (cdr command)))
          (is (stringp (ha-pod-uid replica "left")))
          (is (stringp (ha-pod-uid replica "right"))))))))

(test stale-pod-update-conflicts-at-apply-and-observation-cannot-resurrect
  (with-temporary-store (store path)
    (declare (ignore path))
    (let* ((pod (ha-make-pod store "target")) (updates nil))
      (setf (gr8s.store::pod-store-consensus-commit-fn store)
            (lambda (kind json) (when (eq kind :pod-delta) (push json updates))))
      (gr8s.store::update-pod store (changed-pod-label pod "first") (gr8s.model::pod-resource-version pod))
      (gr8s.store::update-pod store (changed-pod-label pod "second") (gr8s.model::pod-resource-version pod))
      (setf updates (reverse updates))
      (is (equal '(:pod-ok) (gr8s.store::install-pod-state-delta store (first updates))))
      (is (equal '(:pod-conflict) (gr8s.store::install-pod-state-delta store (second updates))))
      ;; Retrying the exact committed command is idempotent, including watches.
      (let ((count (gr8s.store::pod-store-pod-watch-journal-length store)))
        (is (equal '(:pod-ok) (gr8s.store::install-pod-state-delta store (first updates))))
        (is (= count (gr8s.store::pod-store-pod-watch-journal-length store))))
      (let ((current (gr8s.store::get-pod store "default" "target")) (observation nil))
        (setf (gr8s.store::pod-store-consensus-commit-fn store)
              (lambda (kind json) (when (eq kind :pod-delta) (setf observation json))))
        (gr8s.kubelet::save-pod-observation store current (gr8s.resources::core-object "phase" "Running"))
        (setf (gr8s.store::pod-store-consensus-commit-fn store) nil)
        (gr8s.store::delete-pod store "default" "target")
        (is (stringp observation))
        (gr8s.store::install-pod-state-delta store observation)
        (is (null (ha-pod-uid store "target")))))))
(test staged-pod-body-error-publishes-nothing
  (with-temporary-store (store path)
    (let ((calls 0))
      (setf (gr8s.store::pod-store-consensus-commit-fn store)
            (lambda (&rest args) (declare (ignore args)) (incf calls)))
      (signals error
        (gr8s.store::with-store-lock (store)
          (let ((pod (gr8s.kubelet::parse-pod *valid-pod-json*)))
            (gr8s.store::create-pod-unlocked store pod)
            (error "Abort body"))))
      (is (= 0 calls))
      (is (null (ha-pod-uid store "hello")))
      (is (= 0 (gr8s.store::pod-store-pod-watch-journal-length store)))
      (is (null (ha-pod-uid (gr8s.store::open-store path) "hello"))))))

(test status-proposal-failure-preserves-published-object-and-checkpoint
  (with-temporary-store (store path)
    (declare (ignore path))
    (let* ((pod (ha-make-pod store "observed"))
           (revision (gr8s.model::pod-status-revision pod))
           (journal (gr8s.store::pod-store-pod-watch-journal store)))
      (setf (gr8s.store::pod-store-consensus-commit-fn store)
            (lambda (&rest args) (declare (ignore args)) (error "No quorum")))
      (signals error (gr8s.kubelet::save-pod-observation store pod (gr8s.resources::core-object "phase" "Running")))
      (is (null (gethash (gr8s.model::pod-uid pod) (gr8s.store::pod-store-pod-observed-statuses store))))
      (is-false (probe-file (gr8s.store::pod-status-state-path store (gr8s.model::pod-uid pod))))
      (signals error
        (gr8s.store::with-store-lock (store)
          (gr8s.store::publish-pod-status-unlocked store pod (gr8s.resources::core-object "phase" "Running"))))
      (is (eql revision (gr8s.model::pod-status-revision pod)))
      (is (eq pod (gr8s.store::get-pod store "default" "observed")))
      (is (eq journal (gr8s.store::pod-store-pod-watch-journal store))))))

(test pod-status-and-client-checkpoints-replicate-and-survive-restart
  (with-temporary-store (source source-path)
    (with-temporary-store (follower follower-path)
      (declare (ignore source-path))
      (ha-make-pod follower "unrelated")
      (setf (gr8s.store::pod-store-consensus-commit-fn source)
            (lambda (kind json)
              (let ((result (apply-pod-test-command source kind json)))
                (apply-pod-test-command follower kind json) result)))
      (let ((pod (ha-make-pod source "observed")))
        (gr8s.kubelet::save-pod-observation source pod (gr8s.resources::core-object "phase" "Running"))
        (gr8s.apiserver::save-pod-client-status source pod (gr8s.resources::core-object "message" "checkpointed"))
        (is (stringp (ha-pod-uid follower "unrelated")))
        (let ((uid (gr8s.model::pod-uid pod)))
          (is (equal "Running" (gethash "phase" (gethash uid (gr8s.store::pod-store-pod-observed-statuses follower)))))
          (is (equal "checkpointed" (gethash "message" (gethash uid (gr8s.store::pod-store-pod-client-statuses follower)))))
          (let ((reopened (gr8s.store::open-store follower-path)))
            (is (equal uid (ha-pod-uid reopened "observed")))
            (is (equal "Running" (gethash "phase" (gethash uid (gr8s.store::pod-store-pod-observed-statuses reopened)))))
            (is (equal "checkpointed" (gethash "message" (gethash uid (gr8s.store::pod-store-pod-client-statuses reopened)))))))))))

(test multi-pod-preconditions-are-checked-before-changing-any-key
  (with-temporary-store (source source-path)
    (with-temporary-store (target target-path)
      (declare (ignore source-path target-path))
      (let ((payload nil))
        (setf (gr8s.store::pod-store-consensus-commit-fn source)
              (lambda (kind json) (when (eq kind :pod-delta) (setf payload json))))
        (gr8s.store::with-store-lock (source)
          (dolist (name '("first" "second"))
            (let ((object (com.inuoe.jzon:parse *valid-pod-json*)))
              (setf (gethash "name" (gethash "metadata" object)) name)
              (gr8s.store::create-pod-unlocked source (gr8s.kubelet::parse-pod object)))))
        (is (= 2 (length (gethash "changes" (com.inuoe.jzon:parse payload)))))
        (let ((existing (ha-make-pod target "second")))
          (is (equal '(:pod-conflict) (gr8s.store::install-pod-state-delta target payload)))
          (is (null (ha-pod-uid target "first")))
          (is (equal (gr8s.model::pod-uid existing) (ha-pod-uid target "second"))))))))
(test pod-replacement-removes-old-uid-files-and-does-not-inherit-status
  (with-temporary-store (store path)
    (let* ((old (ha-make-pod store "replace")) (old-file (gr8s.store::pod-path store old)))
      (gr8s.kubelet::save-pod-observation store old (gr8s.resources::core-object "phase" "Running"))
      (setf (gr8s.store::pod-store-consensus-commit-fn store)
            (lambda (kind json) (apply-pod-test-command store kind json)))
      (gr8s.store::with-store-lock (store)
        (gr8s.store::remove-pod-unlocked store "default" "replace")
        (let ((object (com.inuoe.jzon:parse *valid-pod-json*)))
          (setf (gethash "name" (gethash "metadata" object)) "replace")
          (gr8s.store::create-pod-unlocked store (gr8s.kubelet::parse-pod object))))
      (let ((replacement (gr8s.store::get-pod store "default" "replace")))
        (is (not (equal (gr8s.model::pod-uid old) (gr8s.model::pod-uid replacement))))
        (is-false (probe-file old-file))
        (is (null (gethash (gr8s.model::pod-uid replacement) (gr8s.store::pod-store-pod-observed-statuses store))))
        (is (equal (gr8s.model::pod-uid replacement) (ha-pod-uid (gr8s.store::open-store path) "replace")))))))
(test committed-pod-versions-match-across-members-and-restart
  (with-temporary-store (source source-path)
    (with-temporary-store (follower follower-path)
      (declare (ignore source-path))
      (setf (gr8s.store::pod-store-consensus-commit-fn source)
            (lambda (kind json)
              (let ((result (apply-pod-test-command source kind json)))
                (apply-pod-test-command follower kind json) result)))
      (let ((pod (ha-make-pod source "versions")))
        (gr8s.kubelet::save-pod-observation source pod (gr8s.resources::core-object "phase" "Running"))
        (let* ((left (gr8s.store::get-pod source "default" "versions"))
               (right (gr8s.store::get-pod follower "default" "versions"))
               (left-view (gr8s.store::pod-published-view source left))
               (right-view (gr8s.store::pod-published-view follower right))
               (version (gethash "resourceVersion" (gethash "metadata" left-view))))
          (is (equal version (gethash "resourceVersion" (gethash "metadata" right-view))))
          (is (gr8s.store::pod-revision-satisfied-p follower version (gr8s.model::pod-resource-version right)))
          (let ((clock (gr8s.store::pod-store-pod-revision follower))
                (reopened (gr8s.store::open-store follower-path)))
            (is (= clock (gr8s.store::pod-store-pod-revision reopened)))))))))
(test failed-first-proposal-does-not-publish-a-reservation-after-restart
  (with-temporary-store (store path)
    (setf (gr8s.store::pod-store-consensus-commit-fn store)
          (lambda (&rest args) (declare (ignore args)) (error "No quorum")))
    (signals error (ha-make-pod store "failed"))
    (is (= 0 (gr8s.store::pod-store-pod-revision store)))
    (is (= 0 (gr8s.store::pod-store-pod-revision (gr8s.store::open-store path))))))

(test committed-node-and-pod-clocks-support-cross-member-updates
  (with-temporary-store (left lp)
    (with-temporary-store (right rp)
      (declare (ignore lp rp))
      (setf (gr8s.store::pod-store-consensus-commit-fn left)
            (lambda (kind json)
              (let ((result (apply-pod-test-command left kind json)))
                (apply-pod-test-command right kind json) result))
            (gr8s.store::pod-store-consensus-commit-fn right)
            (lambda (kind json)
              (let ((result (apply-pod-test-command right kind json)))
                (apply-pod-test-command left kind json) result)))
      (gr8s.controllers::register-node left (gr8s.model::make-node-record :id "worker" :name "worker" :pod-cidr "10.88.0.0/20"))
      (is (= (gr8s.store::pod-store-pod-revision left) (gr8s.store::pod-store-pod-revision right)))
      (let* ((pod (ha-make-pod left "cross-member"))
             (view (gr8s.store::pod-published-view left (gr8s.store::get-pod left "default" "cross-member")))
             (version (gethash "resourceVersion" (gethash "metadata" view))))
        (gr8s.store::update-pod right (changed-pod-label pod "right") version)
        (is (= (gr8s.store::pod-store-pod-revision left) (gr8s.store::pod-store-pod-revision right)))
        (dolist (store (list left right))
          (let* ((object (gr8s.model::pod-to-object (gr8s.store::get-pod store "default" "cross-member")))
                 (labels (gethash "labels" (gethash "metadata" object))))
            (is (equal "right" (gethash "changed" labels)))))))))
(in-suite gr8s)
