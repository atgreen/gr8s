;;;;
;;;; Purpose:
;;;; Prove shared Pod finalizer admission, irreversible deletion, real terminal
;;;; observation retention, exact UID recovery and final removal independently
;;;; of Job controller accounting and native probe scheduling.

(in-package #:gr8s/tests)
(def-suite pod-finalizers :in gr8s)
(in-suite pod-finalizers)

(defun finalized-test-pod (&optional (names #("example.com/cleanup")))
  "Create a normal scheduled Pod carrying real API finalizers."
  (let ((object (gr8s::copy-core-object (pod-to-object (grace-pod)))))
    (setf (gethash "finalizers" (gethash "metadata" object)) names)
    (parse-pod object)))

(defun test-terminal-pod-status ()
  "Provide an explicit failed runtime observation, including its real test exit status."
  (gr8s::core-object "phase" "Failed" "containerStatuses"
    (vector (gr8s::core-object "name" "web" "restartCount" 0 "ready" nil
                              "state" (gr8s::core-object "terminated"
                                         (gr8s::core-object "exitCode" 17 "reason" "Error"))))))

(test pod-finalizer-admission-and-irreversible-updates
  (dolist (names (list #() #("cleanup") #("batch.kubernetes.io/job-tracking") 'null))
    (is (typep (finalized-test-pod names) 'gr8s::pod)))
  (dolist (names (list "cleanup" #(1) #("bad name") #("bad/prefix/name") #("")))
    (signals kubernetes-error (finalized-test-pod names)))
  (with-temporary-store (store directory)
    (declare (ignore directory))
    (let* ((created (create-pod store (finalized-test-pod #("example.com/one" "example.com/two"))))
           (deleting (mark-pod-deleting store "default" "hello" :grace-period 0))
           (object (gr8s::copy-core-object (pod-to-object deleting))))
      (setf (gethash "finalizers" (gethash "metadata" object)) #("example.com/new"))
      (signals kubernetes-error (update-pod store (parse-pod object) (pod-resource-version deleting)))
      (setf (gethash "finalizers" (gethash "metadata" object)) #("example.com/one"))
      (let ((updated (update-pod store (parse-pod object) (pod-resource-version deleting))))
        (is (equal (pod-uid created) (pod-uid updated)))
        (is (equal (gethash "deletionTimestamp" (gethash "metadata" (pod-to-object deleting)))
                   (gethash "deletionTimestamp" (gethash "metadata" (pod-to-object updated))))))
      (signals kubernetes-error (gr8s::remove-pod store "default" "hello"))
      (is (equal (pod-uid created) (pod-uid (get-pod store "default" "hello")))))))

(test forced-deletion-retains-terminal-status-until-last-finalizer-across-reopen
  (with-temporary-store (store directory)
    (let* ((pod (create-pod store (finalized-test-pod)))
           (runtime (make-fake-runtime)) (reconciler (make-reconciler store runtime))
           (status (test-terminal-pod-status))
           (observed (gr8s::make-runtime-pod :uid (pod-uid pod) :resource-version (pod-resource-version pod)
                       :phase "Failed" :status status)))
      (setf (gethash (pod-uid pod) (gr8s::fake-runtime-pods runtime)) observed)
      (let ((actual (gr8s::delete-reconciled-pod reconciler "default" "hello" :uid (pod-uid pod) :grace-period 0)))
        (is (equal "Failed" (gethash "phase" actual)))
        (is (= 17 (gethash "exitCode" (gethash "terminated" (gethash "state" (aref (gethash "containerStatuses" actual) 0)))))))
      (is-false (runtime-observe runtime (pod-uid pod)))
      (is (equal (pod-uid pod) (pod-uid (get-pod store "default" "hello"))))
      (is-false (gethash (pod-uid pod) (gr8s::pod-store-pod-observed-resource-versions store)))
      (let* ((reopened (open-store directory)) (fresh-runtime (make-fake-runtime))
             (fresh-reconciler (make-reconciler reopened fresh-runtime))
             (retained (get-pod reopened "default" "hello")))
        (is-true (gethash "runtimeDeleted" (gr8s::pod-finalization-state reopened retained)))
        (is (equal "Failed" (gethash "phase" (reconcile-pod fresh-reconciler "default" "hello"))))
        (is (= 0 (gr8s::fake-runtime-ensure-count fresh-runtime)))
        (let ((object (gr8s::copy-core-object (pod-to-object retained))))
          (setf (gethash "finalizers" (gethash "metadata" object)) #())
          (update-pod reopened (parse-pod object) (pod-resource-version retained)))
        (reconcile-pod fresh-reconciler "default" "hello")
        (signals kubernetes-error (get-pod reopened "default" "hello"))
        (is-false (probe-file (gr8s::pod-status-state-path reopened (pod-uid pod))))
        (let ((replacement (create-pod reopened (finalized-test-pod))))
          (is-false (equal (pod-uid pod) (pod-uid replacement)))
          (is-false (gr8s::pod-finalization-state reopened replacement))
          (signals kubernetes-error (gr8s::remove-pod reopened "default" "hello" :uid (pod-uid pod))))))))

(test deletion-completion-does-not-invent-an-unobserved-terminal-success
  (with-temporary-store (store directory)
    (declare (ignore directory))
    (let* ((pod (create-pod store (finalized-test-pod))) (runtime (make-fake-runtime))
           (reconciler (make-reconciler store runtime)))
      (runtime-ensure runtime pod)
      (let ((status (gr8s::delete-reconciled-pod reconciler "default" "hello" :grace-period 0)))
        (is-false (gr8s::pod-terminal-status-p status))
        (is-true (gethash "runtimeDeleted" (gr8s::pod-finalization-state store (get-pod store "default" "hello")))))
        (is-false (gethash "status" (gr8s::pod-finalization-state store (get-pod store "default" "hello")))))))

(test native-finalizers-retain-actual-exits-after-all-cri-objects-disappear
  (with-temporary-store (store directory)
    (let* ((now (get-universal-time)) (gr8s::*container-lifecycle-clock* (lambda () now))
           (pod (lifecycle-pod store)) (runtime (gr8s::make-containerd-runtime :log-root directory))
           (object (gr8s::copy-core-object (pod-to-object pod))))
      (setf (gethash "finalizers" (gethash "metadata" object)) #("example.com/cleanup")
            pod (update-pod store (parse-pod object) (pod-resource-version pod)))
      (with-lifecycle-cri (fixture pod (list (lifecycle-info "main" 0 gr8s.cri.v1::+containerstate-container_running+ now)
                                           (lifecycle-info "side" 0 gr8s.cri.v1::+containerstate-container_running+ now)))
        (gr8s::runtime-terminate-pod runtime pod now)
        (is-false (lifecycle-cri-fixture-sandbox fixture))
        (is (null (lifecycle-cri-fixture-infos fixture)))
        (let ((actual (runtime-observe runtime (pod-uid pod))))
          (is (equal "Failed" (gr8s::runtime-pod-phase actual)))
          (is (equal "10.88.0.2" (gr8s::runtime-pod-pod-ip actual)))
          (let ((statuses (gethash "containerStatuses" (gr8s::runtime-pod-status actual))))
            (is (= 2 (length statuses)))
            (loop for status across statuses
                  do (is (= 137 (gethash "exitCode" (gethash "terminated" (gethash "state" status)))))
                     (is (search "containerd://" (gethash "containerID" status))))))
        (is (probe-file (gr8s::container-lifecycle-path runtime (pod-uid pod))))
        (gr8s::runtime-forget-pod-finalization runtime (pod-uid pod))
        (is-false (runtime-observe runtime (pod-uid pod)))
        (is-false (probe-file (gr8s::container-lifecycle-path runtime (pod-uid pod))))))))

(test failure-to-checkpoint-actual-finalized-exits-prevents-native-removal
  (with-temporary-store (store directory)
    (let* ((now (get-universal-time)) (gr8s::*container-lifecycle-clock* (lambda () now))
           (pod (lifecycle-pod store)) (runtime (gr8s::make-containerd-runtime :log-root directory))
           (object (gr8s::copy-core-object (pod-to-object pod)))
           (save (symbol-function 'gr8s::save-container-lifecycle-state)))
      (setf (gethash "finalizers" (gethash "metadata" object)) #("example.com/cleanup")
            pod (update-pod store (parse-pod object) (pod-resource-version pod)))
      (with-lifecycle-cri (fixture pod (list (lifecycle-info "main" 0 gr8s.cri.v1::+containerstate-container_running+ now)))
        (unwind-protect
             (progn
               (setf (symbol-function 'gr8s::save-container-lifecycle-state)
                     (lambda (&rest args) (declare (ignore args)) (error "Checkpoint write failed")))
               (signals error (gr8s::runtime-terminate-pod runtime pod now))
               (is-true (lifecycle-cri-fixture-sandbox fixture))
               (is (= 1 (length (lifecycle-cri-fixture-infos fixture))))
               (is-false (find :delete (lifecycle-cri-fixture-calls fixture) :key #'car))
               (is-false (find :delete-sandbox (lifecycle-cri-fixture-calls fixture) :key #'car)))
          (setf (symbol-function 'gr8s::save-container-lifecycle-state) save))))))

(defstruct (finalizer-failing-runtime (:include gr8s::fake-runtime))
  "Fail cleanup while preserving a separately supplied real terminal observation."
  (fail-cleanup t))

(defmethod gr8s::runtime-delete-pod ((runtime finalizer-failing-runtime) pod)
  "Exercise a retryable cleanup failure after actual terminal observation."
  (if (finalizer-failing-runtime-fail-cleanup runtime)
      (error 'gr8s:runtime-error :message "Native removal is temporarily unavailable")
      (call-next-method)))

(test cleanup-errors-preserve-an-actually-observed-terminal-phase
  (with-temporary-store (store directory)
    (declare (ignore directory))
    (let* ((pod (create-pod store (finalized-test-pod))) (runtime (make-finalizer-failing-runtime))
           (reconciler (make-reconciler store runtime)))
      (setf (gethash (pod-uid pod) (gr8s::fake-runtime-pods runtime))
            (gr8s::make-runtime-pod :uid (pod-uid pod) :phase "Failed" :status (test-terminal-pod-status)))
      (mark-pod-deleting store "default" "hello" :grace-period 0)
      (is (equal "Failed" (gethash "phase" (reconcile-pod reconciler "default" "hello"))))
      (let ((state (gr8s::pod-finalization-state store pod)))
        (is-false (gethash "runtimeDeleted" state))
        (is (equal "Failed" (gethash "phase" (gethash "status" state)))))
      (setf (finalizer-failing-runtime-fail-cleanup runtime) nil)
      (is (equal "Failed" (gethash "phase" (reconcile-pod reconciler "default" "hello"))))
      (is-true (gethash "runtimeDeleted" (gr8s::pod-finalization-state store pod))))))

(test finalized-pod-cleanup-ack-is-additive-and-not-a-public-phase
  (let* ((legacy (make-instance 'gr8s.node.v1::pod-observed-status :phase "Failed"))
         (current (make-instance 'gr8s.node.v1::pod-observed-status :phase "Failed" :runtime-deleted t)))
    (is-false (slot-value (ag-proto:deserialize-from-bytes 'gr8s.node.v1::pod-observed-status
                           (ag-proto:serialize-to-bytes legacy)) 'gr8s.node.v1::runtime-deleted))
    (let ((decoded (ag-proto:deserialize-from-bytes 'gr8s.node.v1::pod-observed-status (ag-proto:serialize-to-bytes current))))
      (is-true (slot-value decoded 'gr8s.node.v1::runtime-deleted))
      (is (equal "Failed" (slot-value decoded 'gr8s.node.v1::phase))))))

(test finalized-pod-control-plane-waits-for-authenticated-physical-cleanup-at-zero-grace
  (with-temporary-store (store directory)
    (let* ((server (gr8s::%make-node-grpc-server :store store))
           (runtime (gr8s::make-control-plane-runtime store server))
           (reconciler (make-reconciler store runtime))
           (backend (make-fake-runtime))
           (agent (gr8s::make-node-runtime (merge-pathnames "agent/" directory) backend nil))
           (object (gr8s::copy-core-object (pod-to-object (finalized-test-pod))))
           (pod nil))
      (setf (gethash "restartPolicy" (gethash "spec" object)) "Never"
            pod (create-pod store (parse-pod object)))
      (gr8s::register-node store (gr8s::make-node-record :id "worker-a" :name "worker-a" :pod-cidr "10.88.0.0/24"))
      (gr8s::mark-node-ready store "worker-a" (get-universal-time))
      (unwind-protect
           (progn
             (gr8s::start-node-runtime agent)
             (reconcile-pod reconciler "default" "hello")
             (gr8s::reconcile-node-snapshot agent (grace-snapshot-without-network (gr8s::current-node-snapshot server "worker-a")))
             (let ((actual (runtime-observe backend (pod-uid pod))))
               (setf (gr8s::runtime-pod-phase actual) "Failed"
                     (gr8s::runtime-pod-status actual) (test-terminal-pod-status)))
             (gr8s::delete-reconciled-pod reconciler "default" "hello" :uid (pod-uid pod) :grace-period 0)
             (is (equal (pod-uid pod) (pod-uid (get-pod store "default" "hello"))))
             (is-false (gethash "runtimeDeleted" (gr8s::pod-finalization-state store pod)))
             (let ((snapshot (gr8s::current-node-snapshot server "worker-a")))
               (is (= 1 (length (slot-value snapshot 'gr8s.node.v1::pods))))
               (gr8s::reconcile-node-snapshot agent (grace-snapshot-without-network snapshot)))
             (let* ((status (gr8s::node-runtime-status agent))
                    (message (first (slot-value status 'gr8s.node.v1::pods)))
                    (version (slot-value message 'gr8s.node.v1::resource-version)))
               (is-true (slot-value message 'gr8s.node.v1::runtime-deleted))
               (is (equal "Failed" (slot-value message 'gr8s.node.v1::phase)))
               (gr8s::handle-node-agent-envelope server "other-node" (gr8s::make-agent-envelope :status status))
               (is-false (gethash "runtimeDeleted" (gr8s::pod-finalization-state store pod)))
               (setf (slot-value message 'gr8s.node.v1::resource-version) "stale-version")
               (gr8s::handle-node-agent-envelope server "worker-a" (gr8s::make-agent-envelope :status status))
               (is-false (gethash "runtimeDeleted" (gr8s::pod-finalization-state store pod)))
               (setf (slot-value message 'gr8s.node.v1::resource-version) version
                     (slot-value message 'gr8s.node.v1::uid) "stale-uid")
               (gr8s::handle-node-agent-envelope server "worker-a" (gr8s::make-agent-envelope :status status))
               (is-false (gethash "runtimeDeleted" (gr8s::pod-finalization-state store pod)))
               (setf (slot-value message 'gr8s.node.v1::uid) (pod-uid pod))
               (gr8s::handle-node-agent-envelope server "worker-a" (gr8s::make-agent-envelope :status status))
               (is-true (gethash "runtimeDeleted" (gr8s::pod-finalization-state store pod))))
             (let ((actual (reconcile-pod reconciler "default" "hello")))
               (is (equal "Failed" (gethash "phase" actual)))
               (is (= 17 (gethash "exitCode" (gethash "terminated" (gethash "state" (aref (gethash "containerStatuses" actual) 0))))))
               (is-false (nth-value 1 (gethash "runtimeDeleted" actual))))
             (is-true (get-pod (gr8s::node-runtime-store agent) "default" "hello"))
             (let* ((current (get-pod store "default" "hello")) (copy (gr8s::copy-core-object (pod-to-object current))))
               (setf (gethash "finalizers" (gethash "metadata" copy)) #())
               (update-pod store (parse-pod copy) (pod-resource-version current)))
             (reconcile-pod reconciler "default" "hello")
             (signals kubernetes-error (get-pod store "default" "hello"))
             (gr8s::reconcile-node-snapshot agent (grace-snapshot-without-network (gr8s::current-node-snapshot server "worker-a")))
             (signals kubernetes-error (get-pod (gr8s::node-runtime-store agent) "default" "hello"))
             (is (null (slot-value (gr8s::node-runtime-status agent) 'gr8s.node.v1::pods))))
        (gr8s::stop-node-runtime agent)))))

(test typed-pod-metadata-preserves-finalizers-and-rejects-invalid-wire-values
  (let ((metadata (gr8s::core-protobuf-metadata
                   (core-test-protobuf '((1 "wire") (14 "example.com/one") (14 "example.com/two"))))))
    (is (equalp #("example.com/one" "example.com/two") (gethash "finalizers" metadata))))
  (signals error (gr8s::core-protobuf-metadata (core-test-protobuf '((14 1)))))
  (signals kubernetes-error (gr8s::core-protobuf-metadata (core-test-protobuf '((14 "invalid name"))))))

(test typed-pod-force-deletion-and-json-get-to-put-finalizer-removal
  (with-temporary-store (store directory)
    (declare (ignore directory))
    (let* ((runtime (make-fake-runtime)) (reconciler (make-reconciler store runtime))
           (server (start-server :address "127.0.0.1" :port 18089 :store store :runtime runtime :reconciler reconciler))
           (item "/api/v1/namespaces/default/pods/wire-finalizer"))
      (unwind-protect
           (let* ((metadata (core-test-protobuf '((1 "wire-finalizer") (14 "example.com/cleanup"))))
                  (container (core-test-protobuf '((1 "web") (2 "busybox"))))
                  (spec (core-test-protobuf (list (list 2 container) (list 3 "Never") (list 10 "worker-a"))))
                  (created (check-core-status 201 "/api/v1/namespaces/default/pods" :method :post
                             :content-type "application/vnd.kubernetes.protobuf"
                             :octets (core-test-protobuf-envelope "Pod" (list (list 1 metadata) (list 2 spec)))))
                  (uid (gethash "uid" (gethash "metadata" created)))
                  (actual (runtime-observe runtime uid)))
             (is (equalp #("example.com/cleanup") (gethash "finalizers" (gethash "metadata" created))))
             (setf (gr8s::runtime-pod-phase actual) "Failed" (gr8s::runtime-pod-status actual) (test-terminal-pod-status))
             (check-core-status 200 item :method :delete :object (gr8s::core-object "gracePeriodSeconds" 0))
             (let ((retained (check-core-status 200 item)))
               (is (equal uid (gethash "uid" (gethash "metadata" retained))))
               (is (equal "Failed" (gethash "phase" (gethash "status" retained))))
               (is-false (runtime-observe runtime uid))
               ;; Keep the returned nonempty server-owned status in the JSON
               ;; request: metadata-only GET-to-PUT must work without edits.
               (setf (gethash "finalizers" (gethash "metadata" retained)) #())
               (check-core-status 200 item :method :put :object retained))
             (check-core-status 404 item))
        (stop-server server)))))

(test physical-finalizer-cleanup-releases-creation-before-api-retention-and-after-reopen
  (with-temporary-store (control-store path)
    (let* ((held (create-pod control-store (finalized-test-pod)))
           (other (create-pod control-store (node-log-test-pod "other")))
           (runtime (make-fake-runtime))
           (directory (merge-pathnames "retained-agent/" path))
           (node (gr8s::make-node-runtime directory runtime nil)))
      (setf (gr8s::node-runtime-state node) :running)
      (gr8s::put-assigned-pod (gr8s::node-runtime-store node) held)
      (setf (gethash (pod-uid held) (gr8s::fake-runtime-pods runtime))
            (gr8s::make-runtime-pod :uid (pod-uid held) :resource-version (pod-resource-version held)
                                    :phase "Failed" :status (test-terminal-pod-status)))
      (let* ((deleting (mark-pod-deleting control-store (pod-namespace held) (pod-name held) :grace-period 0))
             (snapshot (desired-snapshot-for-test other deleting)))
        ;; Deliberately put the unrelated new Pod first in wire order.
        (is-true (gr8s::receive-node-snapshot-intent node snapshot))
        (is (= 1 (hash-table-count (gr8s::reconciler-urgent-deletions (gr8s::node-runtime-reconciler node)))))
        (let ((statuses (gr8s::reconcile-node-snapshot node snapshot)))
          (is (= 2 (length statuses)))
          (is-true (gr8s:runtime-observe runtime (pod-uid other))))
        (let* ((store (gr8s::node-runtime-store node))
               (retained (get-pod store (pod-namespace held) (pod-name held))))
          (is-true (gr8s::pod-finalizers-present-p retained))
          (is-true (gethash "runtimeDeleted" (gr8s::pod-finalization-state store retained)))
          (is-false (gr8s::pod-runtime-cleanup-pending-p store retained))
          (is (= 0 (hash-table-count (gr8s::reconciler-urgent-deletions (gr8s::node-runtime-reconciler node))))))
        ;; An annotation/resource snapshot while retained must not recreate an
        ;; urgent fence for this already completed physical cleanup.
        (setf (slot-value snapshot 'gr8s.node.v1::revision) 2)
        (is-false (gr8s::receive-node-snapshot-intent node snapshot))
        (let ((reopened (gr8s::make-node-runtime directory runtime nil)))
          (is (= 0 (hash-table-count (gr8s::reconciler-urgent-deletions (gr8s::node-runtime-reconciler reopened)))))
          (gr8s::reconcile-all (gr8s::node-runtime-reconciler reopened))
          (is (= 1 (gr8s::fake-runtime-ensure-count runtime)))
          (is-true (gr8s::pod-finalizers-present-p
                    (get-pod (gr8s::node-runtime-store reopened) (pod-namespace held) (pod-name held)))))))))

(test node-event-wire-and-runtime-deletion-ack-remain-independent
  (with-temporary-store (store directory)
    (let* ((now 4000000000) (gr8s::*event-clock* (lambda () now))
           (pod (event-outbox-pod store))
           (manager (gr8s::make-container-probe-manager :clock (lambda () now))))
      (event-outbox-target manager pod "c0" now)
      (let* ((deleting (mark-pod-deleting store (pod-namespace pod) (pod-name pod) :grace-period 0))
             (runtime (gr8s::make-containerd-runtime :log-root directory)))
        (setf (gr8s::containerd-runtime-probes runtime) manager)
        (gr8s::checkpoint-container-probes runtime deleting manager)
        (let* ((status (test-terminal-pod-status))
               (message (gr8s::pod-observed-status-message deleting status
                                                          (gr8s::runtime-events runtime (pod-uid pod)) t))
               (envelope (gr8s:make-agent-envelope :status (make-instance 'gr8s.node.v1::node-status :pods (list message))))
               (decoded (ag-proto:deserialize-from-bytes 'gr8s.node.v1::agent-envelope (ag-proto:serialize-to-bytes envelope))))
          (gr8s::handle-node-agent-envelope (gr8s::%make-node-grpc-server :store store) "probe-node" decoded)
          (is (= 1 (length (gr8s::list-core-resources store "events" "default"))))
          (let ((finalization (gr8s::pod-finalization-state store deleting)))
            (is-true (gethash "runtimeDeleted" finalization))
            (is (equal "Failed" (gethash "phase" (gethash "status" finalization))))
            (is-false (gethash "gr8sRuntimeEvents" (gethash "status" finalization))))
          (is-false (gethash "gr8sRuntimeEvents" (gr8s::pod-observed-status store deleting)))
          (is-false (gethash "gr8sRuntimeEvents" status)))))))
