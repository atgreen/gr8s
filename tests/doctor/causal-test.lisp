(require :asdf)
(load (merge-pathnames "load.lisp" *load-truename*))
(in-package #:gr8s-diagnose)
(defun cr (kind name &optional (spec (object)) (status (object)))
  (object "apiVersion" "v1" "kind" kind "metadata"
          (object "name" name "namespace" "test" "uid" (concatenate 'string "uid-" name)
                  "resourceVersion" "1" "generation" 1)
          "spec" spec "status" status))
(defun cg (root objects &optional denied)
  (lambda (kind ns name)
    (declare (ignore ns))
    (cond ((member (list kind name) denied :test #'equal) (values nil :unknown))
          ((and (equal kind (field root "kind")) (equal name (field root "metadata" "name")))
           (values root :present))
          ((null name) (values (object "metadata" (object "resourceVersion" "list-1")
                                      "items" (coerce (remove-if-not (lambda (r) (equal kind (field r "kind"))) objects) 'vector)) :present))
          (t (let ((found (find-if (lambda (r) (and (equal kind (field r "kind"))
                                                   (equal name (field r "metadata" "name")))) objects)))
               (values found (if found :present :absent)))))))
(defun codes (report) (map 'list (lambda (f) (gethash "code" f)) (gethash "findings" report)))
(defun causal-check (root objects &optional denied)
  (causal-report root (field root "kind") "test" (cg root objects denied)))
(defun service-fixture ()
  (cr "Service" "web" (object "selector" (object "app" "web")
                              "ports" (vector (object "port" 80 "targetPort" "http")))))
(defun pod-fixture ()
  (let ((pod (cr "Pod" "api" (object "containers" (vector (object "name" "api" "ports"
                         (vector (object "name" "web" "containerPort" 8080)))))
                 (object "phase" "Running" "conditions" (vector (object "type" "Ready" "status" "True"))))))
    (setf (gethash "labels" (gethash "metadata" pod)) (object "app" "web")) pod))
(assert (fboundp 'causal-report))
(assert (member "service-selector-empty" (codes (causal-check (service-fixture) nil)) :test #'equal))
(let ((report (causal-check (service-fixture) (list (pod-fixture)))))
  (assert (member "service-named-port-missing" (codes report) :test #'equal))
  (assert (member "service-no-ready-backends" (codes report) :test #'equal)))
(let ((report (causal-check (service-fixture) nil '(("Pod" nil)))))
  (assert (equal "incomplete" (gethash "status" report)))
  (assert (not (member "service-selector-empty" (codes report) :test #'equal))))
;; WaitForFirstConsumer + a pending claim + consuming Pod with nodeName.
(let* ((claim (cr "PersistentVolumeClaim" "data" (object "storageClassName" "local") (object "phase" "Pending")))
       (class (cr "StorageClass" "local"))
       (pod (cr "Pod" "db" (object "nodeName" "n1" "volumes"
                                  (vector (object "name" "data" "persistentVolumeClaim" (object "claimName" "data")))))))
  (setf (gethash "volumeBindingMode" class) "WaitForFirstConsumer")
  (assert (member "pvc-consumer-bypasses-binding" (codes (causal-check claim (list class pod))) :test #'equal)))
;; HPA Resource utilization requires requests from selected containers.
(let* ((hpa (cr "HorizontalPodAutoscaler" "web" (object "scaleTargetRef" (object "apiVersion" "apps/v1" "kind" "Deployment" "name" "web")
                    "metrics" (vector (object "type" "Resource" "resource"
                      (object "name" "cpu" "target" (object "type" "Utilization" "averageUtilization" 70)))))))
       (deployment (cr "Deployment" "web" (object "selector" (object "matchLabels" (object "app" "web")))))
       (pod (pod-fixture)))
  (setf (gethash "apiVersion" hpa) "autoscaling/v2")
  (assert (member "hpa-missing-resource-request" (codes (causal-check hpa (list deployment pod))) :test #'equal)))
;; A fresh zero-disruption budget selecting a healthy running Pod.
(let* ((pdb (cr "PodDisruptionBudget" "web" (object "selector" (object "matchLabels" (object "app" "web")))
                (object "observedGeneration" 1 "disruptionsAllowed" 0)))
       (pod (pod-fixture)))
  (setf (gethash "apiVersion" pdb) "policy/v1")
  (assert (member "pdb-blocks-healthy-eviction" (codes (causal-check pdb (list pod))) :test #'equal)))
(defun quota-fixture ()
  (let ((deployment (cr "Deployment" "web" (object "replicas" 3) (object "observedGeneration" 1 "availableReplicas" 1)))
        (rs (cr "ReplicaSet" "web-new" (object "replicas" 3)
                (object "observedGeneration" 1 "conditions" (vector (object "type" "ReplicaFailure" "status" "True" "reason" "FailedCreate")))))
        (event (cr "Event" "quota-event"))
        (quota (cr "ResourceQuota" "compute")))
    (setf (gethash "ownerReferences" (gethash "metadata" rs))
          (vector (object "kind" "Deployment" "uid" "uid-web" "controller" t))
          (gethash "type" event) "Warning" (gethash "reason" event) "FailedCreate"
          (gethash "involvedObject" event) (object "uid" "uid-web-new")
          (gethash "lastTimestamp" event) (timestamp)
          (gethash "message" event) "pods is forbidden: exceeded quota: compute, requested: pods=1")
    (values deployment (list rs event quota))))
(multiple-value-bind (deployment objects) (quota-fixture)
  (assert (member "rollout-quota-rejection" (codes (causal-check deployment objects)) :test #'equal)))
(dolist (message '("Forbidden: exceeded quota: compute, requested: pods=1"
                   "Error creating: Forbidden: exceeded quota: compute, requested: pods=1"))
  (multiple-value-bind (deployment objects) (quota-fixture)
    (setf (gethash "message" (second objects)) message)
    (assert (member "rollout-quota-rejection" (codes (causal-check deployment objects)) :test #'equal))))
(dolist (message '("Forbidden: user cannot create Pods"
                   "Forbidden: user cannot create Pods; exceeded quota: compute, requested: pods=1"
                   "Unrelated text Forbidden: exceeded quota: compute, requested: pods=1"))
  (multiple-value-bind (deployment objects) (quota-fixture)
    (setf (gethash "message" (second objects)) message)
    (assert (not (member "rollout-quota-rejection" (codes (causal-check deployment objects)) :test #'equal)))))
;; A ready endpoint in any slice defeats the aggregate no-backend diagnosis.
(defun slice-fixture (name ready)
  (let ((slice (cr "EndpointSlice" name)))
    (setf (gethash "labels" (gethash "metadata" slice)) (object "kubernetes.io/service-name" "web")
          (gethash "endpoints" slice) (vector (object "conditions" (object "ready" ready)))) slice))
(let ((report (causal-check (service-fixture) (list (pod-fixture) (slice-fixture "a" nil) (slice-fixture "b" t)))))
  (assert (not (member "service-no-ready-backends" (codes report) :test #'equal))))
(let ((service (service-fixture)))
  (setf (gethash "targetPort" (aref (field service "spec" "ports") 0)) 8080)
  (assert (not (member "service-named-port-missing" (codes (causal-check service (list (pod-fixture)))) :test #'equal))))
(dolist (mode '("selectorless" "ExternalName"))
  (let ((service (service-fixture)))
    (if (equal mode "selectorless") (remhash "selector" (gethash "spec" service))
        (setf (gethash "type" (gethash "spec" service)) mode))
    (assert (null (codes (causal-check service nil))))))
;; Partial lists must never establish absence, including namespace mismatches.
(dolist (mode '("continued" "wrong-namespace"))
  (let* ((service (service-fixture)) (base (cg service nil))
         (report (causal-report service "Service" "test"
                   (lambda (kind ns name)
                     (if (and (equal kind "Pod") (null name))
                         (let ((pod (pod-fixture)))
                           (setf (gethash "namespace" (gethash "metadata" pod)) "other")
                           (values (if (equal mode "continued")
                                       (object "metadata" (object "continue" "next") "items" #())
                                       (object "items" (vector pod))) :present))
                         (funcall base kind ns name))))))
    (assert (equal "incomplete" (gethash "status" report)))
    (assert (null (codes report)))))
;; Recently replaced Service must not inherit endpoints from its former UID.
(let ((slice (slice-fixture "stale" nil)))
  (setf (gethash "ownerReferences" (gethash "metadata" slice))
        (vector (object "kind" "Service" "uid" "old-service")))
  (let ((report (causal-check (service-fixture) (list (pod-fixture) slice))))
    (assert (equal "incomplete" (gethash "status" report)))
    (assert (not (member "service-no-ready-backends" (codes report) :test #'equal)))))
(multiple-value-bind (deployment objects) (quota-fixture)
  (remhash "availableReplicas" (gethash "status" deployment))
  (assert (member "rollout-quota-rejection" (codes (causal-check deployment objects)) :test #'equal)))
;; Historical, unrelated and recovered quota failures must not become current causes.
(dolist (mode '("old-event" "wrong-uid" "rbac" "recovered" "stale-rs" "stale-deployment" "missing-quota"))
  (multiple-value-bind (deployment objects) (quota-fixture)
    (let ((rs (first objects)) (event (second objects)))
      (cond ((equal mode "old-event") (setf (gethash "lastTimestamp" event) "2020-01-01T00:00:00Z"))
            ((equal mode "wrong-uid") (setf (gethash "involvedObject" event) (object "uid" "old-rs")))
            ((equal mode "rbac") (setf (gethash "message" event) "pods is forbidden: User cannot create resource"))
            ((equal mode "recovered") (setf (gethash "conditions" (gethash "status" rs)) #()))
            ((equal mode "stale-rs") (setf (gethash "observedGeneration" (gethash "status" rs)) 0))
            ((equal mode "stale-deployment") (setf (gethash "observedGeneration" (gethash "status" deployment)) 0))
            ((equal mode "missing-quota") (setf objects (subseq objects 0 2))))
      (assert (not (member "rollout-quota-rejection" (codes (causal-check deployment objects)) :test #'equal))))))
(dolist (mode '("immediate" "unassigned" "selected" "bound"))
  (let ((claim (cr "PersistentVolumeClaim" "data" (object "storageClassName" "local") (object "phase" "Pending")))
        (class (cr "StorageClass" "local"))
        (pod (cr "Pod" "db" (object "nodeName" "n1" "volumes" (vector (object "persistentVolumeClaim" (object "claimName" "data")))))))
    (setf (gethash "volumeBindingMode" class) "WaitForFirstConsumer")
    (cond ((equal mode "immediate") (setf (gethash "volumeBindingMode" class) "Immediate"))
          ((equal mode "unassigned") (remhash "nodeName" (gethash "spec" pod)))
          ((equal mode "selected") (setf (gethash "annotations" (gethash "metadata" claim)) (object "volume.kubernetes.io/selected-node" "n1")))
          ((equal mode "bound") (setf (gethash "phase" (gethash "status" claim)) "Bound")))
    (assert (null (codes (causal-check claim (list class pod)))))))
(dolist (mode '("request" "pod-request" "absolute" "ordinary-init" "sidecar" "dra"))
  (let* ((metric (object "type" "Resource" "resource" (object "name" "cpu" "target" (object "type" "Utilization" "averageUtilization" 70))))
         (hpa (cr "HorizontalPodAutoscaler" "web" (object "scaleTargetRef" (object "apiVersion" "apps/v1" "kind" "Deployment" "name" "web") "metrics" (vector metric))))
         (deployment (cr "Deployment" "web" (object "selector" (object "matchLabels" (object "app" "web")))))
         (pod (pod-fixture)))
    (setf (gethash "resources" (aref (field pod "spec" "containers") 0)) (object "requests" (object "cpu" "100m")))
    (cond ((equal mode "pod-request")
           (remhash "resources" (aref (field pod "spec" "containers") 0))
           (setf (gethash "resources" (gethash "spec" pod)) (object "requests" (object "cpu" "100m"))))
          ((equal mode "absolute") (setf (gethash "type" (field metric "resource" "target")) "AverageValue"))
          ((member mode '("ordinary-init" "sidecar") :test #'equal)
           (setf (gethash "initContainers" (gethash "spec" pod))
                 (vector (if (equal mode "sidecar") (object "name" "init" "restartPolicy" "Always") (object "name" "init")))))
          ((equal mode "dra") (remhash "resources" (aref (field pod "spec" "containers") 0))
           (setf (gethash "extraNodeAllocatableResources" (gethash "status" pod)) (object "cpu" "1"))))
    (let ((report (causal-check hpa (list deployment pod))))
      (assert (eq (not (null (member "hpa-missing-resource-request" (codes report) :test #'equal))) (equal mode "sidecar")))
      (when (equal mode "dra") (assert (equal "incomplete" (gethash "status" report)))))))
(dolist (mode '("stale" "allowed" "unhealthy" "nil-selector" "empty-selector"))
  (let ((pdb (cr "PodDisruptionBudget" "web" (object "selector" (object "matchLabels" (object "app" "web")))
                 (object "observedGeneration" 1 "disruptionsAllowed" 0))) (pod (pod-fixture)))
    (setf (gethash "apiVersion" pdb) "policy/v1")
    (cond ((equal mode "stale") (setf (gethash "observedGeneration" (gethash "status" pdb)) 0))
          ((equal mode "allowed") (setf (gethash "disruptionsAllowed" (gethash "status" pdb)) 1))
          ((equal mode "unhealthy") (setf (gethash "conditions" (gethash "status" pod)) #()
                                         (gethash "unhealthyPodEvictionPolicy" (gethash "spec" pdb)) "AlwaysAllow"))
          ((equal mode "nil-selector") (remhash "selector" (gethash "spec" pdb)))
          ((equal mode "empty-selector") (setf (gethash "selector" (gethash "spec" pdb)) (object))))
    (assert (eq (not (null (member "pdb-blocks-healthy-eviction" (codes (causal-check pdb (list pod))) :test #'equal)))
                (equal mode "empty-selector")))))
;; Integration uses the same facts, preserves evidence references and clears stale root findings.
(let* ((service (service-fixture)) (getter (cg service (list (pod-fixture)))))
  (multiple-value-bind (reports warnings) (diagnose-tree "Service" "web" "test" getter)
    (assert (null warnings))
    (assert (member "service-named-port-missing" (codes (first reports)) :test #'equal))
    (loop for finding across (gethash "findings" (first reports))
          do (loop for id across (gethash "evidence" finding)
                   do (assert (find id (gethash "evidence" (first reports)) :test #'equal :key (lambda (e) (field e "id")))))))
  (let ((report (checkup "test" (lambda (kind ns name)
                                 (if (and (equal kind "Service") (null name)) (values (object "items" (vector service)) :present)
                                     (funcall getter kind ns name))) :kinds '("Service"))))
    (assert (find "service-named-port-missing" (gethash "groups" report) :test #'equal :key (lambda (g) (field g "rule")))))
  (let ((calls 0))
    (multiple-value-bind (reports warnings)
        (diagnose-tree "Service" "web" "test"
          (lambda (kind ns name)
            (if (and (equal kind "Service") name (= (incf calls) 3))
                (let ((replacement (service-fixture)))
                  (setf (gethash "uid" (gethash "metadata" replacement)) "replacement") (values replacement :present))
                (funcall getter kind ns name))))
      (declare (ignore warnings))
      (assert (equal "incomplete" (gethash "status" (first reports))))
      (assert (null (codes (first reports)))))))
;; autoscaling/v1 expresses CPU utilization outside spec.metrics.
(let ((hpa (cr "HorizontalPodAutoscaler" "web"
               (object "scaleTargetRef" (object "apiVersion" "apps/v1" "kind" "Deployment" "name" "web")
                       "targetCPUUtilizationPercentage" 70)))
      (deployment (cr "Deployment" "web" (object "selector" (object "matchLabels" (object "app" "web"))))))
  (setf (gethash "apiVersion" hpa) "autoscaling/v1")
  (assert (member "hpa-missing-resource-request" (codes (causal-check hpa (list deployment (pod-fixture)))) :test #'equal)))
;; Completed Pods can share labels but cannot supply Service endpoints.
(dolist (phase '("Succeeded" "Failed"))
  (let ((completed (pod-fixture)) (running (pod-fixture)))
    (setf (gethash "phase" (gethash "status" completed)) phase
          (gethash "name" (gethash "metadata" completed)) "old-job"
          (gethash "name" (aref (field (aref (field running "spec" "containers") 0) "ports") 0)) "http")
    (let ((report (causal-check (service-fixture) (list completed running (slice-fixture "ready" t)))))
      (assert (not (member "service-named-port-missing" (codes report) :test #'equal))))))

(format t "Seven causal rules: positive, negative, evidence and doctor integration tests passed.~%")

;; Shared namespace observations must not exhaust the request budget.
(dolist (size '(150))
  (let* ((services (loop for i below size collect (let ((s (service-fixture)))
                     (setf (gethash "name" (gethash "metadata" s)) (format nil "s~D" i)
                           (gethash "uid" (gethash "metadata" s)) (format nil "s~D" i)) s)))
         (reads 0) (pod-lists 0)
         (getter (bounded-getter
                   (lambda (kind ns name)
                     (declare (ignore ns)) (incf reads)
                     (cond ((and (equal kind "Service") (null name)) (values (object "items" (coerce services 'vector)) :present))
                           ((equal kind "Service") (values (find name services :test #'equal :key (lambda (s) (field s "metadata" "name"))) :present))
                           ((equal kind "Pod") (incf pod-lists) (values (object "items" (vector (pod-fixture))) :present))
                           (t (values (object "items" #()) :present))))))
         (report (checkup "test" getter :kinds '("Service"))))
    (assert (= 1 pod-lists))
    (assert (= (* 2 size) (length (gethash "groups" report))))
    (assert (equal "findings" (field report "status")))
    (format t "Services=~D calls=~D PodLists=~D findings=~D incomplete=~D status=~A~%" size reads pod-lists
            (length (gethash "groups" report))
            (count "incomplete" (gethash "reports" report) :test #'equal :key (lambda (r) (field r "status")))
            (field report "status"))))
;; Cached LISTs retain their original observation time in each finding's proof.
(let* ((service (service-fixture)) (base (cg service (list (pod-fixture))))
       (getter (reuse-list-observations
                 (lambda (kind ns name)
                   (multiple-value-bind (value state) (funcall base kind ns name)
                     (values value state "2000-01-01T00:00:00Z"))))))
  (dotimes (i 2)
    (let ((report (causal-report service "Service" "test" getter)))
      (assert (find "2000-01-01T00:00:00Z" (gethash "evidence" report) :test #'equal
                    :key (lambda (e) (when (equal "Pod" (field e "kind")) (field e "observedAt"))))))))
;; Scope and memory bounds: named GETs stay fresh and namespaces remain distinct.
(let* ((reads 0)
       (getter (reuse-list-observations
                 (lambda (&rest args) (declare (ignore args)) (incf reads)
                   (values (object "items" #()) :present)) :max-entries 1)))
  (funcall getter "Pod" "a" nil)
  (funcall getter "Pod" "a" nil)
  (assert (= 1 reads))
  (funcall getter "Pod" "b" nil)
  (funcall getter "Pod" "b" nil)
  (assert (= 3 reads))
  (funcall getter "Pod" "a" "named")
  (funcall getter "Pod" "a" "named")
  (assert (= 5 reads)))
(let* ((reads 0)
       (getter (reuse-list-observations
                 (lambda (&rest args) (declare (ignore args)) (incf reads)
                   (values (object "items" (vector (pod-fixture))) :present)) :max-items 0)))
  (dotimes (i 2) (funcall getter "Pod" "test" nil))
  (assert (= 2 reads)))
(format t "Shared LIST scope, bounds, freshness and evidence timestamp checks passed.~%")
;; ContainerResource utilization requires only the named container's request.
(dolist (mode '("missing" "present" "pod-budget" "absent-container" "absolute"))
  (let* ((metric (object "type" "ContainerResource" "containerResource"
                         (object "name" "cpu" "container" "api" "target" (object "type" "Utilization" "averageUtilization" 70))))
         (hpa (cr "HorizontalPodAutoscaler" "web" (object "scaleTargetRef" (object "apiVersion" "apps/v1" "kind" "Deployment" "name" "web")
                                                          "metrics" (vector metric))))
         (deployment (cr "Deployment" "web" (object "selector" (object "matchLabels" (object "app" "web")))))
         (pod (pod-fixture)) (container (aref (field pod "spec" "containers") 0)))
    (setf (gethash "apiVersion" hpa) "autoscaling/v2"
          (gethash "containers" (gethash "spec" pod)) (vector container (object "name" "logging")))
    (cond ((equal mode "present") (setf (gethash "resources" container) (object "requests" (object "cpu" "100m"))))
          ((equal mode "pod-budget") (setf (gethash "resources" (gethash "spec" pod)) (object "requests" (object "cpu" "1"))))
          ((equal mode "absent-container") (setf (gethash "container" (gethash "containerResource" metric)) "old-name"))
          ((equal mode "absolute") (setf (gethash "type" (field metric "containerResource" "target")) "AverageValue")))
    (let ((report (causal-check hpa (list deployment pod))))
      (assert (= (if (member mode '("missing" "pod-budget") :test #'equal) 1 0)
                 (count "hpa-missing-resource-request" (codes report) :test #'equal)))
      (assert (not (search "logging" (com.inuoe.jzon:stringify (gethash "findings" report))))))))

(format t "HPA container utilization: missing/present requests, Pod budget, unrelated sidecar, absent target and absolute-value checks passed.~%")
