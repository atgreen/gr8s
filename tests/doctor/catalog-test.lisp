(require :asdf)
(load (merge-pathnames "load.lisp" *load-truename*))
(in-package #:gr8s-diagnose)
(assert (= 150 (length (catalog-entries))))
;; Every check must hold given its full evidence, and fail with any premise missing.
(dolist (entry (catalog-entries))
  (destructuring-bind (id kind premises summary step) entry
    (declare (ignore summary step))
    (labels ((evidence (premise)
               ;; Observations that satisfy one premise term.
               (let ((path (svref premise 1)))
                 (ecase (intern (symbol-name (svref premise 0)) :keyword)
                   (:has (list (list 'observed "location" path (svref premise 2))))
                   (:below (list (list 'observed "location" path 1)
                                 (list 'observed "location" (svref premise 2) 2)))
                   (:positive (list (list 'observed "location" path 1)))
                   (:at_least (list (list 'observed "location" path (svref premise 2))))
                   (:nonempty (list (list 'observed "location" path (vector 'count 1))))
                   (:empty (list (list 'observed "location" path (vector 'count 0)))))))
             (answers (premises &optional (actual-kind kind))
               (prove (cons (list 'kind actual-kind) (mapcan #'evidence premises))
                      `((finding ,id ?location ? ?)) '?location)))
      (assert (equal '("location") (answers premises)))
      (assert (null (answers premises "UnrelatedKind")))
      (loop for i below (length premises)
            do (assert (null (answers (loop for p in premises for j from 0 unless (= i j) collect p))))))))
;; A counter that was not observed is unknown, and an equal one is not below.
(flet ((deficit (ready wanted)
         (prove (append '((kind "Deployment"))
                        (when ready `((observed "object" "status.readyReplicas" ,ready)))
                        (when wanted `((observed "object" "spec.replicas" ,wanted))))
                '((finding "deployment-ready-deficit" ?location ? ?)) '?location)))
  (assert (deficit 1 3))
  (assert (null (deficit 3 3)))
  (assert (null (deficit nil 3)))
  (assert (null (deficit 1 nil))))
(assert (equal '("c") (prove '((kind "Pod") (observed "c" "container.restartCount" 5))
                             '((finding "container-restarts-five" ?location ? ?)) '?location)))
(assert (null (prove '((kind "Pod") (observed "c" "container.restartCount" 4))
                     '((finding "container-restarts-five" ?location ? ?)) '?location)))
;; Facts last for one question only.
(assert (null (prove nil '((observed ?location ?path ?value)) '?path)))
(assert (null (prove nil '((kind ?kind)) '?kind)))
;; Exercise API JSON -> facts -> rules -> English, including container isolation.
(let ((target (com.inuoe.jzon:parse
 "{\"kind\":\"Pod\",\"metadata\":{\"name\":\"web\"},\"status\":{\"containerStatuses\":[{\"name\":\"api\",\"state\":{\"waiting\":{\"reason\":\"CrashLoopBackOff\"}}}]}}")))
  (let ((findings (catalog-findings target "Pod" "e1")))
    (assert (find "waiting-CrashLoopBackOff" findings :test #'equal :key (lambda (f) (gethash "code" f))))))
(assert (null (catalog-findings (object "kind" "Pod") "Pod" "e1")))
(assert (null (catalog-findings (object "kind" "Event" "reason" "FailedMount" "type" "Normal") "Event" "e1")))
(format t "150 catalog rules: positive, missing-premise, wrong-kind and collector checks passed.~%")
;; Exercise every catalog premise through its actual API field projection.
(defun fixture-for-rule (kind premises)
  (let ((resource (object "kind" kind "metadata" (object "name" "fixture")))
        (conditions (make-hash-table :test #'equal))
        (container (object "name" "api" "state" (object))))
    (labels ((put-path (path value)
               (let ((cursor resource))
                 (dolist (part (butlast path))
                   (setf cursor (or (gethash part cursor)
                                    (setf (gethash part cursor) (object)))))
                 (setf (gethash (car (last path)) cursor) value))))
      (dolist (premise premises)
        (let* ((operator (intern (symbol-name (svref premise 0)) :keyword))
               (path (svref premise 1))
               ;; The rule file writes JSON booleans as the atoms true and false.
               (value (and (eq operator :has) (case (svref premise 2) (true t) (false :false) (t (svref premise 2))))))
          (cond
            ((eq operator :below)
             (put-path (uiop:split-string path :separator ".") 1)
             (put-path (uiop:split-string (svref premise 2) :separator ".") 2))
            ((equal path "container.restartCount")
             (put-path '("status" "containerStatuses")
                       (vector (object "name" "api" "restartCount" (if (eq operator :at_least) (svref premise 2) 1)))))
            ((eq operator :positive) (put-path (uiop:split-string path :separator ".") 1))
            ((eq operator :empty) (put-path (uiop:split-string path :separator ".") #()))
            ((eq operator :nonempty)
             (put-path (uiop:split-string path :separator ".") (vector (object "name" "gate"))))
            ((equal path "derived.all-endpoints-unready")
             (put-path '("endpoints") (vector (object "conditions" (object "ready" nil)))))
            ((equal path "derived.deleting-with-finalizers")
             (put-path '("metadata" "deletionTimestamp") "2026-01-01T00:00:00Z")
             (put-path '("metadata" "finalizers") #("example/finalizer")))
            ((equal path "derived.current-container-error")
             (put-path '("status" "containerStatuses")
                       (vector (object "name" "api" "state" (object "terminated" (object "reason" "Error"))))))
            ((or (uiop:string-prefix-p "container.securityContext." path) (equal path "container.imagePullPolicy"))
             (let ((config (if (equal path "container.imagePullPolicy")
                               (object "name" "api" "imagePullPolicy" value)
                               (object "name" "api" "securityContext"
                                       (object (subseq path 26) (if (eq value :false) nil value))))))
               (put-path '("spec" "containers") (vector config))))
            ((or (uiop:string-prefix-p "condition." path)
                 (uiop:string-prefix-p "condition-reason." path))
             (let* ((reason (uiop:string-prefix-p "condition-reason." path))
                    (type (subseq path (if reason 17 10)))
                    (condition (or (gethash type conditions)
                                   (setf (gethash type conditions) (object "type" type)))))
               (setf (gethash (if reason "reason" "status") condition) value)))
            ((uiop:string-prefix-p "container." path)
             (destructuring-bind (prefix state property) (uiop:split-string path :separator ".")
               (declare (ignore prefix))
               (let* ((previous (equal state "last-terminated"))
                      (slot (if previous "lastState" "state"))
                      (states (or (gethash slot container)
                                  (setf (gethash slot container) (object)))))
                 (when previous (setf state "terminated"))
                 (unless (gethash state states) (setf (gethash state states) (object)))
                 (setf (gethash property (gethash state states)) value)))
             (put-path '("status" "containerStatuses") (vector container)))
            ((equal path "taint.key")
             (put-path '("spec" "taints") (vector (object "key" value "effect" "NoSchedule"))))
            (t (put-path (uiop:split-string path :separator ".") value)))))
      (when (plusp (hash-table-count conditions))
        (put-path '("status" "conditions")
                  (coerce (loop for c being the hash-values of conditions collect c) 'vector))))
    resource))
(dolist (entry (catalog-entries))
  (destructuring-bind (id kind premises &rest rest) entry
    (declare (ignore rest))
    (let* ((fixture (fixture-for-rule kind premises))
           (roundtrip (com.inuoe.jzon:parse (com.inuoe.jzon:stringify fixture)))
           (findings (catalog-findings roundtrip kind "e42")))
      (assert (find id findings :test #'equal :key (lambda (f) (gethash "code" f))))
      (dolist (finding findings) (assert (equalp #("e42") (gethash "evidence" finding)))))))
(assert (= 150 (length (remove-duplicates (mapcar #'first (catalog-entries)) :test #'equal))))
(format t "All 150 rules also passed JSON-to-English collector fixtures.~%")
;; A response from another namespace must not be attributed to our target.
(assert (handler-case
            (progn (diagnose-resource "Deployment" "web" "prod"
                     (lambda (&rest ignored)
                       (declare (ignore ignored))
                       (values (object "metadata" (object "name" "web" "namespace" "other" "uid" "u")) :present))) nil)
          (error () t)))
(let* ((resource (com.inuoe.jzon:parse "{\"metadata\":{\"name\":\"web\"},\"status\":{\"initContainerStatuses\":[{\"name\":\"init\",\"lastState\":{\"terminated\":{\"reason\":\"OOMKilled\"}}}]}}"))
       (findings (catalog-findings resource "Pod" "e1")))
  (assert (find "previous-OOMKilled" findings :test #'equal :key (lambda (f) (gethash "code" f)))))
(let ((resource (com.inuoe.jzon:parse "{\"metadata\":{\"name\":\"web\",\"namespace\":\"prod\",\"uid\":\"u1\",\"resourceVersion\":\"1\"},\"status\":{\"conditions\":[{\"type\":\"Available\",\"status\":\"False\"}]}}")))
  (let ((report (diagnose-resource "Deployment" "web" "prod"
                  (lambda (&rest args) (declare (ignore args)) (values resource :present)))))
    (assert (equal "Deployment/prod/web" (gethash "target" report)))
    (assert (equal "findings" (gethash "status" report)))))
(dolist (state '(:unknown :absent))
  (let ((report (diagnose-resource "Node" "node1" "default"
                  (lambda (&rest args) (declare (ignore args)) (values nil state)))))
    (assert (equal "incomplete" (gethash "status" report)))
    (assert (zerop (length (gethash "findings" report))))))
(let ((count 0))
  (let ((report (diagnose-resource "Node" "node1" "default"
                  (lambda (&rest args)
                    (declare (ignore args))
                    (values (object "metadata" (object "name" "node1" "uid" "u1"
                                                       "resourceVersion" (incf count))
                                    "spec" (object "unschedulable" t)) :present)))))
    (assert (equal "incomplete" (gethash "status" report)))
    (assert (zerop (length (gethash "findings" report))))))
;; Both init and ephemeral statuses use distinct locations and retain evidence.
(loop for (section words) in '(("initContainerStatuses" "Init container \"worker\" in Pod web")
                               ("ephemeralContainerStatuses" "Ephemeral container \"worker\" in Pod web"))
      do
  (let* ((resource (object "metadata" (object "name" "web")
                           "status" (object section (vector (object "name" "worker" "state"
                             (object "waiting" (object "reason" "CrashLoopBackOff")))))))
         (findings (catalog-findings resource "Pod" "e1")))
    (assert (= 1 (length findings)))
    (assert (search words (gethash "summary" (first findings))))))
(format t "Namespace, unknown/replaced resources, init and ephemeral integrations passed.~%")
