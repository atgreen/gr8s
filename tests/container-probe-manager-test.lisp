        (gr8s::stop-container-probes runtime)))))

(test real-http-body-errors-retry-without-killing-a-healthy-attempt
  (with-temporary-store (store directory)
    (let* ((now (get-universal-time)) (pod (lifecycle-pod store))
           (runtime (gr8s::make-containerd-runtime :log-root directory))
           (manager (gr8s::make-container-probe-manager :clock (lambda () now))) (requests 0))
      (setf (gr8s::containerd-runtime-probes runtime) manager)
      (unwind-protect
           (call-with-probe-raw-server
            (lambda (port)
              (setf (gethash "livenessProbe" (probe-test-side-container pod))
                    (checked-probe (format nil "{\"httpGet\":{\"port\":~D},\"failureThreshold\":1}" port) "livenessProbe"))
              (with-lifecycle-cri (fixture pod (list (lifecycle-info "main" 0 gr8s.cri.v1::+containerstate-container_running+ now)
                                                   (lifecycle-info "side" 0 gr8s.cri.v1::+containerstate-container_running+ now)))
                (let ((observed (runtime-observe runtime (pod-uid pod))))
                  ;; The controlled CRI fixture has no network assignment;
                  ;; use the real loopback endpoint for its actual HTTP check.
                  (setf (gr8s::runtime-pod-pod-ip observed) "127.0.0.1")
                  (gr8s::sync-container-probe-targets runtime pod observed :start-workers nil)
                  (let* ((target (probe-test-target manager pod)) (worker (probe-test-worker target "livenessProbe")))
                    (gr8s::step-container-probe manager runtime target worker)
                    (is (= 3 requests))
                    (is (= 0 (gr8s::container-probe-worker-count worker)))
                    (is-true (gr8s::container-probe-worker-result worker))
                    (is-false (gr8s::container-probe-worker-failed-p worker))
                    (let ((event (gethash "Unhealthy" (gr8s::container-probe-worker-events worker))))
                      (is (= 1 (gethash "count" event)))
                      (is (search "probe errored and resulted in Failure state" (gethash "message" event))))
                    (let ((state (gr8s::checkpoint-container-probes runtime pod manager)))
                      (is-false (gethash "probeRestart" (gethash "side" (gethash "containers" state)))))))))
            (lambda (stream)
              (probe-request-lines stream) (incf requests)
              (write-probe-http-response stream 200 '(("Content-Length" . "5")) "no")))
        (gr8s::stop-container-probes runtime)))))

;; podster-uqb.114: stopping a probe interrupted its thread with an ERROR, which finds
;; no handler if the thread is already signalling another error.
(test stopping-a-probe-during-a-signal-still-unwinds-it
  (let* ((owner (list :probe))
         (signalling (bt:make-semaphore))
         (cleaned-up nil)
         (thread (bt:make-thread
                  (lambda ()
                    (gr8s::with-container-probe-stop (owner)
                      (unwind-protect
                           (handler-bind ((error (lambda (condition)
                                                   (declare (ignore condition))
                                                   (bt:signal-semaphore signalling)
                                                   (sleep 3600))))
                             (error "probe failed"))
                        (setf cleaned-up t)))
                    :stopped)
                  :name "gr8s stopped probe test")))
    (is-true (bt:wait-on-semaphore signalling :timeout 10))
    (gr8s::stop-container-probe-thread thread owner)
    (is (eq :stopped (bt:join-thread thread)))
    (is-true cleaned-up)))

(test stopping-a-probe-stop-job-passes-handlers-that-recover-from-errors
  (let* ((runtime (gr8s::make-containerd-runtime)) (manager (gr8s::make-container-probe-manager))
         (job (gr8s::make-container-probe-stop-job :uid "actual-uid" :id "actual-id" :deadline 0))
         (blocked (bt:make-semaphore)) (swallowed nil) (thread nil)
         (original (symbol-function 'gr8s::cri-stop-container)))
    (unwind-protect
         (progn
           (setf (symbol-function 'gr8s::cri-stop-container)
                 (lambda (&rest args)
                   (declare (ignore args))
                   (handler-case (progn (bt:signal-semaphore blocked) (sleep 3600))
                     (serious-condition () (setf swallowed t)))))
           (setf thread (bt:make-thread (lambda () (gr8s::run-container-probe-stop runtime manager job))))
           (is-true (bt:wait-on-semaphore blocked :timeout 10))
           (gr8s::stop-container-probe-thread thread job)
           (bt:join-thread thread)
           (is-false swallowed)
           (is-true (gr8s::container-probe-stop-job-finished-p job))
           (is (null (gr8s::container-probe-stop-job-failure job))))
      (setf (symbol-function 'gr8s::cri-stop-container) original))))

(test a-late-probe-stop-is-ignored
  (let* ((owner (list :probe))
         (left (bt:make-semaphore))
         (received (bt:make-semaphore))
         (thread (bt:make-thread
                  (lambda ()
                    (gr8s::with-container-probe-stop (owner) nil)
                    (bt:signal-semaphore left)
                    (bt:wait-on-semaphore received)
                    :finished))))
    (bt:wait-on-semaphore left)
    (gr8s::stop-container-probe-thread thread owner)
    (bt:signal-semaphore received)
    (is (eq :finished (bt:join-thread thread)))))

(test a-terminating-pod-keeps-probing-readiness-but-not-liveness
  (with-temporary-store (store directory)
    (let* ((now 4000000000) (pod (lifecycle-pod store)) (runtime (gr8s::make-containerd-runtime :log-root directory))
           (ready t) (live t) (calls nil)
           (manager (gr8s::make-container-probe-manager :clock (lambda () now)
                     :executor (lambda (runtime container id ip probe)
                                 (declare (ignore runtime container id ip))
                                 (let ((name (aref (gethash "command" (gethash "exec" probe)) 0)))
                                   (push name calls)
                                   (values (if (equal name "ready") ready live) "actual result"))))))
      (setf (gr8s::containerd-runtime-probes runtime) manager)
      (dolist (pair '(("readinessProbe" . "ready") ("livenessProbe" . "live")))
        (setf (gethash (car pair) (probe-test-side-container pod))
              (checked-probe (format nil "{\"exec\":{\"command\":[\"~A\"]},\"periodSeconds\":1,\"failureThreshold\":1}" (cdr pair))
                             (car pair))))
      (with-lifecycle-cri (fixture pod (list (lifecycle-info "main" 0 gr8s.cri.v1::+containerstate-container_running+ now)
                                           (lifecycle-info "side" 0 gr8s.cri.v1::+containerstate-container_running+ now)))
        (let ((observed (runtime-observe runtime (pod-uid pod))))
          (gr8s::sync-container-probe-targets runtime pod observed :start-workers nil)
          (let* ((target (probe-test-target manager pod))
                 (readiness (probe-test-worker target "readinessProbe"))
                 (liveness (probe-test-worker target "livenessProbe")))
            (gr8s::step-container-probe manager runtime target readiness)
            (gr8s::step-container-probe manager runtime target liveness)
            (is-true (gethash "ready" (lifecycle-side-status (gr8s::apply-container-probe-observation runtime observed))))
            ;; Deletion begins: the container drops out of service and would also fail liveness.
            (gr8s::begin-terminating-container-probes runtime (pod-uid pod))
            (setf ready nil live nil calls nil)
            (incf now)
            (gr8s::step-container-probe manager runtime target readiness)
            (gr8s::step-container-probe manager runtime target liveness)
            (is (equal '("ready") calls))
            (is-false (gethash "ready" (lifecycle-side-status (gr8s::apply-container-probe-observation runtime observed))))
            (is-false (gr8s::container-probe-worker-failed-p liveness))
            ;; No restart is requested for a container that is shutting down.
            (is (notany #'third (gr8s::snapshot-container-probes manager (pod-uid pod))))))))))
