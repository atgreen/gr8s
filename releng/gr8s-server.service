[Unit]
Description=gr8s Kubernetes server
Wants=network-online.target gr8s-kms.service
After=network-online.target gr8s-kms.service
# A deterministic startup failure lands in `systemctl --failed` instead of
# restarting forever.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
# The binary tells systemd when the API is actually serving, so active
# means serving, not merely executed.
Type=notify
EnvironmentFile=/etc/gr8s/server.env
ExecStart=/usr/bin/gr8s $GR8S_EXEC_ARGS
Restart=always
RestartSec=5s
KillMode=process
# KillMode=process + Delegate: like k3s, stopping the service kills only the
# gr8s process. Managed containerd and the container shims (which live in this
# unit's cgroup) survive, the restarted gr8s reconnects and re-adopts them, and
# workloads run through control-plane restarts and upgrades (podster-1yx).
# gr8s-killall.sh remains the way to stop workloads too.
Delegate=yes
# An explicit start deadline, not the host's DefaultTimeoutStartSec (45-90s),
# so behaviour is the same everywhere. An HA member recovering committed
# application state waits past this and extends it live via sd_notify
# EXTEND_TIMEOUT_USEC, so a slow recovery is never mistaken for a hung start
# and restart-looped (podster-lmm).
TimeoutStartSec=120s
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
