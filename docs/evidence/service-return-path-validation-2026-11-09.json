{
  "date": "2026-11-09",
  "issue": "podster-p9c.10",
  "implementationCommit": "b5feadc",
  "scope": "Actual routed CNI private IPv4 lease allocation and owned host return route/neighbor lifecycle. No packet source NAT or alias policy normalization is activated.",
  "behavior": "Packet-enabled IPv4 ADD reserves the auxiliary lease, installs normal primary link and policy, then publishes permanent peer-MAC neighbor and exclusive /32 return route. Alias is absent from Pod-namespace addresses, CNI result IPs and primary source-validation identity. CHECK verifies retained state; DEL removes owned link before jointly releasing primary/private leases. Exact retained routes can be adopted, conflicting routes cannot be overwritten.",
  "compatibility": "Ordinary and IPv6-only ADD do not allocate auxiliary addresses. Existing private leases keep handling if new allocation is disabled. CHECK does not allocate leases on older endpoints. Each participating endpoint consumes one additional IPv4 pool address.",
  "focused": {
    "passed": 695,
    "failed": 0,
    "logSHA256": "93d00d2996facabef8cf6678ccbfc3ab4ebf8cf90e7a074ac70db6230139f46d"
  },
  "broaderNetworking": {
    "passed": 1534,
    "failed": 0,
    "logSHA256": "6c4330edd75be26616ef9d8c615c339714db07d4c93cac34ca3e26d7e7738967"
  },
  "unitCoverage": "IPAM, CNI, rtnetlink, trusted identity and Pod-pool suites plus all Service/networking/policy/egress-guard checks. New cases cover both-link ownership and malformed MAC refusal, neighbor-before-route publication, exclusive route conflict and concurrent exact-route adoption, missing-neighbor CHECK, primary/dual-stack CNI address separation, partial policy/return-route failures, failed teardown retaining both leases, default/IPv6-only/retained-lease behavior.",
  "native": {
    "version": "gr8s 1.37.2-gb5feadc, patch level 0",
    "sha256": "b8aa589bcb76085f73daaf86d7b6741bc3ca3cbde13c92f66f9e67e9affdf187",
