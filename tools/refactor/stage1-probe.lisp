;;;; Stage-1 probe: list every symbol CURRENTLY homed in GR8S (the "needs-home"
;;;; set) grouped by its final owner package, so Stage 1 can re-home the 28
;;;; (in-package #:gr8s) files and declare the moved symbols early.
;;;;
;;;; Reads tools/refactor/gr8s-final-owners.tsv for NAME -> OWNER, then walks the
;;;; live GR8S package and keeps only symbols whose SYMBOL-PACKAGE is GR8S.
;;;; Emits tools/refactor/gen/stage1-rehome.sexp:
;;;;   ((:owner "GR8S.FOUNDATION" :names ("+GR8S-VERSION+" ...)) ...)
;;;; and prints a per-owner count plus which names are in the facade :export set.

(require :asdf)
(asdf:load-system "gr8s")

(defun slurp-tsv (path)
  (let ((h (make-hash-table :test 'equal)))
    (with-open-file (s path :direction :input)
      (loop for line = (read-line s nil :eof)
            until (eq line :eof)
            for tab = (position #\Tab line)
            when tab
            do (setf (gethash (subseq line 0 tab) h)
                     (subseq line (1+ tab)))))
    h))

(let* ((root "tools/refactor/")
       (owners (slurp-tsv (merge-pathnames "gr8s-final-owners.tsv" root)))
       (g (find-package '#:gr8s))
       (by-owner (make-hash-table :test 'equal))
       (missing '())
       (self-owned '()))
  (do-symbols (sym g)
    (when (eq (symbol-package sym) g)
      (let* ((name (symbol-name sym))
             (owner (gethash name owners)))
        (cond ((null owner) (push name missing))
              ((string= owner "GR8S") (push name self-owned))
              (t (push name (gethash owner by-owner)))))))
  ;; Emit grouped data file.
  (ensure-directories-exist (merge-pathnames "gen/" root))
  (with-open-file (out (merge-pathnames "gen/stage1-rehome.sexp" root)
                       :direction :output :if-exists :supersede
                       :if-does-not-exist :create)
    (let ((*print-case* :upcase))
      (format out ";;;; Generated by stage1-probe.lisp. Symbols currently homed~%")
      (format out ";;;; in GR8S, grouped by final owner package.~%(")
      (let ((owner-keys (sort (loop for k being the hash-keys of by-owner collect k)
                              #'string<)))
        (dolist (k owner-keys)
          (format out "~% (:owner ~S :names~%  (" k)
          (dolist (n (sort (copy-list (gethash k by-owner)) #'string<))
            (format out "~S " n))
          (format out "))")))
      (format out ")~%")))
  ;; Report.
  (format t "~%=== STAGE1 RE-HOME SUMMARY ===~%")
  (let ((total 0))
    (dolist (k (sort (loop for key being the hash-keys of by-owner collect key) #'string<))
      (let ((n (length (gethash k by-owner))))
        (incf total n)
        (format t "~4D  ~A~%" n k)))
    (format t "----  TOTAL ~D~%" total))
  (format t "still-GR8S (owner=GR8S in tsv): ~D~@[ ~S~]~%"
          (length self-owned) (and self-owned (subseq self-owned 0 (min 20 (length self-owned)))))
  (format t "missing-from-tsv: ~D~@[ ~S~]~%"
          (length missing) (and missing (subseq missing 0 (min 30 (length missing)))))
  (format t "STAGE1-PROBE-DONE~%"))
