# The page demo.gr8s.io's visitors' tabs serve (docs/design-browser-nodes.md): static
# files, served by nginx from Project Hummingbird's minimal, hardened image (the same
# build Red Hat ships as registry.access.redhat.com/hi/nginx), so the server can check
# every response against what this image holds and fill in what it vouches for through
# <!--gr8s:...--> placeholders. Build for arm64, which browser nodes run; nothing here
# runs at build time, so no emulation is needed:
#   podman build --platform linux/arm64 -t IMAGE examples/browser-demo
FROM quay.io/hummingbird/nginx:latest
COPY nginx.conf /etc/nginx/nginx.conf
COPY www/ /usr/share/nginx/html/
