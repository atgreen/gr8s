(in-package #:gr8s.patch)
(defstruct domain name symbols (active 0) (closed nil)
  (lock (bt:make-lock "patch domain")) (changed (bt:make-condition-variable)))
(defun register-domain (name symbols)
  (let ((existing (gethash name *domains*)))
    (when (and existing (or (domain-closed existing) (plusp (domain-active existing))))
      (error "Cannot replace an active patch domain"))
    (setf (gethash name *domains*) (make-domain :name name :symbols symbols))))
(defun call-in-domain (name function)
  (let ((domain (or (gethash name *domains*) (error "Unknown patch domain ~A" name))))
    (bt:with-lock-held ((domain-lock domain))
      (loop while (domain-closed domain) do
        (bt:condition-wait (domain-changed domain) (domain-lock domain) :timeout 0.1))
      (incf (domain-active domain)))
    (unwind-protect (funcall function)
      (bt:with-lock-held ((domain-lock domain))
        (decf (domain-active domain)) (bt:condition-notify (domain-changed domain))))))
(defun close-domain (domain timeout)
  (let ((deadline (+ (get-internal-real-time) (* timeout internal-time-units-per-second))))
    (bt:with-lock-held ((domain-lock domain))
      (setf (domain-closed domain) t)
      (loop while (plusp (domain-active domain)) do
        (when (>= (get-internal-real-time) deadline) (error "Patch domain ~A did not quiesce" (domain-name domain)))
        (bt:condition-wait (domain-changed domain) (domain-lock domain) :timeout 0.05)))))
(defun reopen-domain (domain)
  (bt:with-lock-held ((domain-lock domain))
    (setf (domain-closed domain) nil)
    (bt:condition-notify (domain-changed domain))))
(defun register-patch (&key migrate verify reenter)
  "Called by a verified patch ASDF system. Hooks receive a manager context."
  (unless *loading-level* (error "Patch registration outside its declared load"))
  (unless verify (error "A live patch requires a health check"))
  (setf (gethash *loading-level* *patch-definitions*) (list :migrate migrate :verify verify :reenter reenter)))
(defun checkpoint (name function)
  "Run a resumable migration step. FUNCTION must inspect/idempotently repeat its effects."
  (unless *migration-context* (error "Checkpoint outside patch migration"))
  (destructuring-bind (manager patch-id) *migration-context*
    (let* ((key (format nil "~A/~A" patch-id name))
           (checkpoints (gethash "checkpoints" (manager-state manager))))
      (unless (gethash key checkpoints)
        (funcall function)
        (setf (gethash key checkpoints) t)
        (save-state manager)))))
(defun applicable-level-p (manager level)
  (let ((roles (gethash "roles" level)))
    (and (vectorp roles)
         (some (lambda (role) (member role (manager-roles manager) :test #'equal)) roles))))
(defun level-domains (manager level)
  "Resolve optional quiescence barriers. REPLACES is descriptive, not an allowlist."
  (when (applicable-level-p manager level)
    (let ((names (gethash "domains" level #())))
      (sort (remove-duplicates
             (map 'list (lambda (name)
                          (or (gethash name *domains*)
                              (error "Unsupported live patch domain ~A" name))) names))
            #'string< :key #'domain-name))))
(defun validate-prefix (manager artifact target)
  (let* ((state (manager-state manager))
         (current (gethash "level" state))
         (levels (gethash "levels" (gethash "index" artifact))))
    (unless (and (integerp target) (<= current target (length levels)))
      (error "Patch target must extend installed level ~D within artifact history" current))
    (when (and (plusp current) (not (equal (gethash "chain" state) (gethash "chain" (aref levels (1- current))))))
      (error "Patch artifact rewrites the installed prefix"))
    (loop for index from current below target do (level-domains manager (aref levels index)))
    t))
(defun materialize-level (manager artifact level)
  (let* ((directory (path manager (format nil "source/~A/~D/" (subseq (gethash "digest" artifact) 7)
                                         (gethash "level" level)))))
    (loop for file across (gethash "files" level) do
      (durable-bytes (merge-pathnames (gethash "path" file) directory)
                     (cached-blob manager (gethash "digest" file)))) directory))
(defun load-level (manager artifact level)
  (let* ((directory (materialize-level manager artifact level))
         (name (gethash "system" level))
         (*loading-level* (gethash "chain" level))
         (provided (asdf:already-loaded-systems)))
    (unless (and (stringp name) (uiop:string-prefix-p "gr8s-patch-" name)
                 (equal (gethash "systemFile" level) (concatenate 'string name ".asd")))
      (error "Patch system must have a unique gr8s-patch- name and matching .asd"))
    ;; ASDF is the loader; its current-image cache is never our durable ledger.
    (remhash *loading-level* *patch-definitions*)
    ;; A development server or the test runner may itself be inside ASDF/OPERATE.
    ;; Patch compilation has its own forcing policy and must not inherit that session.
    (let ((asdf/session:*asdf-session* nil)
          (asdf:*central-registry* (list directory)))
      (asdf:load-asd (merge-pathnames (gethash "systemFile" level) directory))
      (let ((system (asdf:find-system name)))
        (dolist (dependency (asdf:system-depends-on system))
          (unless (and (stringp dependency) (member dependency provided :test #'equal))
            (error "Patch requests a non-embedded dependency ~S" dependency)))
        (let ((asdf/output-translations::*output-translations* nil)
              (asdf:*output-translations-parameter*
                `(:output-translations (t ,(path manager (format nil "fasl/~A/" (subseq (gethash "chain" level) 7)))) :ignore-inherited-configuration)))
          (asdf:load-system name :force t :force-not (remove name provided :test #'equal)))))
    (or (gethash *loading-level* *patch-definitions*) (error "Patch did not register its lifecycle"))))
(defun apply-level (manager hash number attempt boot &key replay)
  (bt:with-recursive-lock-held ((manager-lock manager))
    (unless (equal boot (manager-boot-id manager)) (error "Stale patch grant: process restarted"))
    (let* ((state (manager-state manager)) (attempts (gethash "attempts" state))
           (old (gethash attempt attempts))
           (artifact (cached-artifact manager hash))
           (level (aref (gethash "levels" (gethash "index" artifact)) (1- number)))
           (current (gethash "level" state))
           (domains (level-domains manager level))
           (mutating nil) (success nil))
      (when (and old (or (not (equal hash (gethash "artifact" old)))
                         (not (eql number (gethash "level" old)))))
        (error "Patch attempt ID reused for another artifact or level"))
      (when (and (not replay) old (equal "healthy" (gethash "state" old)))
        (return-from apply-level (inventory manager)))
      (unless (or replay (and (not (manager-tainted manager)) (= number (1+ current))))
        (error "Patch grant is not the next level, or process is tainted"))
      (unless replay (validate-prefix manager artifact number))
      (unless replay
        (setf (gethash "pending" state) (object "artifact" hash "level" number "attempt" attempt)
              (gethash attempt attempts) (object "artifact" hash "level" number "state" "applying"))
        (record-event manager "quiescing" "level" number "attempt" attempt))
      (handler-case
          (unwind-protect
               (progn
                 (dolist (domain domains) (close-domain domain 30))
                 (when (applicable-level-p manager level)
                   (setf mutating t)
                   (record-event manager "reloading" "level" number)
                   (let* ((hooks (load-level manager artifact level))
                          (*migration-context* (list manager (gethash "chain" level))))
                     (when (getf hooks :migrate) (funcall (getf hooks :migrate) manager))
                     (when (getf hooks :reenter) (funcall (getf hooks :reenter) manager))
                     (unless (funcall (getf hooks :verify) manager) (error "Patch health check failed"))
                     (setf (manager-health-check manager) (getf hooks :verify))))
                 (setf (manager-loaded-level manager) number)
                 (unless replay
                   (setf (gethash "level" state) number
                         (gethash "chain" state) (gethash "chain" level)
                         (gethash attempt attempts) (object "artifact" hash "level" number "state" "healthy")
                         (gethash "accepted" state)
                         (concatenate 'vector (gethash "accepted" state)
                                      (vector (object "artifact" hash "level" number
                                                      "chain" (gethash "chain" level) "attempt" attempt))))
                   (remhash "pending" state)
                   (record-event manager "installed" "level" number "attempt" attempt))
                 (setf success t))
            (when (or success (not mutating)) (dolist (domain domains) (reopen-domain domain))))
        (error (condition)
          (setf (manager-tainted manager) mutating
                (gethash "error" state) (princ-to-string condition))
          (record-event manager (if mutating "tainted" "blocked") "level" number
                        "message" (princ-to-string condition))
          (error condition)))
      (inventory manager))))
(defun recover-manager (manager)
  (let* ((state (manager-state manager)) (accepted (copy-seq (gethash "accepted" state)))
         (pending (gethash "pending" state)))
    (when (>= (gethash "recoveryAttempts" state 0) 3)
      (error "Patch recovery failed repeatedly; inspect journal and repair before restarting"))
    (when (or (plusp (length accepted)) pending (gethash "bootstrapTarget" state))
      (incf (gethash "recoveryAttempts" state 0)) (save-state manager))
    ;; Replay definitions even though migration checkpoints survive. Incremental
    ;; verification sees the corresponding incremental code, not the final generation.
    (loop for entry across accepted do
      (apply-level manager (gethash "artifact" entry) (gethash "level" entry)
                   (gethash "attempt" entry) (manager-boot-id manager) :replay t))
    (when pending
      (apply-level manager (gethash "artifact" pending) (gethash "level" pending)
                   (gethash "attempt" pending) (manager-boot-id manager)))
    (let ((target (gethash "bootstrapTarget" state)))
      (when (hash-table-p target)
        (let ((artifact (cached-artifact manager (gethash "digest" target))))
          (validate-prefix manager artifact (gethash "level" target))
          (loop for number from (1+ (gethash "level" state)) to (gethash "level" target) do
            (apply-level manager (gethash "digest" target) number
                         (format nil "bootstrap-~A-~D" (gethash "digest" target) number)
                         (manager-boot-id manager))))
        (remhash "bootstrapTarget" state)))
    (setf (gethash "recoveryAttempts" state) 0) (save-state manager)
    manager))
(defun handle-command (manager command)
  (let ((action (gethash "action" command)))
    (cond
      ((equal action "inventory") (inventory manager))
      ((equal action "ready-to-apply")
       (when (manager-tainted manager) (error "Patch process is tainted"))
       (inventory manager))
      ((equal action "blob")
       (let ((bytes (ag-grpc:base64-decode (gethash "data" command ""))))
         (when (> (length bytes) +max-patch-bytes+) (error "Oversized patch content"))
         (store-blob manager bytes (gethash "digest" command))
         (object "stored" (gethash "digest" command))))
      ((equal action "preflight")
       (let* ((index (validate-index (trusted-index manager (gethash "envelope" command))))
              (artifact (object "index" index)))
         (validate-prefix manager artifact (gethash "level" command))
         (inventory manager)))
      ((equal action "attempt")
       (object "result" (gethash (gethash "attempt" command) (gethash "attempts" (manager-state manager)))
               "inventory" (inventory manager)))
      ((equal action "history") (copy-json (gethash "history" (manager-state manager))))
      ((equal action "stage")
       (inspect-artifact manager (gethash "image" command)))
      ((equal action "validate")
       (validate-prefix manager (cached-artifact manager (gethash "digest" command))
                        (gethash "level" command)) (inventory manager))
      ((equal action "apply")
       (apply-level manager (gethash "digest" command) (gethash "level" command)
                    (gethash "attempt" command) (gethash "bootID" command)))
      (t (error "Unknown patch process action ~S" action)))))
