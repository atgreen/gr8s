(in-package #:gr8s.patch)
(defstruct coordinator manager read-state update-state participants call leader-p
  (lock (bt:make-lock "patch coordinator")) thread stopping)
(defun new-cluster-state () (object "plans" (object) "policyLevel" 0 "policyChain" ""))
(defun state-update (coordinator function)
  (funcall (coordinator-update-state coordinator) function))
(defun cluster-state (coordinator) (funcall (coordinator-read-state coordinator)))
(defun participant-call (coordinator participant command)
  (funcall (coordinator-call coordinator) participant command))
(defun participants (coordinator)
  (sort (funcall (coordinator-participants coordinator)) #'string< :key (lambda (p) (gethash "id" p))))
(defun find-plan (state id)
  (or (gethash id (gethash "plans" state)) (error "Unknown patch plan ~A" id)))
(defun plan-state (coordinator id) (find-plan (cluster-state coordinator) id))
(defun patch-plan (coordinator reference target soak &optional (requester "system:local-patch-admin"))
  (unless (funcall (coordinator-leader-p coordinator)) (error "Patch planning requires the control-plane leader"))
  (let* ((manager (coordinator-manager coordinator))
         (artifact (inspect-artifact manager reference))
         (index (gethash "index" artifact))
         (target (or target (length (gethash "levels" index))))
         (peers (participants coordinator))
         (reports (object))
         (id (format nil "patch-~A" (identifier))))
    (unless (and (integerp target) (<= 1 target (length (gethash "levels" index)))
                 (integerp soak) (<= 0 soak 86400) peers)
      (error "Invalid target, soak period, or empty cluster inventory"))
    (dolist (peer peers)
      (let ((report (participant-call coordinator peer (object "action" "inventory"))))
        (unless (and (equal *build-id* (gethash "buildID" report))
                     (equal "healthy" (gethash "state" report))
                     (= (gethash "loadedLevel" report) (gethash "installedLevel" report))
                     (<= (gethash "installedLevel" report) target))
          (error "Process ~A is incompatible, unhealthy, or ahead of the target" (gethash "id" peer)))
        (let* ((manifest (com.inuoe.jzon:parse (text (cached-blob manager (gethash "digest" artifact)))))
               (envelope (com.inuoe.jzon:parse (text (cached-blob manager (gethash "digest" (gethash "config" manifest)))))))
          (participant-call coordinator peer (object "action" "preflight" "envelope" envelope "level" target)))
        (setf (gethash (gethash "id" peer) reports) report)))
    (let ((levels (loop for report being the hash-values of reports collect (gethash "installedLevel" report))))
      (when (> (- (apply #'max levels) (apply #'min levels)) 1)
        (error "Cluster has more than adjacent patch levels; catch up isolated processes first")))
    (let ((plan (object "id" id "digest" (gethash "digest" artifact) "targetLevel" target
                        "state" "planned" "requestedBy" requester "createdAt" (get-universal-time)
                        "soakSeconds" soak "participants" (coerce peers 'vector)
                        "reports" reports "grant" 'null "events" #()
                        "startLevel" (1+ (loop for r being the hash-values of reports minimize (gethash "installedLevel" r)))
                        "level" (1+ (loop for r being the hash-values of reports minimize (gethash "installedLevel" r)))
                        "cursor" 0 "phase" "stage")))
      (state-update coordinator
                    (lambda (state)
                      (setf (gethash id (gethash "plans" state)) plan) state))
      plan)))
(defun append-plan-event (plan state &optional message)
  (setf (gethash "events" plan)
        (concatenate 'vector (gethash "events" plan #())
                     (vector (object "at" (get-universal-time) "state" state
                                     "message" (or message ""))))) plan)
(defun active-plan-id (state)
  (loop for id being the hash-keys of (gethash "plans" state) using (hash-value plan)
        when (member (gethash "state" plan) '("running" "paused") :test #'equal) return id))
(defun control-plan (coordinator id action)
  (state-update
   coordinator
   (lambda (state)
     (let* ((plan (find-plan state id)) (current (gethash "state" plan)))
       (cond
         ((equal action "apply")
          (unless (equal current "planned") (error "Only a planned rollout can be applied"))
          (let ((active (active-plan-id state)))
            (when active (error "Patch rollout ~A already owns the cluster slot" active)))
          (setf (gethash "state" plan) "running"))
         ((equal action "resume")
          (unless (equal current "paused") (error "Only a paused rollout can resume"))
          (setf (gethash "state" plan) "running") (remhash "error" plan))
         ((equal action "pause")
          (unless (equal current "running") (error "Only a running rollout can pause"))
          (setf (gethash "state" plan) "paused"))
         ((equal action "abort")
          (unless (member current '("running" "paused" "planned") :test #'equal)
            (error "Rollout is already terminal"))
          ;; Keep an uncertain grant holding the cluster slot until reconciled.
          (setf (gethash "state" plan) (if (hash-table-p (gethash "grant" plan)) "paused" "aborted")
                (gethash "abortRequested" plan) t))
         (t (error "Unknown rollout action ~A" action)))
       (append-plan-event plan action)
       state)))
  (plan-state coordinator id))
(defun plan-change (coordinator id function)
  (state-update coordinator
                (lambda (state) (funcall function (find-plan state id) state) state)))
(defun plan-peer-order (plan)
  (stable-sort (coerce (gethash "participants" plan) 'list) #'<
               :key (lambda (peer) (cond ((gethash "leader" peer) 3)
                                        ((gethash "voter" peer) 2)
                                        ((gethash "witness" peer) 1) (t 0)))))
(defun same-membership-p (left right)
  (equal (sort (mapcar (lambda (p) (gethash "id" p)) left) #'string<)
         (sort (mapcar (lambda (p) (gethash "id" p)) right) #'string<)))
(defun transfer-artifact (coordinator peer artifact target)
  ;; Use the authenticated management channel for content, independently of CRI.
  ;; Each source file is already a digest-addressed layer; never transfer raw eval requests.
  (let* ((manager (coordinator-manager coordinator))
         (manifest-hash (gethash "digest" artifact))
         (manifest (com.inuoe.jzon:parse (text (cached-blob manager manifest-hash))))
         (hashes (cons manifest-hash
                       (cons (gethash "digest" (gethash "config" manifest))
                             (loop for level across (gethash "levels" (gethash "index" artifact))
                                   append (loop for file across (gethash "files" level) collect (gethash "digest" file)))))))
    (dolist (hash (remove-duplicates hashes :test #'equal))
      (participant-call coordinator peer (object "action" "blob" "digest" hash
                                                 "data" (ag-grpc:base64-encode (cached-blob manager hash)))))
    (participant-call coordinator peer (object "action" "validate" "digest" manifest-hash
                                               "level" target))))
(defun reconcile-grant (coordinator id plan grant)
  (let* ((peer (gethash "participant" grant))
         (report (participant-call coordinator peer (object "action" "inventory")))
         (restarted (not (equal (gethash "bootID" grant) (gethash "bootID" report))))
         (result
           (if restarted
               (let* ((inspection (participant-call coordinator peer (object "action" "attempt" "attempt" (gethash "attempt" grant))))
                      (receipt (gethash "result" inspection)))
                 (unless (and (hash-table-p receipt) (equal "healthy" (gethash "state" receipt))
                              (equal (gethash "digest" plan) (gethash "artifact" receipt))
                              (eql (gethash "level" grant) (gethash "level" receipt)))
                   (error "Process ~A restarted without a recovered terminal receipt; grant remains reserved" (gethash "id" peer)))
                 (gethash "inventory" inspection))
               (participant-call coordinator peer
                                 (object "action" "apply" "digest" (gethash "digest" plan)
                                         "level" (gethash "level" grant) "attempt" (gethash "attempt" grant)
                                         "bootID" (gethash "bootID" grant))))))
    (unless (and (equal "healthy" (gethash "state" result))
                 (= (gethash "loadedLevel" result) (gethash "level" grant)))
      (error "Process failed its patch health gate"))
    (plan-change coordinator id
                 (lambda (current state)
                   (declare (ignore state))
                   (unless (equal (gethash "attempt" grant) (gethash "attempt" (gethash "grant" current)))
                     (error "Patch grant changed while applying"))
                   (setf (gethash (gethash "id" peer) (gethash "reports" current)) result
                         (gethash "grant" current) 'null
                         (gethash "cursor" current) (1+ (gethash "cursor" current))
                         (gethash "soakUntil" current) (+ (get-universal-time) (gethash "soakSeconds" current)))
                   (when (gethash "abortRequested" current) (setf (gethash "state" current) "aborted"))
                   (append-plan-event current "healthy" (gethash "id" peer))))))
(defun check-disruption-budget (coordinator peers target)
  (let* ((voters (remove-if-not (lambda (p) (or (gethash "voter" p) (gethash "witness" p))) peers))
         (healthy 0))
    (when (> (length voters) 1)
      (dolist (peer voters)
        (unless (equal (gethash "id" peer) (gethash "id" target))
          (let ((report (participant-call coordinator peer (object "action" "inventory"))))
            (when (equal "healthy" (gethash "state" report)) (incf healthy)))))
      (when (< healthy (1+ (floor (length voters) 2)))
        (error "Patching ~A would violate the healthy voting quorum" (gethash "id" target))))))
(defun advance-plan (coordinator id plan)
  (let* ((peers (plan-peer-order plan))
         (current-peers (participants coordinator))
         (phase (gethash "phase" plan))
         (grant (gethash "grant" plan)))
    (unless (same-membership-p peers current-peers)
      (error "Cluster membership changed; rollout requires replanning"))
    (cond
      ((hash-table-p grant) (reconcile-grant coordinator id plan grant))
      ((not (equal "running" (gethash "state" plan))) nil)
      ((> (gethash "soakUntil" plan 0) (get-universal-time))
       (dolist (peer peers)
         (let ((report (participant-call coordinator peer (object "action" "inventory"))))
           (unless (equal "healthy" (gethash "state" report))
             (error "Health check failed during soak: ~A" (gethash "id" peer))))))
      ((equal phase "stage")
       (let* ((artifact (cached-artifact (coordinator-manager coordinator) (gethash "digest" plan)))
              (cursor (gethash "cursor" plan)))
         (if (< cursor (length peers))
             (progn
               (transfer-artifact coordinator (nth cursor peers) artifact (gethash "targetLevel" plan))
               (plan-change coordinator id (lambda (p state) (declare (ignore state)) (incf (gethash "cursor" p)))))
             (plan-change coordinator id
                          (lambda (p state) (declare (ignore state))
                            (setf (gethash "phase" p) "roll" (gethash "cursor" p) 0))))))
      ((> (gethash "level" plan) (gethash "targetLevel" plan))
       ;; Fresh reports from every participant are required for completion.
       (dolist (peer peers)
         (let* ((report (participant-call coordinator peer (object "action" "inventory")))
                (old (gethash (gethash "id" peer) (gethash "reports" plan))))
           (unless (and (equal (gethash "bootID" old) (gethash "bootID" report))
                        (= (gethash "targetLevel" plan) (gethash "loadedLevel" report))
                        (equal "healthy" (gethash "state" report)))
             (error "Final patch health check failed for ~A" (gethash "id" peer)))))
       (plan-change coordinator id
                    (lambda (p state)
                      (setf (gethash "state" p) "complete"
                            (gethash "policyLevel" state) (gethash "targetLevel" p)
                            (gethash "policyChain" state)
                            (gethash "chain" (aref (gethash "levels" (gethash "index" (cached-artifact
                                                        (coordinator-manager coordinator) (gethash "digest" p))))
                                                    (1- (gethash "targetLevel" p))))
                            (gethash "policyDigest" state) (gethash "digest" p))
                      (append-plan-event p "complete"))))
      ((>= (gethash "cursor" plan) (length peers))
       (plan-change coordinator id (lambda (p state) (declare (ignore state))
                                     (incf (gethash "level" p)) (setf (gethash "cursor" p) 0))))
      (t
       (let* ((peer (nth (gethash "cursor" plan) peers))
              (expected (gethash (gethash "id" peer) (gethash "reports" plan)))
              (actual (participant-call coordinator peer (object "action" "inventory")))
              (level (gethash "level" plan)))
         (unless (and (equal (gethash "bootID" expected) (gethash "bootID" actual))
                      (equal "healthy" (gethash "state" actual)))
           (error "Participant changed or became unhealthy before its grant"))
         (if (>= (gethash "loadedLevel" actual) level)
             (plan-change coordinator id (lambda (p state) (declare (ignore state)) (incf (gethash "cursor" p))))
             (progn
               ;; Transport adapter checks voter quorum and transfers leadership when needed.
               (check-disruption-budget coordinator peers peer)
               (when (gethash "transferring" (participant-call coordinator peer (object "action" "ready-to-apply")))
                 (return-from advance-plan nil))
               (plan-change coordinator id
                            (lambda (p state)
                              (declare (ignore state))
                              (unless (equal "running" (gethash "state" p)) (error "Rollout was paused"))
                              (setf (gethash "grant" p)
                                    (object "participant" peer "bootID" (gethash "bootID" actual)
                                            "level" level "attempt" (identifier))))))))))))
(defun coordinator-tick (coordinator)
  (when (funcall (coordinator-leader-p coordinator))
    (bt:with-lock-held ((coordinator-lock coordinator))
      (let* ((state (cluster-state coordinator)) (id (active-plan-id state)))
        (when id
          (let ((plan (find-plan state id)))
            (handler-case
                (when (or (equal "running" (gethash "state" plan))
                          (hash-table-p (gethash "grant" plan)))
                  (advance-plan coordinator id plan))
              (error (condition)
                (when (funcall (coordinator-leader-p coordinator))
                  (plan-change coordinator id
                               (lambda (p state)
                                 (declare (ignore state))
                                 (setf (gethash "state" p) "paused" (gethash "error" p) (princ-to-string condition))
                                 (append-plan-event p "paused" (princ-to-string condition)))))))))))))
(defun coordinator-command (coordinator command)
  (let ((action (gethash "action" command)) (id (gethash "id" command)))
    (cond
      ((equal action "inspect") (inspect-artifact (coordinator-manager coordinator) (gethash "image" command)))
      ((equal action "plan") (patch-plan coordinator (gethash "image" command) (gethash "level" command)
                                          (gethash "soakSeconds" command 60) (gethash "requester" command "system:local-patch-admin")))
      ((equal action "status") (if id (plan-state coordinator id) (cluster-state coordinator)))
      ((equal action "history")
       (let ((peer (find (gethash "node" command) (participants coordinator)
                         :key (lambda (p) (gethash "id" p)) :test #'equal)))
         (unless peer (error "Unknown patch process"))
         (participant-call coordinator peer (object "action" "history"))))
      ((member action '("apply" "pause" "resume" "abort") :test #'equal)
       (unless (funcall (coordinator-leader-p coordinator)) (error "Patch changes require the leader"))
       (control-plan coordinator id action))
      (t (error "Unknown patch coordinator command ~A" action)))))
(defun start-coordinator (coordinator)
  (setf (coordinator-thread coordinator)
        (bt:make-thread (lambda ()
                          (loop until (coordinator-stopping coordinator) do
                            (handler-case (coordinator-tick coordinator)
                              (error (e) (format *error-output* "Patch coordinator: ~A~%" e)))
                            (sleep 0.2))) :name "gr8s patch coordinator")) coordinator)
(defun stop-coordinator (coordinator)
  (when coordinator (setf (coordinator-stopping coordinator) t)
    (when (coordinator-thread coordinator) (bt:join-thread (coordinator-thread coordinator)))))
