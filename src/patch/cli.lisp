(in-package #:gr8s.patch)
(defun parse-options (arguments)
  (let* ((action (first arguments))
         (options (list :command :patch :action action :server "http://127.0.0.1:8080"))
         (tail (rest arguments)))
    (unless (member action '("inspect" "plan" "apply" "status" "pause" "resume" "abort" "history" "import") :test #'equal)
      (error "Use patch inspect|plan|apply|status|pause|resume|abort|history|import"))
    (when (and tail (not (uiop:string-prefix-p "--" (first tail))))
      (setf (getf options :argument) (pop tail)))
    (loop while tail for option = (pop tail) do
      (cond
        ((equal option "--watch") (setf (getf options :watch) t))
        ((equal option "--json") (setf (getf options :json) t))
        ((member option '("--server" "--token" "--token-file" "--ca-file" "--state-directory" "--node" "--level" "--soak") :test #'equal)
         (unless (and tail (not (uiop:string-prefix-p "--" (first tail)))) (error "~A requires a value" option))
         (let* ((key (intern (string-upcase (subseq option 2)) :keyword)) (value (pop tail)))
           (setf (getf options key) (if (member key '(:level :soak)) (parse-integer value :junk-allowed nil) value))))
        (t (error "Unknown patch option ~A" option))))
    (when (and (member action '("inspect" "plan" "apply" "pause" "resume" "abort" "import") :test #'equal)
               (not (getf options :argument))) (error "patch ~A requires an argument" action))
    (when (and (equal action "history") (not (getf options :node))) (error "patch history requires --node"))
    (when (and (getf options :level) (not (member action '("plan" "import") :test #'equal)))
      (error "--level applies to patch plan or offline import; an approved plan is immutable"))
    (when (and (getf options :level) (not (plusp (getf options :level)))) (error "Patch level must be positive"))
    (when (and (getf options :soak) (not (<= 0 (getf options :soak) 86400))) (error "Invalid soak seconds"))
    options))
(defun cli-request (options command)
  (with-io-deadline (%cli-request options command)))
(defun %cli-request (options command)
  (let* ((url (getf options :server))
         (token (or (getf options :token)
                    (let ((file (getf options :token-file)))
                      (when file (string-trim '(#\Space #\Newline #\Return) (uiop:read-file-string file))))
                    (uiop:getenv "GR8S_PATCH_TOKEN")
                    (let* ((base (or (uiop:getenv "XDG_STATE_HOME")
                                     (merge-pathnames ".local/state/" (user-homedir-pathname))))
                           (file (merge-pathnames "gr8s/patches/admin.token" (uiop:ensure-directory-pathname base))))
                      (when (probe-file file) (uiop:read-file-string file))))))
    (unless (or (uiop:string-prefix-p "https://" url)
                (cl-ppcre:scan "^http://(127[.]0[.]0[.]1|localhost)(:[0-9]+)?$" url))
      (error "Patch management requires HTTPS or the local administrative endpoint"))
    (multiple-value-bind (body status)
        (drakma:http-request
         (concatenate 'string (string-right-trim "/" url) "/apis/gr8s.io/v1/patchrollouts")
         :method :post :content-type "application/json" :content (com.inuoe.jzon:stringify command)
         :additional-headers (when token (list (cons "Authorization" (concatenate 'string "Bearer " token))))
         :ca-file (getf options :ca-file) :verify :required
         :redirect nil :connection-timeout 15 :proxy nil)
      (let ((reply (com.inuoe.jzon:parse (if (stringp body) body (text body)))))
        (unless (= status 200) (error "Patch request failed (HTTP ~D): ~A" status (gethash "message" reply))) reply))))
(defun print-patch-result (result &optional (output *standard-output*))
  (cond
    ((and (hash-table-p result) (gethash "index" result))
     (let ((index (gethash "index" result)))
       (format output "Release: ~A~%Build: ~A~%Digest: ~A~%" (gethash "baseRelease" index)
               (gethash "buildID" index) (gethash "digest" result))
       (loop for level across (gethash "levels" index) do
         (format output "  Level ~D: ~A~%" (gethash "level" level) (gethash "summary" level "")))))
    ((and (hash-table-p result) (gethash "plans" result))
     (let ((plans (gethash "plans" result)))
       (if (zerop (hash-table-count plans)) (format output "No patch rollouts.~%")
           (maphash (lambda (id plan) (format output "~A  target ~D  ~A~%" id (gethash "targetLevel" plan) (gethash "state" plan))) plans))))
    ((and (hash-table-p result) (gethash "id" result))
     (format output "Plan: ~A  target level ~D  ~A~%Digest: ~A~%"
             (gethash "id" result) (gethash "targetLevel" result) (gethash "state" result) (gethash "digest" result))
     (when (gethash "error" result) (format output "Reason: ~A~%" (gethash "error" result)))
     (format output "~&~24A ~18A ~8A ~A~%" "PROCESS" "ROLE" "LEVEL" "STATE")
     (loop for peer across (gethash "participants" result) for id = (gethash "id" peer)
           for report = (gethash id (gethash "reports" result))
           for grant = (gethash "grant" result) do
       (format output "~24A ~18A ~8D ~A~%" id (gethash "role" peer "worker")
               (gethash "loadedLevel" report 0)
               (if (and (hash-table-p grant) (equal id (gethash "id" (gethash "participant" grant))))
                   (format nil "applying level ~D" (gethash "level" grant)) (gethash "state" report "waiting"))))
     (when (equal "planned" (gethash "state" result))
       (format output "Sequence: stage; canary; workers; witnesses/followers; leader.~%")
       (format output "Impact: brief pauses in declared subsystems; containers keep running.~%")
       (format output "Apply: gr8s patch apply ~A --watch~%" (gethash "id" result))))
    (t (write-line (com.inuoe.jzon:stringify result) output)))
  (finish-output output))
(defun poll-status (options id)
  ;; An election or dropped connection must not terminate an otherwise durable watch.
  (let ((deadline (+ (get-internal-real-time) (* 30 internal-time-units-per-second))))
    (loop
      (handler-case
          (return (cli-request options (object "action" "status" "id" id)))
        (error (condition)
          (when (>= (get-internal-real-time) deadline) (error condition))
          (sleep 0.2))))))
(defun run-command (options)
  (let* ((action (getf options :action)) (argument (getf options :argument))
         (command (object "action" action)))
    (when argument (setf (gethash (if (member action '("inspect" "plan" "import") :test #'equal) "image" "id") command) argument))
    (when (getf options :level) (setf (gethash "level" command) (getf options :level)))
    (when (getf options :soak) (setf (gethash "soakSeconds" command) (getf options :soak)))
    (when (getf options :node) (setf (gethash "node" command) (getf options :node)))
    (let ((result
            (if (getf options :state-directory)
                (let ((manager (open-manager (getf options :state-directory) "offline" '("worker"))))
                  (unwind-protect
                       (cond ((member action '("inspect" "import") :test #'equal)
                              (let ((artifact (inspect-artifact manager argument)))
                                (when (and (equal action "import") (getf options :level))
                                  (validate-prefix manager artifact (getf options :level))
                                  (setf (gethash "bootstrapTarget" (manager-state manager))
                                        (object "digest" (gethash "digest" artifact) "level" (getf options :level)))
                                  (record-event manager "bootstrap-target" "level" (getf options :level)))
                                artifact))
                             ((equal action "history") (gethash "history" (manager-state manager)))
                             (t (error "Offline patch commands support inspect, import, and history only")))
                    (close-manager manager)))
                (cli-request options (if (equal action "import") (object "action" "inspect" "image" argument) command)))))
      (loop
        (if (getf options :json) (write-line (com.inuoe.jzon:stringify result)) (print-patch-result result))
        (unless (and (getf options :watch) (hash-table-p result)
                     (member (gethash "state" result) '("running") :test #'equal)) (return))
        (sleep 1)
        (setf result (poll-status options (gethash "id" result))))
      (if (and (hash-table-p result) (equal "paused" (gethash "state" result))) 1 0))))
