(in-package #:gr8s.patch)
(defconstant +max-patch-bytes+ (* 64 1024 1024))
(defparameter +artifact-type+ "application/vnd.gr8s.patch.v1")
(defun blob-path (manager hash)
  (unless (valid-digest-p hash) (error "Invalid patch digest ~S" hash))
  (path manager (format nil "content/~A" (subseq hash 7))))
(defun store-blob (manager bytes &optional expected)
  (let ((hash (digest bytes)))
    (when (and expected (not (equal expected hash))) (error "Patch content digest mismatch"))
    (durable-bytes (blob-path manager hash) bytes) hash))
(defun cached-blob (manager hash)
  (let* ((file (blob-path manager hash)) (bytes (alexandria:read-file-into-byte-vector file)))
    (unless (equal hash (digest bytes)) (error "Corrupt cached patch blob ~A" hash)) bytes))
(defun read-bounded (stream &optional (maximum +max-patch-bytes+))
  (let ((result (make-array 0 :element-type '(unsigned-byte 8) :adjustable t :fill-pointer 0))
        (buffer (make-array 65536 :element-type '(unsigned-byte 8))))
    (loop for count = (read-sequence buffer stream) while (plusp count) do
      (when (> (+ (length result) count) maximum) (error "Patch download exceeds size limit"))
      (loop for index below count do (vector-push-extend (aref buffer index) result)))
    (coerce result '(simple-array (unsigned-byte 8) (*)))))
(defun http-bytes (url &optional authorization (redirects 5))
  (with-io-deadline (%http-bytes url authorization redirects)))
(defun %http-bytes (url authorization redirects)
  (multiple-value-bind (stream status headers)
      (drakma:http-request url :verify :required :force-binary t :want-stream t :redirect nil
                              :connection-timeout 15 :proxy nil
                              :additional-headers
                              (append '(("Accept" . "application/vnd.oci.image.manifest.v1+json, application/json, application/octet-stream"))
                                      (when authorization (list (cons "Authorization" authorization)))))
    (if (member status '(301 302 303 307 308))
        (let* ((location (cdr (assoc :location headers)))
               (target (and location (puri:render-uri (puri:merge-uris location url) nil))))
          (when (streamp stream) (close stream :abort t))
          (unless (and (plusp redirects) target (uiop:string-prefix-p "https://" target))
            (error "Unsafe or excessive patch registry redirect"))
          ;; Registry blobs commonly redirect to an object store. Never forward
          ;; registry credentials to the redirect destination.
          (http-bytes target nil (1- redirects)))
        (unwind-protect (values (read-bounded stream) status headers)
          (when (streamp stream) (close stream :abort t))))))
(defun challenge-value (challenge key)
  (multiple-value-bind (start end groups ends)
      (cl-ppcre:scan (format nil "~A=\"([^\"]+)\"" key) challenge)
    (declare (ignore end)) (when start (subseq challenge (aref groups 0) (aref ends 0)))))
(defun registry-bytes (base route &optional token)
  (multiple-value-bind (bytes status headers) (http-bytes (concatenate 'string base route) token)
    (cond
      ((= status 200) bytes)
      ((and (= status 401) (null token))
       (let* ((challenge (cdr (assoc :www-authenticate headers)))
              (realm (and challenge (challenge-value challenge "realm")))
              (service (and challenge (challenge-value challenge "service")))
              (scope (and challenge (challenge-value challenge "scope"))))
         (unless (and realm (uiop:string-prefix-p "https://" realm))
           (error "Registry requires unsupported authentication"))
         (multiple-value-bind (reply code)
             (http-bytes (format nil "~A~Aservice=~A&scope=~A" realm
                                 (if (find #\? realm) "&" "?")
                                 (drakma:url-encode (or service "") :utf-8)
                                 (drakma:url-encode (or scope "") :utf-8)))
           (unless (= code 200) (error "Registry token exchange failed: ~D" code))
           (let* ((object (com.inuoe.jzon:parse (text reply)))
                  (bearer (or (gethash "token" object) (gethash "access_token" object))))
             (unless (stringp bearer) (error "Registry supplied no token"))
             (registry-bytes base route (concatenate 'string "Bearer " bearer))))))
      (t (error "Patch registry returned HTTP ~D for ~A" status route)))))
(defun source-reader (reference)
  "Return manifest bytes and a digest->bytes reader for registry or OCI layout."
  (let ((directory (ignore-errors (uiop:directory-exists-p reference))))
    (if directory
        (let* ((root (uiop:ensure-directory-pathname directory))
               (layout (read-json (merge-pathnames "index.json" root)))
               (entries (gethash "manifests" layout)))
          (unless (and (vectorp entries) (= 1 (length entries)))
            (error "Patch OCI layout must contain exactly one manifest"))
          (labels ((read-blob (hash)
                     (unless (valid-digest-p hash) (error "Invalid OCI layout digest"))
                     (let ((file (merge-pathnames (format nil "blobs/sha256/~A" (subseq hash 7)) root)))
                       (when (> (with-open-file (s file :element-type '(unsigned-byte 8)) (file-length s))
                                +max-patch-bytes+)
                         (error "Oversized patch blob"))
                       (let ((bytes (alexandria:read-file-into-byte-vector file)))
                         (unless (equal hash (digest bytes)) (error "OCI layout digest mismatch")) bytes))))
            (let ((hash (gethash "digest" (aref entries 0))))
              (values (read-blob hash) #'read-blob))))
        (let* ((slash (position #\/ reference))
               (at (position #\@ reference))
               (colon (position #\: reference :from-end t))
               (host (and slash (subseq reference 0 slash)))
               (split (or at (and colon slash (> colon slash) colon)))
               (repository (and slash (subseq reference (1+ slash) split)))
               (tag (if split (subseq reference (1+ split)) "latest")))
          (unless (and host repository (cl-ppcre:scan "^[A-Za-z0-9][A-Za-z0-9.:-]*$" host)
                       (cl-ppcre:scan "^[a-z0-9][a-z0-9._/-]*$" repository)
                       (or (valid-digest-p tag) (cl-ppcre:scan "^[A-Za-z0-9_][A-Za-z0-9_.-]*$" tag)))
            (error "Use a fully qualified OCI reference or an OCI layout directory"))
          (let* ((base (format nil "https://~A/v2/~A/" host repository))
                 (manifest (registry-bytes base (concatenate 'string "manifests/" tag))))
            (when (and at (not (equal tag (digest manifest)))) (error "OCI manifest digest mismatch"))
            (values manifest (lambda (hash)
                               (unless (valid-digest-p hash) (error "Invalid OCI blob digest"))
                               (registry-bytes base (concatenate 'string "blobs/" hash)))))))))
(defun trusted-index (manager envelope)
  (let* ((key-id (gethash "keyID" envelope))
         (keys (read-json (path manager "trusted-keys.json")))
         (hex (gethash key-id keys))
         (payload (ag-grpc:base64-decode (gethash "payload" envelope "")))
         (signature (ag-grpc:base64-decode (gethash "signature" envelope ""))))
    (unless (and (stringp hex) (= 64 (length hex)) (= 64 (length signature)))
      (error "Patch publisher is not trusted: ~A" key-id))
    (unless (ironclad:verify-signature
             (ironclad:make-public-key :ed25519 :y (ironclad:hex-string-to-byte-array hex))
             payload signature)
      (error "Invalid patch publisher signature"))
    (let ((index (com.inuoe.jzon:parse (text payload))))
      (unless (and (eql 1 (gethash "format" index)) (equal *build-id* (gethash "buildID" index))
                   (eql +patch-abi+ (gethash "patchABI" index)))
        (error "Patch artifact does not support this exact gr8s build/ABI")) index)))
(defun validate-index (index)
  (let ((previous "") (levels (gethash "levels" index)) (systems (make-hash-table :test 'equal)))
    (maphash (lambda (key value)
               (declare (ignore value))
               (unless (member key '("format" "buildID" "patchABI" "baseRelease" "publisher" "levels") :test #'equal)
                 (error "Unknown required patch index field ~A" key))) index)
    (unless (and (vectorp levels) (not (stringp levels)) (<= 1 (length levels) 10000))
      (error "Patch artifact has no bounded ordered history"))
    (loop for level across levels for number from 1 do
      (maphash (lambda (key value)
                 (declare (ignore value))
                 (unless (member key '("level" "previous" "chain" "mode" "epoch" "clusterMigration"
                                       "files" "system" "systemFile" "summary" "roles" "domains"
                                       "replaces" "requiredCapabilities" "schema") :test #'equal)
                   (error "Unknown required patch level field ~A" key))) level)
      ;; Optional coordination and descriptive metadata must still be well formed.
      (dolist (field '("domains" "replaces"))
        (let ((value (gethash field level #())))
          (unless (and (vectorp value) (not (stringp value))
                       (every #'stringp value))
            (error "Patch ~A must be an array of strings" field))))
      (when (gethash (gethash "system" level) systems) (error "Patch ASDF system name is reused"))
      (setf (gethash (gethash "system" level) systems) t)
      (unless (equal "unchanged" (gethash "schema" level "unchanged"))
        (error "Shared schema changes require a binary upgrade"))
      (loop for capability across (gethash "requiredCapabilities" level #()) do
        (unless (member capability '("reload-v1" "local-checkpoints-v1") :test #'equal)
          (error "Unsupported patch capability ~A" capability)))
      (unless (and (= number (gethash "level" level 0))
                   (equal previous (gethash "previous" level))
                   (valid-digest-p (gethash "chain" level))
                   (member (gethash "mode" level) '("reload") :test #'equal)
                   (zerop (gethash "epoch" level 0))
                   (not (gethash "clusterMigration" level)))
        (error "Invalid/unsupported patch level ~D (history, reload mode, or migration capability)" number))
      (let ((files (gethash "files" level)) (seen (make-hash-table :test 'equal)))
        (unless (and (vectorp files) (<= 1 (length files) 1000)) (error "Invalid patch file list"))
        (loop for entry across files for name = (gethash "path" entry) do
          (unless (and (stringp name) (cl-ppcre:scan "^[a-zA-Z0-9_-]+[.](lisp|asd)$" name)
                       (valid-digest-p (gethash "digest" entry)) (not (gethash name seen)))
            (error "Unsafe or duplicate patch file ~S" name))
          (setf (gethash name seen) t))
        (unless (gethash (gethash "systemFile" level) seen) (error "Missing patch system file")))
      ;; Chain commits to the raw data-only level descriptor without the chain field.
      ;; Publisher canonicalizes JSON with recursively sorted keys (see canonical-json).
      (let ((descriptor (copy-json level)))
        (remhash "chain" descriptor)
        (unless (equal (gethash "chain" level) (digest (octets (canonical-json descriptor))))
          (error "Patch chain checksum mismatch at level ~D" number)))
      (setf previous (gethash "chain" level))) index))
(defun canonical-json (value)
  (typecase value
    (hash-table
     (format nil "{~{~A~^,~}}"
             (loop for key in (sort (loop for k being the hash-keys of value collect k) #'string<)
                   collect (format nil "~A:~A" (com.inuoe.jzon:stringify key)
                                   (canonical-json (gethash key value))))))
    (string (com.inuoe.jzon:stringify value))
    (vector (format nil "[~{~A~^,~}]" (map 'list #'canonical-json value)))
    (t (com.inuoe.jzon:stringify value))))
(defun inspect-artifact (manager reference)
  (multiple-value-bind (manifest-bytes reader) (source-reader reference)
    (let* ((manifest (com.inuoe.jzon:parse (text manifest-bytes)))
           (config (gethash "config" manifest))
           (config-bytes (funcall reader (gethash "digest" config)))
           (envelope (com.inuoe.jzon:parse (text config-bytes))))
      (unless (and (equal +artifact-type+ (gethash "artifactType" manifest))
                   (equal (gethash "digest" config) (digest config-bytes)))
        (error "Invalid patch OCI manifest/config"))
      (let* ((index (validate-index (trusted-index manager envelope)))
             (layers (gethash "layers" manifest))
             (total (length config-bytes)))
        (loop for level across (gethash "levels" index) do
          (loop for file across (gethash "files" level) for hash = (gethash "digest" file) do
            (unless (find hash layers :key (lambda (layer) (gethash "digest" layer)) :test #'equal)
              (error "Signed patch file is absent from OCI layers"))
            (let ((bytes (funcall reader hash)))
              (incf total (length bytes))
              (when (> total +max-patch-bytes+) (error "Patch train exceeds size limit"))
              (store-blob manager bytes hash))))
        (store-blob manager config-bytes (gethash "digest" config))
        (let ((hash (store-blob manager manifest-bytes)))
          (durable-json (path manager (format nil "artifacts/~A.json" (subseq hash 7)))
                        (object "digest" hash "index" index))
          (object "digest" hash "index" index))))))
(defun import-artifact (manager reference) (inspect-artifact manager reference))
(defun cached-artifact (manager hash)
  ;; Recheck the signature and every source digest even after restart.
  (let* ((manifest (com.inuoe.jzon:parse (text (cached-blob manager hash))))
         (envelope (com.inuoe.jzon:parse
                    (text (cached-blob manager (gethash "digest" (gethash "config" manifest))))))
         (index (validate-index (trusted-index manager envelope))))
    (loop for level across (gethash "levels" index) do
      (loop for entry across (gethash "files" level) do (cached-blob manager (gethash "digest" entry))))
    (object "digest" hash "index" index)))
