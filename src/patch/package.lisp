(defpackage #:gr8s.patch
  (:use #:cl)
  (:export #:*manager* #:*build-id* #:open-manager #:close-manager #:inventory
           #:register-domain #:call-in-domain #:register-patch #:checkpoint
           #:inspect-artifact #:import-artifact #:handle-command #:recover-manager
           #:make-coordinator #:coordinator-tick #:coordinator-command
           #:start-coordinator #:stop-coordinator #:parse-options #:run-command))
(in-package #:gr8s.patch)
(defconstant +patch-abi+ 1)
(defvar *manager* nil)
(defvar *domains* (make-hash-table :test 'equal))
(defvar *patch-definitions* (make-hash-table :test 'equal))
(defvar *loading-level* nil)
(defvar *migration-context* nil)
(defun object (&rest pairs) (apply #'gr8s::json-object pairs))
(defun copy-json (value)
  (com.inuoe.jzon:parse (com.inuoe.jzon:stringify value)))
(defun octets (text) (trivial-utf-8:string-to-utf-8-bytes text))
(defun text (bytes) (trivial-utf-8:utf-8-bytes-to-string bytes))
(defun digest (bytes)
  (concatenate 'string "sha256:" (ironclad:byte-array-to-hex-string
                                 (ironclad:digest-sequence :sha256 bytes))))
(defun valid-digest-p (value)
  (and (stringp value) (= (length value) 71)
       (string= value "sha256:" :end1 7)
       (every (lambda (c) (find c "0123456789abcdef")) (subseq value 7))))
(defmacro with-io-deadline (&body body)
  `(handler-case (sb-sys:with-deadline (:seconds 120) ,@body)
     (sb-sys:deadline-timeout () (error "Patch management I/O timed out"))))
(defun identifier () (ironclad:byte-array-to-hex-string (ironclad:random-data 12)))
(defvar *build-id*
  ;; Baked into a native image. Development images are intentionally separate trains.
  (let* ((root (asdf:system-source-directory :gr8s))
         (files (sort (append (directory (merge-pathnames "src/**/*.lisp" root))
                              (list (merge-pathnames "gr8s.asd" root)
                                    (merge-pathnames "ocicl.csv" root)))
                      #'string< :key #'namestring))
         (hash (ironclad:make-digest :sha256)))
    (dolist (file files)
      (ironclad:update-digest hash (octets (enough-namestring file root)))
      (ironclad:update-digest hash (alexandria:read-file-into-byte-vector file)))
    (ironclad:update-digest hash (octets (format nil "~A/~A/~A/abi~D"
                                                 (lisp-implementation-version)
                                                 (machine-type) (software-type) +patch-abi+)))
    (concatenate 'string "sha256:" (ironclad:byte-array-to-hex-string
                                   (ironclad:produce-digest hash)))))
(defstruct (manager (:constructor %make-manager))
  root name roles (boot-id (identifier)) (loaded-level 0) (tainted nil)
  state lock-stream health-check (lock (bt:make-recursive-lock "gr8s patch executor")))
(defun path (manager relative) (merge-pathnames relative (manager-root manager)))
(defun durable-bytes (file bytes)
  (ensure-directories-exist file)
  (let ((temporary (make-pathname :name (format nil ".patch-~A" (identifier))
                                  :type (pathname-type file) :defaults file)))
    (unwind-protect
         (progn
           (with-open-file (stream temporary :direction :output :if-exists :error
                                           :element-type '(unsigned-byte 8))
             (sb-posix:fchmod (sb-sys:fd-stream-fd stream) #o600)
             (write-sequence bytes stream)
             (finish-output stream)
             (sb-posix:fsync (sb-sys:fd-stream-fd stream)))
           (uiop:rename-file-overwriting-target temporary file)
           (let ((fd (sb-posix:open (namestring (uiop:pathname-directory-pathname file))
                                    sb-posix:o-rdonly)))
             (unwind-protect (sb-posix:fsync fd) (sb-posix:close fd))))
      (when (probe-file temporary) (delete-file temporary))))
  file)
(defun durable-json (file value) (durable-bytes file (octets (com.inuoe.jzon:stringify value))))
(defun read-json (file) (com.inuoe.jzon:parse (uiop:read-file-string file)))
(defun save-state (manager)
  (durable-json (path manager "journal.json") (manager-state manager)))
(defun record-event (manager phase &rest pairs)
  (let* ((state (manager-state manager))
         (events (gethash "history" state #())))
    (setf (gethash "history" state)
          (concatenate 'vector events
                       (vector (apply #'object "phase" phase "at" (get-universal-time)
                                      "bootID" (manager-boot-id manager) pairs))))
    (save-state manager)))
(defun initial-state ()
  (object "format" 1 "buildID" *build-id* "level" 0 "chain" "" "accepted" #()
          "checkpoints" (object) "attempts" (object) "history" #()))
(defun open-manager (directory name roles)
  (let* ((root (merge-pathnames "patches/" (uiop:ensure-directory-pathname directory)))
         (manager (%make-manager :root root :name name :roles roles)))
    (ensure-directories-exist (path manager "content/.keep"))
    (sb-posix:chmod (namestring root) #o700)
    (setf (manager-lock-stream manager)
          (open (path manager "process.lock") :direction :io :if-exists :overwrite
                                                :if-does-not-exist :create))
    (handler-case
        (progn
          ;; Linux flock is associated with this open file description, unlike
          ;; process-scoped lockf locks, so a second manager in the same PID is excluded too.
          (unless (zerop (cffi:foreign-funcall "flock" :int (sb-sys:fd-stream-fd (manager-lock-stream manager))
                                                      :int 6 :int)) ; LOCK_EX | LOCK_NB
            (error "Another process owns this patch state directory"))
          (setf (manager-state manager)
                (if (probe-file (path manager "journal.json"))
                    (read-json (path manager "journal.json"))
                    (initial-state)))
          (unless (eql 1 (gethash "format" (manager-state manager)))
            (error "Unsupported patch journal format"))
          (unless (equal *build-id* (gethash "buildID" (manager-state manager)))
            (let* ((old (manager-state manager)) (previous (gethash "buildID" old)))
              ;; Merely enabling the loader must not obstruct ordinary binary
              ;; upgrades for clusters that have never applied a patch.
              (unless (and (valid-digest-p previous) (zerop (gethash "level" old))
                           (zerop (length (gethash "accepted" old)))
                           (zerop (hash-table-count (gethash "checkpoints" old)))
                           (not (gethash "pending" old)) (not (gethash "bootstrapTarget" old)))
                (error "Patched state requires an explicit base-release migration; recover with its original binary"))
              (durable-json (path manager (format nil "archives/~A.json" (subseq previous 7))) old)
              (setf (manager-state manager) (initial-state))
              (record-event manager "base-build-changed" "previousBuildID" previous)))
          manager)
      (error (condition) (close (manager-lock-stream manager)) (error condition)))))
(defun close-manager (manager)
  (when (and manager (manager-lock-stream manager))
    (close (manager-lock-stream manager)) (setf (manager-lock-stream manager) nil)))
(defun inventory (manager)
  (bt:with-recursive-lock-held ((manager-lock manager))
    (object "name" (manager-name manager) "roles" (coerce (manager-roles manager) 'vector)
            "baseRelease" gr8s:+gr8s-version+ "buildID" *build-id* "patchABI" +patch-abi+
            "bootID" (manager-boot-id manager) "installedLevel" (gethash "level" (manager-state manager))
            "loadedLevel" (manager-loaded-level manager)
            "chains" (map 'vector (lambda (entry) (gethash "chain" entry)) (gethash "accepted" (manager-state manager)))
            "chain" (gethash "chain" (manager-state manager))
            "state" (cond ((manager-tainted manager) "tainted")
                          ((and (manager-health-check manager)
                                (not (ignore-errors (funcall (manager-health-check manager) manager)))) "unhealthy")
                          (t "healthy"))
            "domains" (coerce (sort (loop for key being the hash-keys of *domains* collect key) #'string<) 'vector))))
