(in-package #:gr8s-diagnose)

;;; The facts behind rules/relations.pl: what one resource's findings need to
;;; know of the resources around it, each read at most once.

(defstruct (causal-context (:constructor make-causal-context (getter)))
  getter (cache (make-hash-table :test #'equal)) facts evidence unknown)

(defun causal-fact (context &rest fact)
  (pushnew fact (causal-context-facts context) :test #'equal))

(defun causal-observation (context kind ns name result resource &optional detail observed-at)
  (let ((id (format nil "c~D" (1+ (length (causal-context-evidence context))))))
    (push (object "id" id "kind" kind "namespace" ns "name" name
                  "result" (string-downcase (symbol-name result)) "observedAt" (or observed-at (timestamp))
                  "uid" (field resource "metadata" "uid")
                  "resourceVersion" (field resource "metadata" "resourceVersion")
                  "detail" detail)
          (causal-context-evidence context))
    (unless (member result '(:present :listed)) (push id (causal-context-unknown context)))
    id))

(defun related-identity-p (resource kind ns &optional name)
  (and (hash-table-p resource)
       (stringp (field resource "metadata" "uid"))
       (stringp (field resource "metadata" "name"))
       (or (null name) (equal name (field resource "metadata" "name")))
       (or (null (field resource "kind")) (equal kind (field resource "kind")))
       (or (not (namespaced-kind-p kind)) (equal ns (field resource "metadata" "namespace")))))

(defun causal-read (context kind ns &optional name)
  "Memoize one GET/LIST per related source. Lists must be complete, scoped and bounded."
  (let* ((key (list kind ns name)) (cached (gethash key (causal-context-cache context))))
    (when cached (return-from causal-read (values-list cached)))
    (multiple-value-bind (resource state observed-at) (funcall (causal-context-getter context) kind ns name)
      (let* ((items (and (null name) (field resource "items")))
             (valid (and (eq state :present)
                         (if name (related-identity-p resource kind ns name)
                             (and (json-array-p items) (<= (length items) 200)
                                  (let ((more (field resource "metadata" "continue")))
                                    (or (null more) (equal more "")))
                                  (every (lambda (item) (related-identity-p item kind ns)) items)))))
             (result (if valid (if name :present :listed)
                         (if (eq state :present) :invalid-or-incomplete-response state)))
             (id (causal-observation context kind ns (or name "*") result resource
                                     (if name "Related object GET" "Complete namespace LIST; maximum 200 items") observed-at))
             (answer (list (when valid (if name resource items)) valid id)))
        (setf (gethash key (causal-context-cache context)) answer)
        (values-list answer)))))

(defun labels-match-p (labels required)
  (and (hash-table-p required)
       (loop for key being the hash-keys of required using (hash-value value)
             always (and (hash-table-p labels) (equal value (gethash key labels))))))

(defun selector-missing-labels (labels selector)
  "Selector keys LABELS lacks, when LABELS agrees with the rest of SELECTOR and
with most of it. A different value is a different workload, not a missing label."
  (when (and (hash-table-p labels) (hash-table-p selector))
    (let ((missing nil) (matched 0))
      (maphash (lambda (key value)
                 (multiple-value-bind (actual present) (gethash key labels)
                   (cond ((not present) (push key missing))
                         ((equal value actual) (incf matched))
                         (t (return-from selector-missing-labels nil)))))
               selector)
      (when (and missing (>= matched (length missing))) (sort missing #'string<)))))

(defun selector-valid-p (selector)
  (and (hash-table-p selector)
       (or (null (field selector "matchLabels")) (hash-table-p (field selector "matchLabels")))
       (let ((expressions (field selector "matchExpressions")))
         (or (null expressions)
             (and (json-array-p expressions)
                  (every (lambda (e)
                           (and (stringp (field e "key"))
                                (member (field e "operator") '("In" "NotIn" "Exists" "DoesNotExist") :test #'equal)
                                (if (member (field e "operator") '("In" "NotIn") :test #'equal)
                                    (and (json-array-p (field e "values")) (plusp (length (field e "values"))))
                                    t))) expressions))))))

(defun selector-matches-p (selector labels)
  (and (selector-valid-p selector)
       (or (null (field selector "matchLabels")) (labels-match-p labels (field selector "matchLabels")))
       (loop for expression across (or (field selector "matchExpressions") #())
             for key = (field expression "key")
             always (multiple-value-bind (value present) (if (hash-table-p labels) (gethash key labels) (values nil nil))
                      (let ((member (find value (or (field expression "values") #()) :test #'equal)))
                        (cond ((equal "In" (field expression "operator")) (and present member))
                              ((equal "NotIn" (field expression "operator")) (not member))
                              ((equal "Exists" (field expression "operator")) present)
                              (t (not present))))))))

(defun current-generation-p (resource)
  (let ((generation (field resource "metadata" "generation"))
        (observed (field resource "status" "observedGeneration")))
    (and (integerp generation) (integerp observed) (= generation observed))))

(defun condition-p (resource type status &optional reason)
  (find-if (lambda (c) (and (equal type (field c "type")) (equal status (field c "status"))
                            (or (null reason) (equal reason (field c "reason")))))
           (or (field resource "status" "conditions") #())))

(defun active-pod-p (pod)
  (and (not (field pod "metadata" "deletionTimestamp"))
       (not (member (field pod "status" "phase") '("Succeeded" "Failed") :test #'equal))))

(defun unconfigured-labeller (context pod labels ns)
  "When POD runs a known application that sets LABELS on its own Pod only if
configured to, and no configuration the doctor can see mentions that setting,
return the application's name, the ConfigMap read and its observation."
  (let ((application (some #'container-application (coerce (or (field pod "spec" "containers") #()) 'list)))
        (names (loop for volume across (or (field pod "spec" "volumes") #())
                     for name = (field volume "configMap" "name")
                     when (stringp name) collect name))
        (configmaps nil) (proof nil))
    (when (and application names
               (every (lambda (label) (uiop:string-prefix-p (third application) label)) labels))
      (dolist (name names)
        (multiple-value-bind (configmap known id) (causal-read context "ConfigMap" ns name)
          (unless known (return-from unconfigured-labeller nil))
          (push configmap configmaps)
          (setf proof id)))
      (let ((setting (first (known `(labels_itself ,(fourth application) ?setting) '?setting))))
        (when (and setting (not (configuration-mentions-p pod configmaps setting)))
          (list (fourth application) (first names) proof))))))

(defun collect-service-causes (context service ns root)
  (let ((name (field service "metadata" "name")) (selector (field service "spec" "selector")))
    (unless (and (hash-table-p selector) (plusp (hash-table-count selector))
                 (not (equal "ExternalName" (field service "spec" "type"))))
      (return-from collect-service-causes))
    (causal-fact context 'service_selector name root)
    (multiple-value-bind (pods complete proof) (causal-read context "Pod" ns)
      (unless complete (return-from collect-service-causes))
      (let ((selected (remove-if-not (lambda (pod) (labels-match-p (field pod "metadata" "labels") selector)) pods)))
        (let ((near (and (zerop (length selected))
                         (remove-if-not (lambda (pod)
                                          (and (active-pod-p pod)
                                               (selector-missing-labels (field pod "metadata" "labels") selector)))
                                        pods))))
          ;; Pods that lack only a label explain an empty selection better than "no match".
          (if (plusp (length near))
              (let* ((labels (remove-duplicates
                              (loop for pod across near
                                    append (selector-missing-labels (field pod "metadata" "labels") selector))
                              :test #'equal))
                     (labeller (unconfigured-labeller context (aref near 0) labels ns)))
                (if labeller
                    (causal-fact context 'never_labelled name (format nil "~{~A~^, ~}" labels) (first labeller)
                                 (field (aref near 0) "metadata" "name") (second labeller) proof (third labeller))
                    (causal-fact context 'awaits_label name
                                 (format nil "Pod~P ~{~A~^, ~}~@[ and ~D more~]" (length near)
                                         (map 'list (lambda (pod) (field pod "metadata" "name"))
                                              (subseq near 0 (min 3 (length near))))
                                         (when (> (length near) 3) (- (length near) 3)))
                                 (format nil "~{~A~^, ~}" labels) proof)))
              (causal-fact context 'selection_count name (length selected) proof)))
        (when (plusp (length selected)) (causal-fact context 'selected_any name proof))
        (loop for port across (or (field service "spec" "ports") #())
              for target = (field port "targetPort")
              for protocol = (or (field port "protocol") "TCP")
              when (stringp target) do
                (causal-fact context 'service_port name target protocol root)
                (loop for pod across selected
                      for pod-name = (field pod "metadata" "name")
                      ;; Terminal Pods retain labels but are excluded from endpoints.
                      unless (member (field pod "status" "phase") '("Succeeded" "Failed") :test #'equal)
                      do (causal-fact context 'selected_pod name pod-name proof)
                         (unless (some (lambda (container)
                                         (find-if (lambda (p) (and (equal target (field p "name"))
                                                                   (equal protocol (or (field p "protocol") "TCP"))))
                                                  (or (field container "ports") #())))
                                       (concatenate 'vector (or (field pod "spec" "containers") #())
                                         (remove-if-not (lambda (c) (equal "Always" (field c "restartPolicy")))
                                                        (or (field pod "spec" "initContainers") #()))))
                           (causal-fact context 'missing_named_port pod-name target protocol proof))))
        (when (and (plusp (length selected)) (not (eq t (field service "spec" "publishNotReadyAddresses"))))
          (causal-fact context 'routing_requires_ready name root)
          (multiple-value-bind (slices known slice-proof) (causal-read context "EndpointSlice" ns)
            (when known
              (let ((associated (remove-if-not (lambda (slice)
                                  (equal name (field slice "metadata" "labels" "kubernetes.io/service-name"))) slices)))
                (when (some (lambda (slice)
                              (find-if (lambda (owner)
                                         (and (equal "Service" (field owner "kind"))
                                              (not (equal (field service "metadata" "uid") (field owner "uid")))))
                                       (or (field slice "metadata" "ownerReferences") #()))) associated)
                  (causal-observation context "EndpointSlice" ns "*" :stale-service-owner nil)
                  (return-from collect-service-causes))
                (when (every (lambda (slice)
                               (and (json-array-p (field slice "endpoints"))
                                    (every (lambda (ep)
                                             (multiple-value-bind (ready present) (path-value ep "conditions.ready")
                                               (and present (null ready))))
                                           (field slice "endpoints")))) associated)
                  (causal-fact context 'no_ready_endpoints name slice-proof))))))))))

(defun collect-member-views (context ns root)
  "Read one unchanging object through each API server behind the kubernetes
Service. Every member must give it the same resourceVersion."
  (multiple-value-bind (slices known) (causal-read context "EndpointSlice" ns)
    (when known
      (let ((members nil))
        (loop for slice across slices
              when (equal "kubernetes" (field slice "metadata" "labels" "kubernetes.io/service-name"))
                do (loop for port across (or (field slice "ports") #())
                         when (integerp (field port "port"))
                           do (loop for endpoint across (or (field slice "endpoints") #())
                                    do (loop for address across (or (field endpoint "addresses") #())
                                             when (stringp address)
                                               do (pushnew (format nil "~A:~D" address (field port "port")) members
                                                           :test #'equal)))))
        ;; One member has nothing to disagree with.
        (when (rest members)
          (causal-fact context 'control_plane root)
          (dolist (member (sort members #'string<))
            (multiple-value-bind (view state) (funcall (causal-context-getter context) "MemberView" nil member)
              (let ((version (field view "metadata" "resourceVersion")))
                ;; A member the doctor cannot reach from here proves nothing.
                (when (and (eq state :present) (stringp version) (equal "default" (field view "metadata" "name")))
                  ;; Numbers compare by size, so the rules can say which member is furthest on.
                  (causal-fact context 'member_says member
                               (if (and (plusp (length version)) (every #'digit-char-p version))
                                   (parse-integer version)
                                   version)
                               (causal-observation context "Namespace" nil "default" :present view
                                                   (format nil "Read through ~A" member))))))))))))

(defun collect-pod-node-causes (context pod root)
  "When POD, not finished, is bound to a Node that the API says does not exist, state
pod_on_node and node_absent: nothing runs the Pod and no agent will report it. The
absent Node is the finding's evidence, not something the doctor failed to see."
  (let ((node (field pod "spec" "nodeName")))
    ;; Only a Pod in trouble -- not ready, or stuck being deleted -- is worth a Node read.
    (when (and (stringp node) (plusp (length node))
               (not (member (field pod "status" "phase") '("Succeeded" "Failed") :test #'equal))
               (or (field pod "metadata" "deletionTimestamp")
                   (find-if (lambda (condition)
                              (and (equal "Ready" (field condition "type"))
                                   (not (equal "True" (field condition "status")))))
                            (or (field pod "status" "conditions") #()))))
      (multiple-value-bind (resource present proof) (causal-read context "Node" nil node)
        (declare (ignore resource))
        (when (and (not present)
                   (equal "absent" (field (find proof (causal-context-evidence context) :test #'equal
                                                :key (lambda (e) (field e "id")))
                                          "result")))
          (setf (causal-context-unknown context) (remove proof (causal-context-unknown context) :test #'equal))
          (causal-fact context 'pod_on_node (field pod "metadata" "name") node root)
          (causal-fact context 'node_absent node proof))))))

(defun collect-claim-causes (context claim ns root)
  (let ((name (field claim "metadata" "name")) (class-name (field claim "spec" "storageClassName")))
    (unless (and (equal "Pending" (field claim "status" "phase"))
                 (stringp class-name) (plusp (length class-name))
                 (not (field claim "metadata" "annotations" "volume.kubernetes.io/selected-node")))
      (return-from collect-claim-causes))
    (causal-fact context 'claim_awaits_binding name root)
    (multiple-value-bind (class known class-proof) (causal-read context "StorageClass" nil class-name)
      (unless (and known (equal "WaitForFirstConsumer" (field class "volumeBindingMode")))
        (return-from collect-claim-causes))
      (causal-fact context 'claim_binding_mode name "WaitForFirstConsumer" class-proof)
      (multiple-value-bind (pods complete proof) (causal-read context "Pod" ns)
        (when complete
          (loop for pod across pods
                for node = (field pod "spec" "nodeName")
                for pod-name = (field pod "metadata" "name")
                when (and (active-pod-p pod) (stringp node) (plusp (length node))
                          (find name (or (field pod "spec" "volumes") #()) :test #'equal
                                :key (lambda (v) (field v "persistentVolumeClaim" "claimName"))))
                  do (causal-fact context 'consumes_claim pod-name name proof)
                     (causal-fact context 'pod_node_name pod-name node proof)))))))

(defun hpa-utilization-targets (hpa)
  "Return (resource container-name) targets; NIL container means whole-Pod utilization."
  (let ((targets
          (loop for metric across (or (field hpa "spec" "metrics") #())
                for type = (field metric "type")
                for source = (cond ((equal type "Resource") (field metric "resource"))
                                   ((equal type "ContainerResource") (field metric "containerResource")))
                for container = (when (equal type "ContainerResource") (field source "container"))
                when (and (equal "Utilization" (field source "target" "type"))
                          (member (field source "name") '("cpu" "memory") :test #'equal)
                          (or (equal type "Resource")
                              (and (stringp container) (plusp (length container)))))
                  collect (list (field source "name") container))))
    (when (and (equal "autoscaling/v1" (field hpa "apiVersion"))
               (integerp (field hpa "spec" "targetCPUUtilizationPercentage"))
               (plusp (field hpa "spec" "targetCPUUtilizationPercentage")))
      (push '("cpu" nil) targets))
    (remove-duplicates targets :test #'equal)))

(defun collect-hpa-pod-request-causes (context pod ns metric target-container proof)
  ;; A named container takes precedence over a Pod-level request.
  (when (and (null target-container) (field pod "spec" "resources" "requests" metric))
    (return-from collect-hpa-pod-request-causes))
  (let ((pod-name (field pod "metadata" "name"))
        (extra (field pod "status" "extraNodeAllocatableResources")))
    (when (and extra (not (equalp extra #())))
      (causal-observation context "Pod" ns pod-name :unsupported-dra-requests pod)
      (return-from collect-hpa-pod-request-causes))
    (loop for container across
          (concatenate 'vector (or (field pod "spec" "containers") #())
                       (remove-if-not (lambda (c) (equal "Always" (field c "restartPolicy")))
                                      (or (field pod "spec" "initContainers") #())))
          when (and (or (null target-container) (equal target-container (field container "name")))
                    (not (nth-value 1 (path-value container (format nil "resources.requests.~A" metric)))))
            do (causal-fact context 'missing_request pod-name (field container "name") metric proof))))

(defun collect-hpa-causes (context hpa ns root)
  (let* ((name (field hpa "metadata" "name")) (targets (hpa-utilization-targets hpa))
         (ref (field hpa "spec" "scaleTargetRef")) (kind (field ref "kind")))
    (unless targets (return-from collect-hpa-causes))
    (unless (and (equal "apps/v1" (field ref "apiVersion"))
                 (member kind '("Deployment" "ReplicaSet" "StatefulSet" "DaemonSet") :test #'equal)
                 (stringp (field ref "name")))
      (causal-observation context "HorizontalPodAutoscaler" ns name :unsupported-scale-target nil)
      (return-from collect-hpa-causes))
    (multiple-value-bind (target known target-proof) (causal-read context kind ns (field ref "name"))
      (unless known (return-from collect-hpa-causes))
      (let ((selector (field target "spec" "selector")))
        (unless (selector-valid-p selector)
          (causal-observation context kind ns (field ref "name") :unsupported-selector target)
          (return-from collect-hpa-causes))
        (dolist (target targets) (causal-fact context 'hpa_utilization name (first target) root))
        (multiple-value-bind (pods complete proof) (causal-read context "Pod" ns)
          (when complete
            (loop for pod across pods
                  for pod-name = (field pod "metadata" "name")
                  when (and (active-pod-p pod) (equal "Running" (field pod "status" "phase"))
                            (selector-matches-p selector (field pod "metadata" "labels")))
                    do (causal-fact context 'hpa_selects name pod-name target-proof proof)
                       (dolist (target targets)
                         (collect-hpa-pod-request-causes context pod ns (first target) (second target) proof)))))))))

(defun collect-budget-causes (context budget ns root)
  (let ((name (field budget "metadata" "name")) (selector (field budget "spec" "selector")))
    (unless (equal "policy/v1" (field budget "apiVersion"))
      (causal-observation context "PodDisruptionBudget" ns name :unsupported-api-version budget)
      (return-from collect-budget-causes))
    (unless (current-generation-p budget)
      (causal-observation context "PodDisruptionBudget" ns name :stale-or-missing-controller-generation budget)
      (return-from collect-budget-causes))
    (unless (and (eql 0 (field budget "status" "disruptionsAllowed")) selector)
      (return-from collect-budget-causes))
    (unless (selector-valid-p selector)
      (causal-observation context "PodDisruptionBudget" ns name :unsupported-selector budget)
      (return-from collect-budget-causes))
    (causal-fact context 'current_zero_disruptions name root)
    (multiple-value-bind (pods complete proof) (causal-read context "Pod" ns)
      (when complete
        (loop for pod across pods
              for pod-name = (field pod "metadata" "name")
              when (selector-matches-p selector (field pod "metadata" "labels"))
                do (causal-fact context 'budget_selects name pod-name proof)
                   (when (and (active-pod-p pod) (equal "Running" (field pod "status" "phase"))
                              (condition-p pod "Ready" "True"))
                     (causal-fact context 'healthy_pod pod-name proof)))))))

(defun recent-event-p (event &optional (seconds 900))
  "Accept UTC API timestamps only; malformed or old Events cannot establish this cause."
  (let ((age (timestamp-age (or (field event "series" "lastObservedTime") (field event "lastTimestamp")
                                (field event "eventTime")))))
    (and age (<= -60 age seconds))))

(defun event-quota-name (event)
  ;; Classify the standard admission message without retaining arbitrary Event text.
  (let* ((message (field event "message")) (marker "exceeded quota: ")
         (start (and (stringp message) (search marker message))))
    (when (and start
               (or (search "is forbidden" message)
                   (uiop:string-prefix-p "Forbidden: exceeded quota: " message)
                   (uiop:string-prefix-p "Error creating: Forbidden: exceeded quota: " message)))
      (let* ((begin (+ start (length marker))) (end (position #\, message :start begin))
             (name (and end (subseq message begin end))))
        (when (and name (plusp (length name)) (<= (length name) 253)
                   (every (lambda (c) (find c "abcdefghijklmnopqrstuvwxyz0123456789-.")) name)) name)))))

(defun collect-rollout-causes (context deployment ns root)
  (let ((name (field deployment "metadata" "name"))
        (desired (field deployment "spec" "replicas")) (available (gethash "availableReplicas" (or (field deployment "status") (object)) 0)))
    (unless (and (numberp desired) (numberp available) (> desired available))
      (return-from collect-rollout-causes))
    (unless (current-generation-p deployment)
      (causal-observation context "Deployment" ns name :stale-or-missing-controller-generation deployment)
      (return-from collect-rollout-causes))
    (causal-fact context 'rollout_deficit name root)
    (multiple-value-bind (sets complete sets-proof) (causal-read context "ReplicaSet" ns)
      (when complete
        (loop for rs across sets for rs-name = (field rs "metadata" "name")
              when (and (numberp (field rs "spec" "replicas")) (plusp (field rs "spec" "replicas"))
                        (current-generation-p rs) (condition-p rs "ReplicaFailure" "True" "FailedCreate")
                        (find-if (lambda (owner) (and (equal "Deployment" (field owner "kind"))
                                                     (eq t (field owner "controller"))
                                                     (equal (field deployment "metadata" "uid") (field owner "uid"))))
                                 (or (field rs "metadata" "ownerReferences") #())))
                do (causal-fact context 'active_replicaset name rs-name sets-proof)
                   (causal-fact context 'replica_creation_failed rs-name sets-proof)
                   (multiple-value-bind (events known event-proof) (causal-read context "Event" ns)
                     (when known
                       (loop for event across events for quota-name = (event-quota-name event)
                             when (and quota-name (equal "Warning" (field event "type"))
                                       (equal "FailedCreate" (field event "reason")) (recent-event-p event)
                                       (equal (field rs "metadata" "uid") (field event "involvedObject" "uid")))
                               do (multiple-value-bind (quota found quota-proof) (causal-read context "ResourceQuota" ns quota-name)
                                    (declare (ignore quota))
                                    (when found
                                      (causal-fact context 'quota_rejection rs-name quota-name event-proof)
                                      (causal-fact context 'quota_present quota-name quota-proof)))))))))))

(defun augment-causal-report (report resource kind ns getter)
  (when (and (member kind '("Service" "PersistentVolumeClaim" "HorizontalPodAutoscaler" "Deployment" "PodDisruptionBudget" "Pod") :test #'equal)
             (plusp (length (gethash "evidence" report)))
             (equal "present" (field (aref (gethash "evidence" report) 0) "result"))
             (not (find "changed-during-collection" (gethash "evidence" report) :test #'equal
                        :key (lambda (e) (field e "result")))))
    (let ((extra (causal-report resource kind ns getter)))
      (when (find "changed-during-collection" (gethash "evidence" extra) :test #'equal :key (lambda (e) (field e "result")))
        (setf (gethash "findings" report) #()))
      (dolist (key '("findings" "evidence" "unknownEvidence"))
        (setf (gethash key report) (concatenate 'vector (gethash key report) (gethash key extra))))
      (setf (gethash "status" report)
            (cond ((or (equal "incomplete" (gethash "status" report)) (equal "incomplete" (gethash "status" extra))) "incomplete")
                  ((plusp (length (gethash "findings" report))) "findings") (t "no-findings")))))
  report)

(defun causal-report (resource kind namespace getter)
  (let* ((context (make-causal-context getter))
         (name (field resource "metadata" "name"))
         (root (causal-observation context kind namespace name :present resource "Target fields")))
    (cond ((equal kind "Service")
           (collect-service-causes context resource namespace root)
           (when (and (equal name "kubernetes") (equal namespace "default"))
             (collect-member-views context namespace root)))
          ((equal kind "PersistentVolumeClaim") (collect-claim-causes context resource namespace root))
          ((equal kind "HorizontalPodAutoscaler") (collect-hpa-causes context resource namespace root))
          ((equal kind "PodDisruptionBudget") (collect-budget-causes context resource namespace root))
          ((equal kind "Deployment") (collect-rollout-causes context resource namespace root))
          ((equal kind "Pod") (collect-pod-node-causes context resource root)))
    (let ((answers (prove (reverse (causal-context-facts context))
                          '((related ?code ?details ?proof)) '(?code ?details ?proof))))
      (multiple-value-bind (after state) (funcall getter kind namespace name)
        (unless (and (eq state :present) (related-identity-p after kind namespace name)
                     (equal (field resource "metadata" "uid") (field after "metadata" "uid"))
                     (equal (field resource "metadata" "resourceVersion") (field after "metadata" "resourceVersion")))
          (setf answers nil)
          (causal-observation context kind namespace name :changed-during-collection nil)))
      (let ((findings
              (loop for (code details proof) in (remove-duplicates answers :test #'equal)
                    for (severity summary step)
                      = (first (known `(relation ,code ?severity ?summary ?step) '(?severity ?summary ?step)))
                    for finding = (object "code" code "rule" code "severity" severity
                                          "summary" (apply #'format nil summary details)
                                          "nextStep" step
                                          "commands" (coerce (known `(relation_command ,code ?command) '?command) 'vector)
                                          "evidence" (coerce proof 'vector))
                    ;; Every Service that one unconfigured application leaves empty is one problem.
                    when (equal code "service-label-never-set")
                      do (destructuring-bind (service label application pod configmap) details
                           (declare (ignore service))
                           (setf (gethash "subject" finding) (resource-target "ConfigMap" namespace configmap)
                                 (gethash "detailKey" finding) label
                                 (gethash "groupSummary" finding)
                                 (format nil "~A in Pod ~A is not configured to label its own Pods: ConfigMap ~A has no service_registration block, so a Service that selects the label ~A matches nothing."
                                         application pod configmap label)))
                    collect finding)))
        (object "target" (resource-target kind namespace name)
                "status" (cond ((causal-context-unknown context) "incomplete") (findings "findings") (t "no-findings"))
                "scope" "Cross-resource observations; historical Events do not prove a failure remains active."
                "findings" (coerce findings 'vector)
                "evidence" (coerce (nreverse (causal-context-evidence context)) 'vector)
                "unknownEvidence" (coerce (nreverse (causal-context-unknown context)) 'vector))))))
