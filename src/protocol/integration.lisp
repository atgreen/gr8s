;;;;
;;;; Explicit cross-module imports for GR8S.PROTOCOL.
;;;;
;;;; GR8S.PROTOCOL no longer (:use #:gr8s); it imports exactly the sibling symbols
;;;; its implementation references.  Loaded after the stage-1 ownership
;;;; declarations.  INTERN (not FIND-SYMBOL) forward-declares collaborators that
;;;; load later in the serial system; the owner defines onto the same symbol.
;;;; Generated by tools/refactor/gen-stage2-integration.py from the derived map.

(in-package #:gr8s.protocol)

(eval-when (:compile-toplevel :load-toplevel :execute)
  (dolist (spec '(
                  ("GR8S.APISERVER"
                   "CREDENTIAL-TOKEN-RESPONSE")
                  ("GR8S.MODEL"
                   "POD")
                  ("GR8S.RUNTIME"
                   "RUNTIME-ERROR")
                  ))
    (let ((pkg (find-package (first spec))))
      (unless pkg (error "GR8S.PROTOCOL imports from missing package ~A" (first spec)))
      (dolist (name (rest spec))
        (shadowing-import (intern name pkg) '#:gr8s.protocol)))))
