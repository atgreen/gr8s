;;;;
;;;; Purpose:
;;;; Persist Pod condition transition history and actual agent observations.
;;;; History generated by the control plane is deliberately separate from the
;;;; observed revision: rendering conditions must never acknowledge a workload.
;;;; Every record belongs to one UID and cannot revive a replacement by name.

(in-package #:gr8s)

(defun pod-status-state-path (store uid)
  "Return UID's private status checkpoint pathname in STORE."
  (merge-pathnames (format nil "observations/~A.json" uid) (pod-store-path store)))

(defun copy-pod-status-value (value)
  "Copy JSON status data before publishing it outside a store transaction."
  (when value (com.inuoe.jzon:parse (com.inuoe.jzon:stringify value))))

(defun current-status-pod-p (store pod)
  "Check POD's UID and revision against STORE while its lock is held."
  (let ((current (gethash (pod-key (pod-namespace pod) (pod-name pod)) (pod-store-pods store))))
    (and current (equal (pod-uid pod) (pod-uid current))
         (equal (pod-resource-version pod) (pod-resource-version current)))))

(defun persist-pod-status-state (store pod &key
                                         (conditions (gethash (pod-uid pod) (pod-store-pod-condition-histories store)))
                                         (status (gethash (pod-uid pod) (pod-store-pod-observed-statuses store)))
                                         (resource-version (gethash (pod-uid pod) (pod-store-pod-observed-resource-versions store))))
  "Atomically checkpoint POD's history and actual observation before updating memory."
  (let* ((target (pod-status-state-path store (pod-uid pod)))
         (temporary (make-pathname :name (format nil "~A-~36R" (pathname-name target) (random (expt 36 10)))
                                   :type "tmp" :defaults target))
         (record (make-hash-table :test #'equal)))
    (setf (gethash "formatVersion" record) 1
          (gethash "uid" record) (pod-uid pod)
          (gethash "namespace" record) (pod-namespace pod)
          (gethash "name" record) (pod-name pod)
          (gethash "conditions" record) (or conditions #()))
    (when status
      (setf (gethash "status" record) status
            (gethash "observedResourceVersion" record) resource-version))
    (ensure-directories-exist target)
    (unwind-protect
         (progn
           (with-open-file (stream temporary :direction :output :if-exists :supersede :if-does-not-exist :create)
             (com.inuoe.jzon:stringify record :stream stream))
           (uiop:rename-file-overwriting-target temporary target))
      (when (probe-file temporary) (delete-file temporary)))))

(defun load-pod-status-state (store)
  "Restore checkpoints only for the exact desired Pod identity still present on disk."
  (dolist (path (directory (merge-pathnames "observations/*.json" (pod-store-path store))))
    (let* ((record (com.inuoe.jzon:parse path))
           (uid (gethash "uid" record))
           (pod (gethash (pod-key (gethash "namespace" record) (gethash "name" record)) (pod-store-pods store))))
      (unless (eql 1 (gethash "formatVersion" record))
        (error "Unsupported Pod observation checkpoint format in ~A" path))
      (if (and pod (equal uid (pod-uid pod)) (equal uid (pathname-name path)))
          (let ((status (gethash "status" record))
                (conditions (gethash "conditions" record #()))
                (revision (gethash "observedResourceVersion" record)))
            (unless (and (vectorp conditions) (not (stringp conditions)))
              (error "Invalid Pod condition checkpoint in ~A" path))
            (setf (gethash uid (pod-store-pod-condition-histories store)) conditions)
            (when status
              (unless (and (hash-table-p status) (stringp revision))
                (error "Invalid Pod observation checkpoint in ~A" path))
              (setf (gethash uid (pod-store-pod-observed-statuses store)) status
                    (gethash uid (pod-store-pod-observed-resource-versions store)) revision
                    (gethash uid (pod-store-pod-observed-phases store)) (gethash "phase" status "Unknown"))))
          (delete-file path))))
  store)

(defun save-pod-observation (store pod status)
  "Persist an actual observation only while POD's exact desired UID/revision exists."
  (with-store-lock (store)
    (unless (current-status-pod-p store pod) (return-from save-pod-observation nil))
    (let ((uid (pod-uid pod)) (copy (copy-pod-status-value status)))
      (unless (and (equal (pod-resource-version pod) (gethash uid (pod-store-pod-observed-resource-versions store)))
                   (equalp copy (gethash uid (pod-store-pod-observed-statuses store))))
        (persist-pod-status-state store pod :status copy :resource-version (pod-resource-version pod))
        (setf (gethash uid (pod-store-pod-observed-statuses store)) copy
              (gethash uid (pod-store-pod-observed-resource-versions store)) (pod-resource-version pod)
              (gethash uid (pod-store-pod-observed-phases store)) (gethash "phase" copy "Unknown")))
      copy)))
