;;;;
;;;; Purpose:
;;;; Admit structural custom-resource schemas and enforce their supported JSON
;;;; validation constraints, recursive defaulting and unknown-field pruning.
;;;; Unsupported executable validation is rejected instead of silently ignored.

(in-package #:gr8s)

(defvar *crd-track-pruning* nil)
(defvar *crd-pruned-fields* nil)

(defun crd-json-equal-p (left right)
  "Compare JSON values independently of object insertion order."
  (cond ((and (hash-table-p left) (hash-table-p right))
         (and (= (hash-table-count left) (hash-table-count right))
              (loop for key being the hash-keys of left using (hash-value value)
                    always (and (nth-value 1 (gethash key right)) (crd-json-equal-p value (gethash key right))))))
        ((and (vectorp left) (not (stringp left)) (vectorp right) (not (stringp right)))
         (and (= (length left) (length right)) (every #'crd-json-equal-p left right)))
        ((and (numberp left) (numberp right)) (= left right))
        (t (equal left right))))

(defun crd-array-p (value)
  "Distinguish JSON arrays from strings and JSON false."
  (and (vectorp value) (not (stringp value))))

(defun crd-schema-error (path control &rest arguments)
  "Report an admission failure at a useful schema or resource field path."
  (core-resource-error 422 "Invalid" "~A: ~A" path (apply #'format nil control arguments)))

(defun crd-check-string-array (value path &key nonempty)
  "Require a unique string array with optional nonempty cardinality."
  (unless (and (crd-array-p value) (every #'stringp value)
               (or (not nonempty) (plusp (length value)))
               (= (length value) (length (remove-duplicates value :test #'equal))))
    (crd-schema-error path "requires a unique array of strings"))
  value)

(defun validate-crd-schema (schema &optional (path "openAPIV3Schema") (depth 0) branch)
  "Reject nonstructural schemas and every unsupported validation extension."
  (when (> depth 64) (crd-schema-error path "schema nesting exceeds 64"))
  (require-object schema path)
  (maphash
   (lambda (key value)
     (declare (ignore value))
     (unless (member key '("type" "title" "description" "format" "default" "enum" "nullable"
                            "properties" "additionalProperties" "required" "items"
                            "minimum" "maximum" "exclusiveMinimum" "exclusiveMaximum" "multipleOf"
                            "minLength" "maxLength" "pattern" "minItems" "maxItems" "uniqueItems"
                            "minProperties" "maxProperties" "allOf" "anyOf" "oneOf" "not"
                            "x-kubernetes-preserve-unknown-fields" "x-kubernetes-embedded-resource"
                            "x-kubernetes-int-or-string" "x-kubernetes-list-type" "x-kubernetes-list-map-keys"
                            "x-kubernetes-map-type") :test #'equal)
       (crd-schema-error path "unsupported schema keyword ~A" key))) schema)
  (let ((type (gethash "type" schema)) (properties (gethash "properties" schema))
        (int-string (eq t (gethash "x-kubernetes-int-or-string" schema))))
    (unless (or (member type '("object" "array" "string" "number" "integer" "boolean") :test #'equal)
                int-string branch
                (and (null type) (eq t (gethash "x-kubernetes-preserve-unknown-fields" schema))))
      (crd-schema-error path "every structural field requires a type"))
    (when (and type (not (member type '("object" "array" "string" "number" "integer" "boolean") :test #'equal)))
      (crd-schema-error path "invalid structural type"))
    (dolist (field '("nullable" "exclusiveMinimum" "exclusiveMaximum" "uniqueItems"
                     "x-kubernetes-preserve-unknown-fields" "x-kubernetes-embedded-resource" "x-kubernetes-int-or-string"))
      (when (nth-value 1 (gethash field schema))
        (unless (member (gethash field schema) '(t nil)) (crd-schema-error path "~A requires a boolean" field))))
    (when (and (nth-value 1 (gethash "x-kubernetes-preserve-unknown-fields" schema))
               (not (eq t (gethash "x-kubernetes-preserve-unknown-fields" schema))))
      (crd-schema-error path "preserve-unknown-fields must be true or omitted"))
    (dolist (field '("minimum" "maximum" "multipleOf"))
      (when (nth-value 1 (gethash field schema))
        (unless (and (numberp (gethash field schema))
                     (or (not (equal field "multipleOf")) (plusp (gethash field schema))))
          (crd-schema-error path "~A requires a valid numeric bound" field))))
    (dolist (field '("minLength" "maxLength" "minItems" "maxItems" "minProperties" "maxProperties"))
      (when (nth-value 1 (gethash field schema))
        (unless (typep (gethash field schema) '(integer 0 *)) (crd-schema-error path "~A requires a nonnegative integer" field))))
    (when (gethash "pattern" schema)
      (let ((pattern (gethash "pattern" schema)))
        (unless (and (stringp pattern) (not (search "(?" pattern))
                     (not (cl-ppcre:scan "\\\\[1-9]" pattern))
                     (ignore-errors (cl-ppcre:create-scanner pattern)))
          (crd-schema-error path "pattern is invalid or uses unsupported regex extensions"))))
    (when (gethash "format" schema)
      (unless (member (gethash "format" schema) '("" "int32" "int64" "float" "double" "byte" "date-time" "date") :test #'equal)
        (crd-schema-error path "unsupported validation format ~A" (gethash "format" schema))))
    (when (gethash "enum" schema)
      (unless (and (crd-array-p (gethash "enum" schema)) (plusp (length (gethash "enum" schema))))
        (crd-schema-error path "enum requires a nonempty array")))
    (when properties
      (unless (or (equal type "object") branch) (crd-schema-error path "properties requires object type"))
      (require-object properties "schema properties")
      (maphash (lambda (name child) (validate-crd-schema child (format nil "~A.properties.~A" path name) (1+ depth) branch)) properties))
    (when (gethash "required" schema)
      (crd-check-string-array (gethash "required" schema) (concatenate 'string path ".required")))
    (when (nth-value 1 (gethash "additionalProperties" schema))
      (let ((additional (gethash "additionalProperties" schema)))
        (unless (or (hash-table-p additional) (member additional '(t nil)))
          (crd-schema-error path "invalid additionalProperties"))
        (when (hash-table-p additional) (validate-crd-schema additional (concatenate 'string path ".additionalProperties") (1+ depth) branch))))
    (when (equal type "array")
      (unless (hash-table-p (gethash "items" schema)) (crd-schema-error path "arrays require a structural items schema")))
    (when (gethash "items" schema) (validate-crd-schema (gethash "items" schema) (concatenate 'string path ".items") (1+ depth) branch))
    (when (gethash "x-kubernetes-embedded-resource" schema)
      (unless (equal type "object") (crd-schema-error path "embedded resources require object type")))
    (when (gethash "x-kubernetes-map-type" schema)
      (unless (and (equal type "object") (member (gethash "x-kubernetes-map-type" schema) '("atomic" "granular") :test #'equal))
        (crd-schema-error path "invalid map type")))
    (when (gethash "x-kubernetes-list-type" schema)
      (unless (and (equal type "array") (member (gethash "x-kubernetes-list-type" schema) '("atomic" "set" "map") :test #'equal))
        (crd-schema-error path "invalid list type")))
    (when (gethash "x-kubernetes-list-map-keys" schema)
      (unless (and (equal "map" (gethash "x-kubernetes-list-type" schema))
                   (equal "object" (gethash "type" (gethash "items" schema))))
        (crd-schema-error path "list map keys require a map list of objects"))
      (crd-check-string-array (gethash "x-kubernetes-list-map-keys" schema) path :nonempty t)
      (loop for key across (gethash "x-kubernetes-list-map-keys" schema)
            for child = (gethash key (gethash "properties" (gethash "items" schema) (core-object)))
            unless (and child (member (gethash "type" child) '("string" "integer" "boolean" "number") :test #'equal))
              do (crd-schema-error path "list map key ~A requires a scalar item property" key)))
    (when (and (equal "map" (gethash "x-kubernetes-list-type" schema))
               (not (gethash "x-kubernetes-list-map-keys" schema)))
      (crd-schema-error path "map lists require list map keys"))
    (dolist (field '("allOf" "anyOf" "oneOf"))
      (when (gethash field schema)
        (unless (and (crd-array-p (gethash field schema)) (plusp (length (gethash field schema))))
          (crd-schema-error path "~A requires a nonempty schema array" field))
        (loop for child across (gethash field schema) do (validate-crd-schema child path (1+ depth) t))))
    (when (gethash "not" schema) (validate-crd-schema (gethash "not" schema) path (1+ depth) t))
    (when (nth-value 1 (gethash "default" schema))
      (crd-validate-value (gethash "default" schema) schema path (1+ depth))))
  schema)

(defun crd-value-type-p (value type)
  "Check JSON types without conflating false, null, strings or arrays."
  (cond ((null type) t) ((equal type "object") (hash-table-p value))
        ((equal type "array") (crd-array-p value)) ((equal type "string") (stringp value))
        ((equal type "integer") (integerp value)) ((equal type "number") (numberp value))
        ((equal type "boolean") (member value '(t nil)))))

(defun crd-validate-value (value schema path &optional (depth 0))
  "Enforce schema constraints on an already defaulted/pruned JSON value."
  (when (> depth 64) (crd-schema-error path "resource nesting exceeds 64"))
  (when (eq value 'null)
    (unless (gethash "nullable" schema) (crd-schema-error path "null is not allowed"))
    (return-from crd-validate-value value))
  (unless (if (gethash "x-kubernetes-int-or-string" schema) (or (integerp value) (stringp value))
              (crd-value-type-p value (gethash "type" schema)))
    (crd-schema-error path "requires type ~A" (gethash "type" schema)))
  (when (gethash "enum" schema)
    (unless (position value (gethash "enum" schema) :test #'crd-json-equal-p) (crd-schema-error path "value is outside enum")))
  (when (numberp value)
    (dolist (bound '("minimum" "maximum"))
      (when (nth-value 1 (gethash bound schema))
        (let ((limit (gethash bound schema)) (minimum (equal bound "minimum")))
          (unless (if minimum (if (gethash "exclusiveMinimum" schema) (> value limit) (>= value limit))
                      (if (gethash "exclusiveMaximum" schema) (< value limit) (<= value limit)))
            (crd-schema-error path "violates ~A" bound)))))
    (when (gethash "multipleOf" schema)
      (let ((quotient (/ value (gethash "multipleOf" schema))))
        (unless (< (abs (- quotient (round quotient))) 1d-9) (crd-schema-error path "violates multipleOf"))))
    (when (member (gethash "format" schema) '("int32" "int64") :test #'equal)
      (let ((bits (if (equal "int32" (gethash "format" schema)) 32 64)))
        (unless (and (integerp value) (<= (- (expt 2 (1- bits))) value (1- (expt 2 (1- bits)))))
          (crd-schema-error path "integer exceeds its declared format")))))
  (when (stringp value)
    (when (and (gethash "minLength" schema) (< (length value) (gethash "minLength" schema))) (crd-schema-error path "below minLength"))
    (when (and (gethash "maxLength" schema) (> (length value) (gethash "maxLength" schema))) (crd-schema-error path "above maxLength"))
    (when (and (gethash "pattern" schema) (not (cl-ppcre:scan (gethash "pattern" schema) value))) (crd-schema-error path "does not match pattern"))
    (when (equal "byte" (gethash "format" schema)) (core-base64-bytes value path))
    (when (equal "date-time" (gethash "format" schema)) (normalize-event-time value))
    (when (equal "date" (gethash "format" schema))
      (unless (cl-ppcre:scan "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" value) (crd-schema-error path "invalid date"))
      (normalize-event-time (concatenate 'string value "T00:00:00Z"))))
  (when (hash-table-p value)
    (let ((properties (gethash "properties" schema)) (additional (gethash "additionalProperties" schema)))
      (loop for key across (gethash "required" schema #())
            unless (nth-value 1 (gethash key value)) do (crd-schema-error path "missing required field ~A" key))
      (dolist (bound '("minProperties" "maxProperties"))
        (when (and (gethash bound schema)
                   (if (equal bound "minProperties") (< (hash-table-count value) (gethash bound schema))
                       (> (hash-table-count value) (gethash bound schema)))) (crd-schema-error path "violates ~A" bound)))
      (maphash (lambda (key child)
                 (let ((sub (or (and properties (gethash key properties)) (and (hash-table-p additional) additional))))
                   (when sub (crd-validate-value child sub (format nil "~A.~A" path key) (1+ depth))))) value)))
  (when (crd-array-p value)
    (when (and (gethash "minItems" schema) (< (length value) (gethash "minItems" schema))) (crd-schema-error path "below minItems"))
    (when (and (gethash "maxItems" schema) (> (length value) (gethash "maxItems" schema))) (crd-schema-error path "above maxItems"))
    (loop for child across value for index from 0
          do (when (gethash "items" schema) (crd-validate-value child (gethash "items" schema) (format nil "~A[~D]" path index) (1+ depth))))
    (let ((keys (gethash "x-kubernetes-list-map-keys" schema)) (seen nil))
      (loop for child across value
            for identity = (if keys
                               (loop for key across keys collect
                                     (multiple-value-bind (entry present) (gethash key child)
                                       (unless present (crd-schema-error path "missing list map key ~A" key)) entry)) child)
            when (or keys (gethash "uniqueItems" schema) (equal "set" (gethash "x-kubernetes-list-type" schema)))
              do (when (member identity seen :test (if keys #'equalp #'crd-json-equal-p)) (crd-schema-error path "duplicate array identity"))
                 (push identity seen))))
  (dolist (field '("allOf" "anyOf" "oneOf"))
    (when (gethash field schema)
      (let ((success (loop for child across (gethash field schema)
                           count (handler-case (progn (crd-validate-value value child path (1+ depth)) t) (kubernetes-error () nil)))))
        (unless (cond ((equal field "allOf") (= success (length (gethash field schema))))
                      ((equal field "oneOf") (= success 1)) (t (plusp success)))
          (crd-schema-error path "violates ~A" field)))))
  (when (and (gethash "not" schema)
             (handler-case (progn (crd-validate-value value (gethash "not" schema) path (1+ depth)) t) (kubernetes-error () nil)))
    (crd-schema-error path "matches forbidden not schema"))
  value)

(defun crd-prepare-value (input schema &optional (root nil) (depth 0) (path "resource"))
  "Copy INPUT, apply recursive defaults and prune fields outside structural schemas."
  (when (> depth 64) (crd-schema-error "resource" "resource nesting exceeds 64"))
  (let ((value (copy-core-object input)))
    (when (and (eq value 'null) (not (gethash "nullable" schema)) (nth-value 1 (gethash "default" schema)))
      (setf value (copy-core-object (gethash "default" schema))))
    (cond
      ((hash-table-p value)
       (let ((properties (gethash "properties" schema)) (additional (gethash "additionalProperties" schema))
             (preserve (or root (gethash "x-kubernetes-embedded-resource" schema))))
         (maphash (lambda (key child)
                    (let ((sub (or (and properties (gethash key properties)) (and (hash-table-p additional) additional))))
                      (cond ((and preserve (member key '("apiVersion" "kind" "metadata") :test #'equal)) nil)
                            ((and sub (eq child 'null) (not (gethash "nullable" sub)) (not (nth-value 1 (gethash "default" sub)))) (remhash key value))
                            (sub (setf (gethash key value) (crd-prepare-value child sub nil (1+ depth) (format nil "~A.~A" path key))))
                            ((or (eq t additional) (gethash "x-kubernetes-preserve-unknown-fields" schema)) nil)
                            (t (when *crd-track-pruning* (push (format nil "~A.~A" path key) *crd-pruned-fields*))
                               (remhash key value))))) value)
         (when properties
           (maphash (lambda (key sub)
                      (when (and (not (nth-value 1 (gethash key value))) (nth-value 1 (gethash "default" sub)))
                        (setf (gethash key value) (crd-prepare-value (gethash "default" sub) sub nil (1+ depth) (format nil "~A.~A" path key))))) properties))))
      ((crd-array-p value)
       (when (gethash "items" schema)
         (setf value (map 'vector (lambda (child) (crd-prepare-value child (gethash "items" schema) nil (1+ depth) (concatenate 'string path "[]"))) value)))))
    value))
