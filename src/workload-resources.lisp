;;;;
;;;; Purpose:
;;;; Admit apps/v1 Deployments and ReplicaSets with pinned wire/structural
;;;; schemas, immutable selectors, server-owned generations and status, and
;;;; Kubernetes rollout defaults. Controllers are implemented separately.

(in-package #:gr8s)

(let ((addition (com.inuoe.jzon:parse (asdf:system-relative-pathname :gr8s "schema/workloads-v1.json"))))
  (dolist (section '("messages" "definitions"))
    (maphash (lambda (name value) (setf (gethash name (gethash section *podtemplate-schema*)) value))
             (gethash section addition))))

(defun workload-resource-p (resource)
  "Recognize implemented apps workload collections."
  (member resource '("deployments" "replicasets") :test #'equal))

(defun workload-equal-p (left right)
  "Compare JSON maps independent of key order while retaining case-sensitive scalar values."
  (string= (canonical-workload-json left) (canonical-workload-json right)))

(defun assign-generated-workload-name-unlocked (store resource input namespace)
  "Allocate a bounded Kubernetes generated name within the existing core transaction."
  (let* ((metadata (require-object (gethash "metadata" input) "metadata"))
         (prefix (pod-generate-name-prefix metadata)))
    (multiple-value-bind (name present) (gethash "name" metadata)
      (when (and present (not (or (stringp name) (eq name 'null))))
        (core-resource-error 422 "Invalid" "metadata.name must be a string"))
      (when (and (member name '(nil null "") :test #'equal) (plusp (length prefix)))
        (loop repeat 8 for candidate = (funcall *pod-name-generator* prefix)
              unless (gethash (core-resource-key resource namespace candidate) (pod-store-resources store))
                do (setf (gethash "name" metadata) candidate) (return)
              finally (core-resource-error 409 "AlreadyExists" "Could not allocate a unique workload name"))))))

(defun workload-int (value context &optional (default 0))
  "Validate a nonnegative int32, treating JSON null as DEFAULT."
  (when (member value '(nil null)) (setf value default))
  (unless (typep value '(integer 0 2147483647))
    (core-resource-error 422 "Invalid" "~A must be a nonnegative int32" context))
  value)

(defun validate-workload-selector (selector &key allow-empty)
  "Validate LabelSelector expressions; apps selectors stay nonempty while Jobs permit empty manual selectors."
  (require-object selector "spec.selector")
  (reject-unsupported-fields selector '("matchLabels" "matchExpressions") "spec.selector")
  (let ((labels (gethash "matchLabels" selector)) (expressions (gethash "matchExpressions" selector #())))
    (when labels
      (validate-core-metadata (core-object "name" "selector" "labels" labels) nil nil))
    (unless (and (vectorp expressions) (not (stringp expressions)))
      (core-resource-error 422 "Invalid" "matchExpressions must be an array"))
    (when (and (not allow-empty) (or (null labels) (zerop (hash-table-count labels))) (zerop (length expressions)))
      (core-resource-error 422 "Invalid" "spec.selector must not be empty"))
    (loop for expression across expressions
          do (require-object expression "selector expression")
             (reject-unsupported-fields expression '("key" "operator" "values") "selector expression")
             (unless (core-qualified-key-p (gethash "key" expression))
               (core-resource-error 422 "Invalid" "Invalid selector key"))
             (let ((operator (gethash "operator" expression)) (values (gethash "values" expression #())))
               (unless (and (vectorp values) (not (stringp values))
                            (every (lambda (value) (core-label-name-p value :empty t)) values)
                            (cond ((member operator '("In" "NotIn") :test #'equal) (plusp (length values)))
                                  ((member operator '("Exists" "DoesNotExist") :test #'equal) (zerop (length values)))
                                  (t nil)))
                 (core-resource-error 422 "Invalid" "Invalid selector requirement")))))
  selector)

(defun workload-selector-matches-p (selector labels)
  "Match Kubernetes LabelSelector requirements against actual object labels."
  (and (loop for key being the hash-keys of (gethash "matchLabels" selector (core-object))
               using (hash-value value) always (and labels (equal value (gethash key labels))))
       (loop for expression across (gethash "matchExpressions" selector #())
             for key = (gethash "key" expression)
             for present = (and labels (nth-value 1 (gethash key labels)))
             for value = (and present (gethash key labels))
             for contained = (and present (find value (gethash "values" expression #()) :test #'equal))
             always (cond ((equal "In" (gethash "operator" expression)) contained)
                          ((equal "NotIn" (gethash "operator" expression)) (not contained))
                          ((equal "Exists" (gethash "operator" expression)) present)
                          ((equal "DoesNotExist" (gethash "operator" expression)) (not present))))))

(defun workload-selector-string (selector)
  "Serialize the selector exposed by the Scale subresource."
  (format nil "~{~A~^,~}"
          (append
           (sort (loop for key being the hash-keys of (gethash "matchLabels" selector (core-object))
                         using (hash-value value) collect (format nil "~A=~A" key value)) #'string<)
           (loop for expression across (gethash "matchExpressions" selector #())
                 for key = (gethash "key" expression)
                 for operator = (gethash "operator" expression)
                 collect (cond ((equal operator "Exists") key)
                               ((equal operator "DoesNotExist") (concatenate 'string "!" key))
                               (t (format nil "~A ~A (~{~A~^,~})" key (if (equal operator "In") "in" "notin")
                                          (coerce (gethash "values" expression) 'list))))))))

(defun workload-rollout-count (value replicas &key round-up)
  "Resolve a nonnegative integer or percentage rollout limit."
  (cond ((typep value '(integer 0 2147483647)) value)
        ((and (stringp value) (> (length value) 1) (char= #\% (char value (1- (length value))))
              (every #'digit-char-p (subseq value 0 (1- (length value))))
              (<= 0 (parse-integer value :end (1- (length value))) 2147483647))
         (funcall (if round-up #'ceiling #'floor) (* replicas (parse-integer value :end (1- (length value)))) 100))
        (t (core-resource-error 422 "Invalid" "Rollout limit must be a nonnegative integer or percentage"))))

(defun normalize-workload-resource (resource input namespace name)
  "Validate workload desired state without treating submitted status as runtime evidence."
  (let* ((object (copy-core-object (require-object input "workload")))
         (kind (core-resource-kind resource)) (metadata (require-object (gethash "metadata" object) "metadata"))
         (spec (require-object (gethash "spec" object) "spec"))
         (template (require-object (gethash "template" spec) "spec.template"))
         (pod-spec (require-object (gethash "spec" template) "spec.template.spec")))
    (unless (and (equal "apps/v1" (gethash "apiVersion" object "apps/v1")) (equal kind (gethash "kind" object kind)))
      (core-resource-error 400 "BadRequest" "Expected apps/v1 ~A" kind))
    (validate-core-metadata metadata namespace name)
    (pod-generate-name-prefix metadata)
    (setf (gethash "namespace" metadata) namespace (gethash "kind" object) kind (gethash "apiVersion" object) "apps/v1")
    (remhash "status" object)
    (validate-template-shape object (template-schema (concatenate 'string "io.k8s.api.apps.v1." kind)) kind)
    (let ((embedded (gethash "metadata" template (core-object))))
      (when (eq embedded 'null) (setf embedded (core-object)))
      (let ((labels (gethash "labels" embedded (core-object))))
        (when (eq labels 'null) (setf labels (core-object)))
        (setf (gethash "labels" embedded) labels))
      (setf
            (gethash "metadata" template) embedded))
    (validate-template-shape object (template-schema (concatenate 'string "io.k8s.api.apps.v1." kind)) kind)
    (setf (gethash "replicas" spec) (workload-int (gethash "replicas" spec) "spec.replicas" 1)
          (gethash "minReadySeconds" spec) (workload-int (gethash "minReadySeconds" spec) "spec.minReadySeconds"))
    (validate-workload-selector (gethash "selector" spec))
    (let* ((embedded (gethash "metadata" template (core-object))) (check (copy-core-object embedded)))
      (setf (gethash "name" check) "template")
      (validate-core-metadata check (let ((value (gethash "namespace" check)))
                                      (unless (member value '(nil null "") :test #'equal) value)) nil)
      (unless (workload-selector-matches-p (gethash "selector" spec) (gethash "labels" embedded))
        (core-resource-error 422 "Invalid" "spec.selector does not match spec.template.metadata.labels")))
    (when (member (gethash "restartPolicy" pod-spec) '(nil null "") :test #'equal)
      (setf (gethash "restartPolicy" pod-spec) "Always"))
    (unless (equal "Always" (gethash "restartPolicy" pod-spec))
      (core-resource-error 422 "Invalid" "Workload Pod restartPolicy must be Always"))
    (when (member (gethash "dnsPolicy" pod-spec) '(nil null "") :test #'equal)
      (setf (gethash "dnsPolicy" pod-spec) "ClusterFirst"))
    (unless (nth-value 1 (gethash "terminationGracePeriodSeconds" pod-spec))
      (setf (gethash "terminationGracePeriodSeconds" pod-spec) 30))
    (let ((seen (make-hash-table :test #'equal)) (containers (gethash "containers" pod-spec)))
      (unless (and (vectorp containers) (not (stringp containers)) (plusp (length containers)))
        (core-resource-error 422 "Invalid" "Workload template requires containers"))
      (loop for container across containers for cname = (gethash "name" container)
            do (require-dns-label cname "container name")
               (require-nonempty-string (gethash "image" container) "container image")
               (when (gethash cname seen) (core-resource-error 422 "Invalid" "Duplicate container name"))
               (setf (gethash cname seen) t)))
    (when (equal resource "deployments")
      (let* ((strategy (let ((value (gethash "strategy" spec)))
                         (if (member value '(nil null)) (core-object) value)))
             (type (gethash "type" strategy "RollingUpdate")))
        (when (equal type "") (setf type "RollingUpdate"))
        (unless (member type '("RollingUpdate" "Recreate") :test #'equal)
          (core-resource-error 422 "Invalid" "Unsupported deployment strategy"))
        (setf (gethash "type" strategy) type (gethash "strategy" spec) strategy)
        (when (equal type "Recreate")
          (when (gethash "rollingUpdate" strategy) (core-resource-error 422 "Invalid" "Recreate cannot set rollingUpdate")))
        (when (equal type "RollingUpdate")
          (let ((rolling (let ((value (gethash "rollingUpdate" strategy)))
                           (if (member value '(nil null)) (core-object) value))))
            (dolist (key '("maxUnavailable" "maxSurge"))
              (when (member (gethash key rolling) '(nil null)) (setf (gethash key rolling) "25%"))
              (workload-rollout-count (gethash key rolling) 100))
            (when (and (stringp (gethash "maxUnavailable" rolling))
                       (> (workload-rollout-count (gethash "maxUnavailable" rolling) 100) 100))
              (core-resource-error 422 "Invalid" "maxUnavailable must not exceed 100%"))
            (when (and (zerop (workload-rollout-count (gethash "maxUnavailable" rolling) 100))
                       (zerop (workload-rollout-count (gethash "maxSurge" rolling) 100)))
              (core-resource-error 422 "Invalid" "maxUnavailable and maxSurge cannot both be zero"))
            (setf (gethash "rollingUpdate" strategy) rolling))))
      (setf (gethash "revisionHistoryLimit" spec) (workload-int (gethash "revisionHistoryLimit" spec) "revisionHistoryLimit" 10)
            (gethash "progressDeadlineSeconds" spec) (workload-int (gethash "progressDeadlineSeconds" spec) "progressDeadlineSeconds" 600))
      (unless (> (gethash "progressDeadlineSeconds" spec) (gethash "minReadySeconds" spec))
        (core-resource-error 422 "Invalid" "progressDeadlineSeconds must exceed minReadySeconds")))
    object))

(defun prepare-workload-write (resource object existing)
  "Keep controller status server-owned and selectors immutable on ordinary writes."
  (when (workload-resource-p resource)
    (when (and existing (not (workload-equal-p (gethash "selector" (gethash "spec" existing))
                                   (gethash "selector" (gethash "spec" object)))))
      (core-resource-error 422 "Invalid" "spec.selector is immutable"))
    (remhash "deletionTimestamp" (gethash "metadata" object))
    (when (and existing (gethash "deletionTimestamp" (gethash "metadata" existing)))
      (setf (gethash "deletionTimestamp" (gethash "metadata" object))
            (gethash "deletionTimestamp" (gethash "metadata" existing))))
    (setf (gethash "status" object) (if existing (copy-core-object (gethash "status" existing (core-object))) (core-object "replicas" 0))
          (gethash "generation" (gethash "metadata" object))
          (if existing (+ (gethash "generation" (gethash "metadata" existing) 1)
                          (if (workload-equal-p (gethash "spec" existing) (gethash "spec" object)) 0 1)) 1)))
  object)

(defun decode-workload-protobuf (bytes kind)
  "Decode typed workload or Scale wire input with pinned Go omission semantics."
  (let* ((version (if (equal kind "Scale") "autoscaling/v1" "apps/v1"))
         (package (if (equal kind "Scale") "k8s.io.api.autoscaling.v1." "k8s.io.api.apps.v1."))
         (object (template-protobuf-message (concatenate 'string package kind) bytes))
         (metadata (core-protobuf-value (core-protobuf-fields bytes) 1)))
    (setf (gethash "metadata" object) (if metadata (core-protobuf-metadata metadata) (core-object))
          (gethash "apiVersion" object) version (gethash "kind" object) kind)
    object))
