;;;; Stream committed application records without a whole-store JSON/Lisp value.
(in-package #:gr8s.resources)

(defparameter *store-snapshot-max-record-bytes* (* 16 1024 1024))

(defstruct (frozen-store-snapshot (:constructor %make-frozen-store-snapshot))
  store index term pod-records node-records secret-keys)

(defun write-store-snapshot-records (store stream index term &key frozen-view)
  "Stream the versioned artifact from a locked live store or private frozen view.
A live caller holds the raw store/member locks at the exact applied boundary;
a frozen caller supplies the boundary captured earlier under those locks.
This function neither compacts Raft nor captures member-local credentials."
  (let ((count 0))
    (labels ((emit-object (object)
               (let ((start (file-position stream)))
                 (com.inuoe.jzon:stringify object :stream stream)
                 (when (> (- (file-position stream) start) *store-snapshot-max-record-bytes*)
                   (error "Store snapshot record exceeds byte limit")))
               (terpri stream)
               (incf count))
             (emit (kind &rest fields) (emit-object (apply #'core-object "kind" kind fields)))
             (entries (kind table)
               (maphash (lambda (key value) (emit kind "key" key "value" value)) table)))
      (emit "header" "format" "gr8s-store-snapshot" "version" 1 "index" index "term" term)
      (emit "clocks" "resourceRevision" (pod-store-resource-revision store)
            "podRevision" (pod-store-pod-revision store)
            "podEpochFloor" (gr8s.store::pod-store-pod-revision-epoch-floor store)
            "resourceHistoryStart" (pod-store-resource-history-start store)
            "templateHistoryFloor" (pod-store-template-history-floor store)
            "secretsEncryption" (or (pod-store-secret-encryption-config store) 'null)
            "templateTokenKey" (let ((key (pod-store-template-token-key store)))
                                 (when key (ag-grpc:base64-encode key))))
      (maphash (lambda (key object)
                 (unless (local-plane-resource-p (first key))
                   (emit "resource" "resource" (first key)
                         "namespace" (or (second key) 'null) "name" (third key)
                         "object" (encrypt-secret-object store (first key) object))))
               (pod-store-resources store))
      (entries "workloadDeletion" (pod-store-workload-deletions store))
      (entries "jobControllerState" (pod-store-job-controller-states store))
      ;; Retain the existing bounded watch history, without constructing a vector.
      (dolist (entry (pod-store-template-history store))
        (unless (local-plane-resource-p (gethash "resource" entry))
          (emit "history" "entry" (encrypt-secret-history-entry store entry))))
      (if frozen-view
          (mapc #'emit-object (frozen-store-snapshot-pod-records frozen-view))
          (maphash (lambda (key pod)
                     (declare (ignore key))
                     (emit "pod" "object" (pod-to-object pod)
                           "checkpoint" (gr8s.store::pod-checkpoint-object store pod)
                           "publication" (gr8s.store::pod-publication-object store pod)))
                   (pod-store-pods store)))
      (if frozen-view
          (mapc #'emit-object (frozen-store-snapshot-node-records frozen-view))
          (maphash (lambda (name node)
                     (declare (ignore name))
                     (emit "node" "object" (gr8s.store::node-replicated-object node)))
                   (pod-store-nodes store)))
      (if frozen-view
          (gr8s.image-distribution::map-frozen-image-tracker-records
           (pod-store-image-tracker store) #'emit-object)
          (gr8s.image-distribution::map-image-tracker-records
           (pod-store-image-tracker store) #'emit-object))
      (emit "end" "records" count)
      count)))

(defun capture-store-snapshot (store path index term)
  "Publish a new immutable mode0600 JSON-lines artifact, returning PATH and record count.
No existing artifact may be replaced. The source store is never modified."
  (unless (and (typep index '(integer 0 *)) (typep term '(integer 0 *)))
    (error "Invalid store snapshot boundary"))
  (when (gr8s.store::pod-stage-active-p store)
    (error "Cannot snapshot a speculative store transaction"))
  (publish-store-snapshot
   path (lambda (stream)
          (bt:with-lock-held ((pod-store-lock store))
            (write-store-snapshot-records store stream index term)))))

(defun publish-store-snapshot (path writer)
  "Publish WRITER's streamed records with the same durable immutable-file protocol."
  (let* ((path (pathname path)) (temporary (gr8s.security::private-temporary-path path)) (count nil))
    (ensure-directories-exist path)
    (unwind-protect
         (progn
           (gr8s.security::write-private-text-exclusively
              temporary
              (lambda (stream)
                (setf count (funcall writer stream))
                (finish-output stream)
                (sb-posix:fsync (sb-sys:fd-stream-fd stream))))
           ;; Linux RENAME_NOREPLACE: immutable generations must never overwrite
           ;; an existing artifact, including a dangling symlink.
           (unless (zerop (cffi:foreign-funcall "renameat2" :int -100 :string (namestring temporary)
                                               :int -100 :string (namestring path) :uint 1 :int))
             (error "Cannot publish immutable store snapshot ~A" path))
           (let ((fd (sb-posix:open (namestring (uiop:pathname-directory-pathname path))
                                    (logior sb-posix:o-rdonly sb-posix:o-directory) 0)))
             (unwind-protect (sb-posix:fsync fd) (sb-posix:close fd)))
           (values path count))
      (when (probe-file temporary) (delete-file temporary)))))


(defun read-store-snapshot-record (stream buffer max-bytes)
  "Read one newline-terminated JSON object, rejecting oversized or torn records."
  (setf (fill-pointer buffer) 0)
  (loop for byte = (read-byte stream nil nil) do
    (cond
      ((null byte)
       (when (plusp (length buffer)) (error "Truncated store snapshot record"))
       (return nil))
      ((= byte 10)
       (let ((record (com.inuoe.jzon:parse (trivial-utf-8:utf-8-bytes-to-string buffer)
                                           :max-string-length (* 2 1024 1024) :max-depth 128)))
         (unless (hash-table-p record) (error "Store snapshot record must be an object"))
         (return record)))
      (t
       (when (>= (length buffer) max-bytes) (error "Store snapshot record exceeds byte limit"))
       (vector-push-extend byte buffer (min 65536 (- max-bytes (length buffer))))))))

(defun snapshot-natural-p (value &optional upper)
  (and (typep value '(integer 0 *)) (or (null upper) (<= value upper))))

(defun snapshot-revision-p (value upper)
  (and (stringp value) (plusp (length value)) (every #'digit-char-p value)
       (snapshot-natural-p (parse-integer value) upper)))

(defun snapshot-string-p (value)
  (and (stringp value) (plusp (length value))))

(defun snapshot-file-identity-p (value)
  "Recognize identities safe for the existing Pod/Node JSON basename layout."
  (and (snapshot-string-p value) (<= (length value) 250)
       (not (member value '("." "..") :test #'equal))
       (every (lambda (character)
                (find character "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ-_.")) value)))

(defun validate-store-snapshot-clocks (record)
  (let ((revision (gethash "resourceRevision" record))
        (pod-revision (gethash "podRevision" record))
        (key (gethash "templateTokenKey" record)))
    (unless (and (snapshot-natural-p revision) (snapshot-natural-p pod-revision)
                 (snapshot-natural-p (gethash "podEpochFloor" record 0) pod-revision)
                 (snapshot-natural-p (gethash "resourceHistoryStart" record) revision)
                 (snapshot-natural-p (gethash "templateHistoryFloor" record) revision))
      (error "Invalid store snapshot clocks"))
    (when (and key (not (eq key 'null)))
      (unless (stringp key) (error "Invalid snapshot template token key"))
      (let ((bytes (ag-grpc:base64-decode key)))
        (unless (and (= 32 (length bytes)) (equal key (ag-grpc:base64-encode bytes)))
          (error "Invalid snapshot template token key"))))))

(defun snapshot-object-or-null-p (value)
  (or (null value) (eq value 'null) (hash-table-p value)))

(defun validate-snapshot-pod-checkpoint (checkpoint clock)
  (let ((conditions (gethash "conditions" checkpoint))
        (status (gethash "status" checkpoint))
        (finalization (gethash "finalization" checkpoint)))
    (unless (and (vectorp conditions) (not (stringp conditions))
                 (every #'hash-table-p conditions)
                 (snapshot-object-or-null-p status)
                 (snapshot-object-or-null-p (gethash "clientStatus" checkpoint))
                 (snapshot-object-or-null-p finalization))
      (error "Invalid snapshot Pod checkpoint"))
    (when (hash-table-p status)
      (unless (snapshot-revision-p (gethash "observedResourceVersion" checkpoint) clock)
        (error "Invalid snapshot Pod observation revision")))
    (when (hash-table-p finalization)
      (unless (and (member (gethash "runtimeDeleted" finalization) '(t nil))
                   (or (null (gethash "status" finalization))
                       (eq 'null (gethash "status" finalization))
                       (gr8s.store::terminal-status-p (gethash "status" finalization))))
        (error "Invalid snapshot Pod finalization")))))

(defun validate-store-snapshot-data (record clocks)
  "Check one record independently. Cross-record semantics belong to the staged index."
  (let ((kind (gethash "kind" record)) (object (gethash "object" record)))
    (cond
      ((gr8s.image-distribution::image-tracker-record-p record)
       (gr8s.image-distribution::validate-image-tracker-record record))
      ((equal kind "resource")
       (let* ((resource (gethash "resource" record))
              (namespace (gethash "namespace" record))
              (metadata (and (hash-table-p object) (gethash "metadata" object))))
         (unless (and (snapshot-string-p resource) (not (local-plane-resource-p resource))
                      (or (eq namespace 'null) (snapshot-string-p namespace))
                      (snapshot-string-p (gethash "name" record)) (hash-table-p metadata)
                      (equal (gethash "name" record) (gethash "name" metadata))
                      (snapshot-revision-p (gethash "resourceVersion" metadata) (gethash "resourceRevision" clocks))
                      (equal (unless (eq namespace 'null) namespace) (gethash "namespace" metadata))
                      (or (custom-resource-key-p resource)
                          (equal (core-resource-kind resource) (gethash "kind" object))))
           (error "Invalid snapshot resource identity"))))
      ((member kind '("workloadDeletion" "jobControllerState") :test #'equal)
       (unless (and (snapshot-string-p (gethash "key" record)) (hash-table-p (gethash "value" record)))
         (error "Invalid snapshot controller state")))
      ((equal kind "history")
       (let ((entry (gethash "entry" record)))
         (unless (and (hash-table-p entry) (snapshot-string-p (gethash "resource" entry))
                      (not (local-plane-resource-p (gethash "resource" entry)))
                      (snapshot-string-p (gethash "name" entry)) (realp (gethash "time" entry))
                      (snapshot-object-or-null-p (gethash "old" entry))
                      (snapshot-object-or-null-p (gethash "new" entry))
                      (snapshot-natural-p (gethash "revision" entry) (gethash "resourceRevision" clocks)))
           (error "Invalid snapshot history entry"))))
      ((equal kind "pod")
       (let ((metadata (and (hash-table-p object) (gethash "metadata" object)))
             (checkpoint (gethash "checkpoint" record)) (publication (gethash "publication" record)))
         (unless (and (hash-table-p metadata) (equal "Pod" (gethash "kind" object))
                      (every (lambda (key) (snapshot-string-p (gethash key metadata))) '("name" "namespace" "uid"))
                      (snapshot-file-identity-p (gethash "uid" metadata))
                      (snapshot-revision-p (gethash "resourceVersion" metadata) (gethash "podRevision" clocks))
                      (hash-table-p checkpoint) (hash-table-p publication)
                      (equal (gethash "uid" metadata) (gethash "uid" publication))
                      (hash-table-p (gethash "status" publication))
                      (snapshot-revision-p (gethash "resourceVersion" publication) (gethash "podRevision" clocks)))
           (error "Invalid snapshot Pod identity or publication"))
         (validate-snapshot-pod-checkpoint checkpoint (gethash "podRevision" clocks))
         (gr8s.store::store-parse-pod object)))
      ((equal kind "node")
       (unless (and (hash-table-p object)
                    (every (lambda (key) (snapshot-string-p (gethash key object))) '("name" "id"))
                    (snapshot-file-identity-p (gethash "id" object))
                    (snapshot-revision-p (gethash "resourceVersion" object) (gethash "podRevision" clocks)))
         (error "Invalid snapshot Node identity"))
       (gr8s.store:parse-node-record object :expire-leases nil))
      (t (error "Unknown store snapshot record kind ~S" kind)))))

(defun map-store-snapshot-records (path function &key expected-index expected-term
                                                      (max-record-bytes *store-snapshot-max-record-bytes*))
  "Validate framing and individual records without retaining the whole artifact.
FUNCTION receives provisional records: use only a staging destination until this
function returns successfully. Duplicate identities and other index-wide checks
must then be validated before publishing that destination. Returns header/clocks/count."
  (unless (typep max-record-bytes '(integer 1 *)) (error "Invalid snapshot record limit"))
  (with-open-file (stream path :element-type '(unsigned-byte 8))
    (let* ((buffer (make-array (min 4096 max-record-bytes) :element-type '(unsigned-byte 8)
                              :adjustable t :fill-pointer 0))
           (header (read-store-snapshot-record stream buffer max-record-bytes))
           (clocks nil) (count 1))
      (unless (and header (equal "header" (gethash "kind" header))
                   (equal "gr8s-store-snapshot" (gethash "format" header))
                   (eql 1 (gethash "version" header))
                   (snapshot-natural-p (gethash "index" header)) (snapshot-natural-p (gethash "term" header))
                   (or (null expected-index) (eql expected-index (gethash "index" header)))
                   (or (null expected-term) (eql expected-term (gethash "term" header))))
        (error "Invalid store snapshot header or boundary"))
      (setf clocks (read-store-snapshot-record stream buffer max-record-bytes))
      (unless (and clocks (equal "clocks" (gethash "kind" clocks))) (error "Missing snapshot clocks"))
      (validate-store-snapshot-clocks clocks)
      (incf count)
      (when function (funcall function header) (funcall function clocks))
      (loop for record = (read-store-snapshot-record stream buffer max-record-bytes) do
        (unless record (error "Missing store snapshot end record"))
        (when (equal "end" (gethash "kind" record))
          (unless (eql count (gethash "records" record)) (error "Incorrect snapshot record count"))
          (when (read-byte stream nil nil) (error "Trailing store snapshot data"))
          (when function (funcall function record))
          (return (values header clocks (1+ count))))
        (validate-store-snapshot-data record clocks)
        (when function (funcall function record))
        (incf count)))))
