                   "OPTIONAL-VECTOR" "POD-CONTAINERS" "POD-EPHEMERAL-CONTAINERS"
                   "POD-INIT-CONTAINERS" "POD-NAME" "POD-NAMESPACE" "POD-NODE-NAME"
                   "POD-RESOURCE-VERSION" "POD-TO-OBJECT" "POD-UID" "REJECT-UNSUPPORTED-FIELDS"
