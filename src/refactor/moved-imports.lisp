                   "NODE-RECORD-RUNTIME-DOWN-MESSAGE" "NODE-RECORD-UNDERLAY-ADDRESS"
                   "NODE-RECORD-WIREGUARD-ENDPOINTS" "NODE-RECORD-WIREGUARD-PUBLIC-KEY"
