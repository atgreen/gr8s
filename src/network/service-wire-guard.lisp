;;;; Typed Service request/reply graph. Experimental, never installed by CNI.
(in-package #:gr8s.network)

(defparameter *service-wire-rx-maps*
  '((whistler::defmap whistler::gr8s-nat-rx-v2 :type :hash
      :key-size 16 :value-size 96 :max-entries 65536 :map-flags 1)
    (whistler::defmap whistler::gr8s-nat-ri-v2 :type :hash
      :key-size 16 :value-size 16 :max-entries 65536 :map-flags 1)
    (whistler::defmap whistler::gr8s-nat-wl-v2 :type :hash
      :key-size 16 :value-size 8 :max-entries 65536 :map-flags 1)))

(defparameter *service-wire-stage-programs*
  (append *service-nat-stage-programs*
          '((8 . "gr8s_wire_request") (9 . "gr8s_wire_reply")
            (10 . "gr8s_wire_receive") (11 . "gr8s_wire_reply_commit"))))

(defparameter *service-wire-rx-structs*
  '((whistler::defstruct whistler::wire-metadata (whistler::words (array whistler::u64 6)))
    (whistler::defstruct whistler::wire-rx-state (whistler::words (array whistler::u64 12)))))

(in-package #:whistler)

(defmacro wire-candidate-p ()
  `(let ((wire-raw u64 (tc-data)) (wire-end u64 (tc-data-end)))
     (and (<= (+ wire-raw 50) wire-end)
          (= (eth-type wire-raw) #x0800) (= (load u8 wire-raw 14) #x45)
          (= (load u8 wire-raw 23) 17) (= (load u16 wire-raw 36) (htons 6081))
          (= (load u32 wire-raw 46) (htonl #x67723800)))))

(defmacro wire-owner-matches-p (address epoch)
  `(let ((wire-owner (map-lookup-ptr gr8s-nat-id-v2 ,address)))
     (and (/= wire-owner 0)
          (= (logand (load u32 wire-owner 4) #xffff0009) #x20009)
          (or (= (load u32 wire-owner 28) 1) (= (load u32 wire-owner 28) 2))
          (= (load u64 wire-owner 8) (load u64 ,epoch 0))
          (= (load u64 wire-owner 16) (load u64 ,epoch 8))
          (let ((wire-primary (map-lookup-ptr gr8s-nat-id-v2 (+ wire-owner 24))))
            (and (nat-owner-p wire-primary (load u32 wire-owner 24) 1)
                 (/= (logand (load u32 wire-primary 4) 1) 0)
                 (= (load u64 wire-primary 8) (load u64 ,epoch 0))
                 (= (load u64 wire-primary 16) (load u64 ,epoch 8))
                 (if (= (load u32 wire-owner 28) 1)
                     (= (load u32 ,address 0) (load u32 wire-owner 24))
                     (and (= (load u32 ,address 0) (load u32 wire-primary 0))
                          (= (load u32 ,address 0) (load u32 wire-owner 0)))))))))

(defmacro wire-current-frame (incoming)
  `(when (/= wire-offset 0)
     (let ((wire-raw u64 (tc-data)))
       (when (> (+ wire-raw 136) (tc-data-end)) (return TC_ACT_SHOT))
       (let ((wire-local (map-lookup endpoint-identity 0))
             (wire-local-epoch u64 0) (wire-local-address u64 0))
         (when (= wire-local 0) (return TC_ACT_SHOT))
         (unless (or (= (load u32 wire-local 12) 1) (= (load u32 wire-local 12) 2))
           (return TC_ACT_SHOT))
         (if (= (load u8 wire-raw 59) ,(if incoming 1 2))
             (setf wire-local-epoch (+ wire-raw 86))
             (setf wire-local-epoch (+ wire-raw 70)))
         (setf wire-local-address (+ wire-raw ,(if incoming 132 128)))
         (unless (and (= (load u64 wire-local 32) (load u64 wire-local-epoch 0))
                      (= (load u64 wire-local 40) (load u64 wire-local-epoch 8))
                      (let ((wire-own (map-lookup-ptr gr8s-nat-id-v2 wire-local-address)))
                        (and (/= wire-own 0)
                             (= (load u32 wire-own 24) (ntohl (load u32 wire-local 0))))))
           (return TC_ACT_SHOT)))
       (if (= (load u8 wire-raw 59) 1)
           (unless (and (wire-owner-matches-p (+ wire-raw 128) (+ wire-raw 70))
                        (wire-owner-matches-p (+ wire-raw 132) (+ wire-raw 86)))
             (return TC_ACT_SHOT))
           (unless (and (wire-owner-matches-p (+ wire-raw 128) (+ wire-raw 86))
                        (wire-owner-matches-p (+ wire-raw 132) (+ wire-raw 70)))
             (return TC_ACT_SHOT))))))

(defmacro wire-local-capable ()
  `(let ((wire-local (map-lookup endpoint-identity 0)))
     (when (= wire-local 0) (return TC_ACT_SHOT))
     (let ((wire-primary u32 (ntohl (load u32 wire-local 0))))
       (let ((wire-owner (map-lookup gr8s-nat-id-v2 wire-primary)))
         (unless (and (nat-owner-p wire-owner wire-primary 1)
                      (= (logand (load u32 wire-owner 4) 13) 13)
                      (= (load u64 wire-owner 8) (load u64 wire-local 32))
                      (= (load u64 wire-owner 16) (load u64 wire-local 40)))
           (return TC_ACT_SHOT))))))

(defmacro wire-prepare-entry ()
  `(when (/= wire-offset 0)
     (let ((wire-raw u64 (tc-data)))
       (when (> (+ wire-raw 102) (tc-data-end)) (pkt-drop failed))
       (when (= (load u8 wire-raw 59) 1) (nat-pass)))))

(defmacro wire-reply-unclaimed ()
  `(when (/= wire-offset 0) (pkt-drop failed)))

(defmacro wire-validate-reply (state original)
  `(let ((wire-raw u64 (tc-data)))
     (when (or (= wire-offset 0) (> (+ wire-raw 102) (tc-data-end))) (pkt-drop failed))
     (unless (and (= (load u8 wire-raw 59) 2)
                  (/= (logand (load u8 ,state 38) 1) 0)
                  (= (load u32 wire-raw 62) (load u32 ,original 4))
                  (= (load u16 wire-raw 66) (load u16 ,original 10))
                  (= (load u8 wire-raw 68) (load u8 ,original 12))
                  (= (load u64 wire-raw 70) (load u64 ,state 16))
                  (= (load u64 wire-raw 78) (load u64 ,state 24))
                  (= (load u64 wire-raw 86) (load u64 ,state 48))
                  (= (load u64 wire-raw 94) (load u64 ,state 56)))
       (pkt-drop failed))))

(defmacro wire-prepare-owned (state original)
  `(if (/= wire-offset 0)
       (wire-validate-reply ,state ,original)
       ;; A plain incoming request must not borrow an outgoing Service's VIP.
       (when (/= (logand (load u8 ,state 38) 1) 0) (nat-pass))))

(defmacro wire-after-commit (original state)
  `(if (/= (logand (load u8 ,state 38) 1) 0)
       (nat-context ,original #x47523801)
       (nat-clear-context)))

(defmacro wire-before-restore ()
  `(when (/= wire-offset 0)
     (let ((wire-raw u64 (tc-data)))
       (when (> (+ wire-raw 102) (tc-data-end)) (pkt-drop failed))
       (when (= (load u8 wire-raw 59) 1)
         (pkt-unlock)
         (tail-call gr8s-nat-stages 10)
         (return TC_ACT_SHOT)))))

(defmacro wire-after-restore ()
  `(progn
     (nat-clear-context)
     (when (/= wire-offset 0) (wire-strip-authorized))))

(defmacro wire-invert (destination source)
  `(setf (gr8s-pkt-flow-source ,destination) (load u32 ,source 4)
         (gr8s-pkt-flow-destination ,destination) (load u32 ,source 0)
         (gr8s-pkt-flow-sport ,destination) (load u16 ,source 10)
         (gr8s-pkt-flow-dport ,destination) (load u16 ,source 8)
         (gr8s-pkt-flow-protocol ,destination) (load u8 ,source 12)
         (gr8s-pkt-flow-pad0 ,destination) 0 (gr8s-pkt-flow-pad1 ,destination) 0))

(defmacro wire-flow-equal-p (first second)
  `(and (= (load u64 ,first 0) (load u64 ,second 0))
        (= (load u64 ,first 8) (load u64 ,second 8))))

(defmacro wire-release-forward ()
  `(progn
     (wire-release-candidate)
     (when (/= (logand held-locks 1) 0) (map-delete-ptr gr8s-nat-fl-v2 locked-forward))
     (setf held-locks (logand held-locks 2))))

(defmacro wire-take-candidate ()
  `(progn
     (when (/= (map-update-ptr gr8s-nat-wl-v2 wire-locked wire-locked 1) 0) (pkt-drop failed))
     (setf wire-held 1)))

(defmacro wire-release-candidate ()
  `(when (/= wire-held 0)
     (map-delete-ptr gr8s-nat-wl-v2 wire-locked)
     (setf wire-held 0)))

(defmacro wire-reserve-candidates (original state probe alias)
  (labels ((walk (form)
             (cond ((atom form) form)
                   ((equal form `(pkt-lock :reverse ,probe))
                    `(progn ,form (setf wire-locked target)
                            (wire-invert wire-locked ,probe) (wire-take-candidate)))
                   ((equal form `(or (= existing 0) (nat-return-owned-p existing ,original ,state)))
                    `(and (= (map-lookup-ptr gr8s-nat-rx-v2 wire-locked) 0) ,form))
                   ((and (eq (car form) 'let)
                         (equal (first (second form)) `(existing (map-lookup-ptr gr8s-nat-rev-v2 ,probe))))
                    `(let ,(second form) ,@(mapcar #'walk (cddr form)) (wire-release-candidate)))
                   (t (mapcar #'walk form)))))
    (walk (macroexpand-1 `(nat-reserve-candidates ,original ,state ,probe ,alias)))))

(defmacro wire-rx-live-p (row)
  `(and (= (load u32 ,row 88) 1) (= (load u32 ,row 92) 1)
        (<= (- now (load u64 ,row 80))
            (if (= (load u8 ,row 14) 6) 7200000000000 180000000000))))

(defmacro wire-rx-owner-p (row)
  `(and (wire-metadata-valid-p ,row)
        (= (load u8 ,row 5) 1)
        (wire-owner-matches-p (+ ,row 48) (+ ,row 16))
        (wire-owner-matches-p (+ ,row 52) (+ ,row 32))
        (let ((wire-local (map-lookup endpoint-identity 0)))
          (and (/= wire-local 0)
               (= (load u64 wire-local 32) (load u64 ,row 32))
               (= (load u64 wire-local 40) (load u64 ,row 40))
               (= (ntohl (load u32 wire-local 0)) (load u32 ,row 52))))))

(defmacro wire-metadata-from-state (metadata original state)
  `(progn
     (store u32 ,metadata 0 (htonl #x47523853))
     (store u8 ,metadata 4 1) (store u8 ,metadata 5 1)
     (store u16 ,metadata 6 (htons 48))
     (store u32 ,metadata 8 (load u32 ,original 4))
     (store u16 ,metadata 12 (load u16 ,original 10))
     (store u8 ,metadata 14 (load u8 ,original 12))
     (store u64 ,metadata 16 (load u64 ,state 16))
     (store u64 ,metadata 24 (load u64 ,state 24))
     (store u64 ,metadata 32 (load u64 ,state 48))
     (store u64 ,metadata 40 (load u64 ,state 56))))

(defun gr8s.network::service-wire-request-body ()
  '((when (= (ctx u32 64) 0) (nat-pass))
    (when (/= (ctx u32 64) #x47523801) (pkt-drop failed))
    (let ((original (make-gr8s-pkt-flow)) (probe (make-gr8s-nat-return))
          (metadata (make-wire-metadata)))
      (nat-read-context original)
      (pkt-lock :forward original)
      (let ((state (map-lookup-ptr gr8s-nat-fwd-v2 original)))
        (when (= state 0) (pkt-drop failed))
        (unless (and (nat-local-source-p original state) (nat-live-p state original probe)
                     (/= (nat-valid-state state original probe) 0) (= (load u8 state 39) 1)
                     (/= (logand (load u8 state 38) 1) 0)
                     (= (load u32 flow 0) (load u32 state 32))
                     (= (load u16 flow 8) (load u16 state 36))
                     (= (load u32 flow 4) (load u32 state 0))
                     (= (load u16 flow 10) (load u16 state 4))
                     (= (load u8 flow 12) (load u8 original 12))) (pkt-drop failed))
        (let ((receiver (map-lookup-ptr gr8s-nat-id-v2 state)))
          (unless (and (/= receiver 0) (= (logand (load u32 receiver 4) 12) 12))
            (pkt-drop failed)))
        (nat-pair-required original state probe)
        (wire-metadata-from-state metadata original state)
        (wire-encapsulate metadata)
        (nat-clear-context)))))

(defun gr8s.network::service-wire-reply-body ()
  '((nat-clear-context)
    (pkt-lock :forward flow)
    (let ((row (map-lookup-ptr gr8s-nat-rx-v2 flow))
          (metadata (make-wire-metadata)))
      (when (= row 0) (nat-pass))
      (unless (and (wire-rx-live-p row) (wire-rx-owner-p row)) (pkt-drop failed))
      (pkt-lock :reverse (+ row 48))
      (let ((index (map-lookup-ptr gr8s-nat-ri-v2 (+ row 48))))
        (unless (and (/= index 0) (wire-flow-equal-p index flow)) (pkt-drop failed)))
      (nat-copy metadata row 48)
      (store u8 metadata 5 2)
      (setf (gr8s-pkt-pair-first target)
            (logior (cast u64 (load u32 row 48)) (<< (cast u64 (load u16 row 56)) 32)))
      (pkt-write-address flow target meta nil)
      (wire-encapsulate metadata)
      (pkt-unlock)
      (tail-call gr8s-nat-stages 2)
      (return TC_ACT_SHOT))))

(defun gr8s.network::service-wire-reply-commit-body ()
  '((when (= wire-offset 0)
      (pkt-unlock) (tail-call gr8s-nat-stages 3) (return TC_ACT_SHOT))
    (let ((raw u64 (tc-data)) (incoming (make-gr8s-pkt-flow)))
      (when (> (+ raw 102) (tc-data-end)) (pkt-drop failed))
      (unless (= (load u8 raw 59) 2) (pkt-drop failed))
      (wire-invert incoming flow)
      (pkt-lock :reverse incoming)
      (let ((index (map-lookup-ptr gr8s-nat-ri-v2 incoming)))
        (when (= index 0) (pkt-drop failed))
        (pkt-lock :forward index)
        (let ((row (map-lookup-ptr gr8s-nat-rx-v2 index)))
          (unless (and (/= row 0) (wire-rx-live-p row) (wire-rx-owner-p row)
                       (wire-flow-equal-p (+ row 48) incoming)) (pkt-drop failed))
          (unless (and (= (load u64 row 0) (logxor (load u64 raw 54) #x030000000000))
                       (= (load u64 row 8) (load u64 raw 62))
                       (= (load u64 row 16) (load u64 raw 70))
                       (= (load u64 row 24) (load u64 raw 78))
                       (= (load u64 row 32) (load u64 raw 86))
                       (= (load u64 row 40) (load u64 raw 94))) (pkt-drop failed))
          (store u64 row 80 now))))
    (nat-clear-context)
    (pkt-unlock) (tail-call gr8s-nat-stages 4) (return TC_ACT_SHOT)))

(defmacro wire-rx-publish-candidate (entry candidate)
  `(progn
     (pkt-lock :forward ,candidate)
     (setf wire-locked ,candidate)
     (wire-take-candidate)
     (wire-invert (+ ,entry 64) ,candidate)
     (let ((other (map-lookup-ptr gr8s-nat-rx-v2 ,candidate)))
       (when (and (= (map-lookup-ptr gr8s-nat-fwd-v2 ,candidate) 0)
                  (= (map-lookup-ptr gr8s-nat-rev-v2 (+ ,entry 64)) 0)
                  (or (= other 0)
                      (and (wire-metadata-equal-p other ,entry)
                           (wire-flow-equal-p (+ other 48) (+ ,entry 48)))))
         (when (/= (map-update-ptr gr8s-nat-rx-v2 ,candidate ,entry 1) 0)
           (unless (/= other 0) (pkt-drop failed)))
         (when (/= (map-update-ptr gr8s-nat-ri-v2 (+ ,entry 48) ,candidate 1) 0)
           ;; This entry was either newly created or an identical orphan. The
           ;; reverse reservation prevents a concurrent owner publication.
           (map-delete-ptr gr8s-nat-rx-v2 ,candidate)
           (pkt-drop failed))
         (let ((published (map-lookup-ptr gr8s-nat-rx-v2 ,candidate)))
           (when (= published 0) (pkt-drop failed))
           (store u64 published 80 now)
           (store u32 published 92 1))
         (setf chosen 1)))
     (when (= chosen 0) (wire-release-forward))))

(defun gr8s.network::service-wire-receive-body ()
  '((unless (/= wire-offset 0) (pkt-drop failed))
    (let ((raw u64 (tc-data)) (entry (make-wire-rx-state))
          (candidate (make-gr8s-pkt-flow)) (chosen u32 0) (alias u32 0))
      (when (> (+ raw 102) (tc-data-end)) (pkt-drop failed))
      (unless (= (load u8 raw 59) 1) (pkt-drop failed))
      (nat-copy entry (+ raw 54) 48)
      (nat-copy (+ entry 48) flow 16)
      (store u64 entry 80 now) (store u32 entry 88 1)
      (unless (wire-rx-owner-p-for-new entry) (pkt-drop failed))
      (pkt-lock :reverse flow)
      (let ((index (map-lookup-ptr gr8s-nat-ri-v2 flow)))
        (when (/= index 0)
          (nat-copy candidate index 16)
          (pkt-lock :forward candidate)
          (setf wire-locked candidate)
          (wire-take-candidate)
          (let ((old (map-lookup-ptr gr8s-nat-rx-v2 candidate)))
            (unless (and (/= old 0) (wire-metadata-equal-p old entry)
                         (wire-flow-equal-p (+ old 48) flow)
                         (= (load u32 old 88) 1)) (pkt-drop failed))
            (store u64 old 80 now) (store u32 old 92 1))
          (setf chosen 1)))
      (when (= chosen 0)
        (wire-invert candidate flow)
        (let ((client (map-lookup-ptr gr8s-nat-id-v2 flow)))
          (when (= client 0) (pkt-drop failed))
          (setf alias (load u32 client 0))
          (let ((alias-owner (map-lookup gr8s-nat-id-v2 alias)))
            (unless (and (/= alias 0) (/= alias-owner 0)
                         (= (load u32 alias-owner 28) 2)
                         (= (load u32 alias-owner 0) alias)
                         (= (load u32 alias-owner 24) (load u32 client 24))
                         (= (load u64 alias-owner 8) (load u64 client 8))
                         (= (load u64 alias-owner 16) (load u64 client 16))
                         (/= (logand (load u32 alias-owner 4) 1) 0))
              (pkt-drop failed))))
        (wire-rx-publish-candidate entry candidate)
        ;; A receiver-local direct connection can occupy the original visible
        ;; tuple even when the sender had no way to observe it. Use the trusted
        ;; remote alias/ports only on that collision, retaining the wire key.
        (dotimes (attempt 15)
          (when (= chosen 0)
            (setf (gr8s-pkt-flow-destination candidate) alias)
            (when (> attempt 0)
              (setf (gr8s-pkt-flow-dport candidate)
                    (htons (cast u16 (+ (ntohs (gr8s-pkt-flow-dport candidate)) 1)))))
            (when (= (gr8s-pkt-flow-dport candidate) 0)
              (setf (gr8s-pkt-flow-dport candidate) (htons 1)))
            (wire-rx-publish-candidate entry candidate))))
      (unless (/= chosen 0) (pkt-drop collision))
      (wire-release-candidate)
      (setf (gr8s-pkt-pair-first target)
            (logior (cast u64 (load u32 candidate 4)) (<< (cast u64 (load u16 candidate 10)) 32)))
      (pkt-write-address flow target meta t)
      (wire-strip-authorized)
      (nat-clear-context))))

(defmacro wire-rx-owner-p-for-new (row)
  `(wire-rx-owner-p ,row))

(in-package #:gr8s.network)

(defun expand-service-wire-form (form &key (transaction t))
  "Expand wire codec/control macros with transaction-aware error exits."
  (labels ((walk (value)
             (cond ((atom value) value)
                   ((and (symbolp (car value))
                         (alexandria:starts-with-subseq "WIRE-" (symbol-name (car value)))
                         (macro-function (car value)))
                    (walk (if transaction
                              (subst '(whistler::pkt-drop whistler::failed)
                                     '(return whistler::TC_ACT_SHOT) (macroexpand-1 value) :test #'equal)
                              (macroexpand-1 value))))
                   (t (mapcar #'walk value)))))
    (expand-service-nat-form (walk form))))

(defun service-wire-inner-program (form &key (addresses nil) (transaction t))
  "Retain the envelope through policy. Rewrite only legacy parser/helper offsets;
opaque wire macro calls are expanded afterwards and use physical frame offsets."
  (labels ((walk (node)
             (cond ((atom node) node)
                   ((and (symbolp (car node))
                         (alexandria:starts-with-subseq "WIRE-" (symbol-name (car node)))) node)
                   ((equal node '(whistler::tc-data)) '(+ (whistler::tc-data) whistler::wire-offset))
                   ((equal node '(whistler::ctx whistler::u32 0))
                    '(- (whistler::ctx whistler::u32 0) whistler::wire-offset))
                   ((member (car node) '(whistler::skb-load-bytes whistler::skb-store-bytes
                                        whistler::l3-csum-replace whistler::l4-csum-replace))
                    (let ((result (mapcar #'walk node)))
                      (setf (third result) `(+ whistler::wire-offset ,(third result))) result))
                   (t (mapcar #'walk node)))))
    (let ((result (walk (expand-service-nat-form form)))
          ;; Egress roots reject Pod-originated envelopes. Reply classification
          ;; wraps before policy, and reply-commit sends those packets directly
          ;; to delivery, bypassing generation/selection/NAT commit. These stages
          ;; therefore accept only plain packets, including when called directly.
          (plain-only
            (member (second form)
                    '(whistler::gr8s-nat-generation whistler::gr8s-nat-select
                      whistler::gr8s-nat-commit whistler::gr8s-wire-request
                      whistler::gr8s-wire-reply whistler::gr8s-nat-gc))))
      (setf (fourth result) (expand-service-wire-form (fourth result) :transaction transaction))
      (setf (fourth result)
            `(let ((whistler::wire-offset whistler::u32 0)
                   (whistler::wire-held whistler::u32 0)
                   (whistler::wire-locked whistler::u64 0))
               ,@(unless (eq (second form) 'whistler::gr8s-nat-gc) '((whistler::wire-local-capable)))
               ,@(if plain-only
                     '((when (whistler::wire-candidate-p) (return whistler::TC_ACT_SHOT)))
                     `((when (whistler::wire-candidate-p)
                         (whistler::wire-check-envelope ,addresses)
                         (setf whistler::wire-offset 102))
                       (whistler::wire-current-frame
                        ,(not (null (member (second form)
                                            '(whistler::gr8s-nat-prepare whistler::gr8s-nat-restore
                                              whistler::gr8s-wire-receive whistler::gr8s-v2-in-policy)))))))
               ,(fourth result)))
      (expand-service-wire-form result :transaction nil))))

(defun service-wire-rewrite-body (body replacements)
  (reduce (lambda (tree pair) (subst (cdr pair) (car pair) tree :test #'equal))
          replacements :initial-value body))

(defun service-wire-select-body ()
  "Only plain direct reverse rows retain legacy reply handling. Typed Service
replies are dispatched before selection, so a Service row cannot suppress the
refresh of an independent direct outbound connection on the same node."
  (let ((rewrites 0))
   (labels ((walk (form)
             (cond ((atom form) form)
                   ((and (eq (car form) 'whistler::when-let)
                         (equal (second form)
                                '((whistler::entry (whistler::map-lookup-ptr whistler::gr8s-nat-rev-v2 whistler::flow)))))
                    (incf rewrites)
                    (let ((body (butlast (cddr form))))
                      `(whistler::when-let ,(second form)
                         ,@(butlast body)
                         (let ((whistler::held
                                 (whistler::map-lookup-ptr whistler::gr8s-nat-fwd-v2 whistler::original)))
                           (when (= whistler::held 0) (whistler::pkt-drop whistler::failed))
                           (whistler::nat-copy whistler::state whistler::held 64)
                           (if (/= (logand (whistler::load whistler::u8 whistler::state 38) 1) 0)
                               (whistler::wire-release-forward)
                               (progn ,@(cddddr (car (last body))) (whistler::nat-pass)))))))
                   (t (mapcar #'walk form)))))
    (let ((body (walk (service-nat-select-form))))
      (unless (= rewrites 1) (error "Expected one typed Service return boundary, got ~D" rewrites))
      (subst 'whistler::wire-reserve-candidates 'whistler::nat-reserve-candidates body)))))

(defun service-wire-guard-forms ()
  (let* ((*service-nat-local-identity-p* t)
         (*service-wire-locks-p* t)
         (base (service-nat-guard-forms))
         (programs (remove-if-not (lambda (f) (eq (first f) 'whistler::defprog)) base))
         (egress (copy-tree (find 'whistler::gr8s-egress-guard programs :key #'second)))
         (policy (service-nat-policy-forms))
         (eg-policy (copy-tree (second policy)))
         (in-policy (copy-tree (third policy))))
    (setf egress (subst (service-nat-tail-form 9) (service-nat-tail-form 0) egress :test #'equal))
    (setf (fourth egress)
          `(progn (whistler::wire-local-capable)
                  (when (whistler::wire-candidate-p) (return whistler::TC_ACT_SHOT)) ,(fourth egress)))
    (setf (second eg-policy) 'whistler::gr8s-v2-eg-policy
          (second in-policy) 'whistler::gr8s-v2-in-policy)
    (append
     *service-packet-struct-forms* *service-nat-struct-forms*
     (service-wire-struct-forms) *service-wire-rx-structs*
     (list *service-nat-policy-key-form* (expand-service-wire-form egress :transaction nil)
           (let ((ingress (copy-tree (find 'whistler::gr8s-ingress-guard programs :key #'second))))
             (setf (fourth ingress) `(progn (whistler::wire-local-capable) ,(fourth ingress)))
             (expand-service-wire-form ingress :transaction nil))
           (service-nat-stage-continue (service-wire-inner-program eg-policy :transaction nil) 11)
           (service-nat-stage-continue (service-wire-inner-program in-policy :transaction nil) 7)
           (service-wire-inner-program (find 'whistler::gr8s-nat-generation programs :key #'second))
           (service-nat-stage-continue
            (service-wire-inner-program
             (service-nat-program-form 'whistler::gr8s-nat-select
              (service-wire-select-body))) 2))
     (loop for (name body next full-parser addresses) in
       (list
        (list 'whistler::gr8s-nat-commit
              (service-wire-rewrite-body
               (service-nat-commit-form)
               '(((whistler::nat-clear-context) . (whistler::wire-after-commit whistler::original whistler::state))))
              8 t nil)
        (list 'whistler::gr8s-nat-prepare
                (let ((body (service-nat-prepare-form)))
                ;; Insert hooks at stable transaction boundaries, before expansion.
                (labels ((walk (f)
                           (cond ((atom f) f)
                                 ((and (eq (car f) 'when) (equal (second f) '(= whistler::entry 0)))
                                  `(when ,(second f) (whistler::wire-reply-unclaimed) ,@(mapcar #'walk (cddr f))))
                                 ((equal f '(unless (whistler::nat-return-owned-p whistler::entry whistler::original whistler::state)
                                             (whistler::pkt-drop whistler::failed)))
                                  `(progn (whistler::wire-prepare-owned whistler::state whistler::original) ,f))
                                 (t (mapcar #'walk f)))))
                  (cons (first body) (cons '(whistler::wire-prepare-entry) (mapcar #'walk (rest body))))))
              6 nil t)
        (list 'whistler::gr8s-nat-restore
              (cons '(whistler::wire-before-restore)
                    (service-wire-rewrite-body
                     (service-nat-restore-form)
                     '(((whistler::original (whistler::make-gr8s-pkt-flow))
                        . (whistler::original whistler::u64 whistler::target))
                       ((whistler::nat-clear-context) . (whistler::wire-after-restore))
                       ((whistler::nat-pair-required whistler::original whistler::state whistler::probe)
                        . (progn (when (/= whistler::wire-offset 0)
                                   (whistler::wire-validate-reply whistler::state whistler::original))
                                 (whistler::nat-pair-required whistler::original whistler::state whistler::probe))))))
              nil t nil)
        (list 'whistler::gr8s-wire-request (service-wire-request-body) 4 nil nil)
        (list 'whistler::gr8s-wire-reply (service-wire-reply-body) 0 nil nil)
        (list 'whistler::gr8s-wire-receive (service-wire-receive-body) nil nil t)
        (list 'whistler::gr8s-wire-reply-commit (service-wire-reply-commit-body) nil nil nil))
       for form = (service-wire-inner-program
                   (if full-parser (service-packet-program-form name body)
                       (service-nat-program-form name body)) :addresses addresses)
       collect (if next (service-nat-stage-continue form next) form))
     (list (service-nat-delivery-form)
           (service-wire-inner-program (find 'whistler::gr8s-nat-gc programs :key #'second))))))

(defun compile-service-wire-guard ()
  (let* ((forms (service-wire-guard-forms))
         (structs (remove-if (lambda (f) (eq (first f) 'whistler::defprog)) forms))
         (programs (remove-if-not (lambda (f) (eq (first f) 'whistler::defprog)) forms))
         (maps (append (service-nat-guard-map-forms) *service-wire-rx-maps*))
         (map-specs nil) (program-specs nil))
    ;; Compile the expensive selector last so a stack/parser error in another
    ;; stage is reported before spending minutes compiling selection.
    (dolist (program (append (remove 'whistler::gr8s-nat-select programs :key #'second)
                             (remove-if-not (lambda (p) (eq (second p) 'whistler::gr8s-nat-select)) programs)))
      (format *error-output* "~&Compiling Service wire stage ~A~%" (second program))
      (finish-output *error-output*)
      (multiple-value-bind (one-map-specs one-program-specs)
          (compile-whistler-program maps (append structs (list program)))
        (when map-specs (assert (equal map-specs one-map-specs)))
        (setf map-specs one-map-specs
              program-specs (append program-specs one-program-specs))))
    (values map-specs program-specs)))
