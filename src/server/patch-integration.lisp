(in-package #:gr8s.server)
(defvar *patch-coordinator* nil)
(defvar *patch-admin-token* nil)
(defvar *patch-ha* nil)
(defun run-controller-pass (worker)
  "One complete operation. The supervisor and its admission barrier are not patched."
  (when (reconciliation-worker-before-reconcile worker)
    (funcall (reconciliation-worker-before-reconcile worker)))
  (reconcile-all (reconciliation-worker-reconciler worker)
                 :observer (reconciliation-worker-observer worker)))
(gr8s.patch:register-domain "controller-pass" '("GR8S.SERVER::RUN-CONTROLLER-PASS"))
(defun bootstrap-patches (options)
  (when gr8s.patch:*manager* (error "A patch manager is already active"))
  (let ((roles (case (getf options :command)
                 (:serve (if (getf options :disable-agent) '("control-plane") '("control-plane" "worker")))
                 (:witness '("witness")) (t '("worker")))))
    (setf gr8s.patch:*manager*
          (gr8s.patch:open-manager (getf options :state-directory)
                                   (or (getf options :member-id) (getf options :node-name)) roles))
    (let ((file (gr8s.patch::path gr8s.patch:*manager* "admin.token")))
      (unless (probe-file file)
        (gr8s.patch::durable-bytes file (gr8s.patch::octets (gr8s.patch::identifier))))
      (setf *patch-admin-token* (uiop:read-file-string file)))
    (gr8s.patch:recover-manager gr8s.patch:*manager*)))
(defun shutdown-patches ()
  (stop-patch-coordinator)
  (when gr8s.patch:*manager* (gr8s.patch:close-manager gr8s.patch:*manager*))
  (setf gr8s.patch:*manager* nil *patch-admin-token* nil))
(defun patch-store-state (store)
  (with-store-lock (store)
    (let ((value (gethash (core-resource-key "patchrollouts" nil "cluster") (pod-store-resources store))))
      (if value (copy-json-object (gethash "spec" value)) (gr8s.patch::new-cluster-state)))))
(defun update-patch-store-state (store function)
  (with-core-write (store)
    (let* ((key (core-resource-key "patchrollouts" nil "cluster"))
           (resources (copy-core-resource-index store))
           (old (gethash key resources))
           (state (funcall function (if old (copy-json-object (gethash "spec" old)) (gr8s.patch::new-cluster-state))))
           (revision (1+ (pod-store-resource-revision store)))
           (value (core-object "apiVersion" "gr8s.io/v1" "kind" "PatchRolloutState"
                               "metadata" (core-object "name" "cluster") "spec" state)))
      (prepare-core-resource-metadata value old revision)
      (setf (gethash key resources) value)
      (commit-core-resources store resources revision)
      state)))
(pushnew '("patchrollouts" "PatchRolloutState" "gr8s.io/v1" nil)
         gr8s.resources::*internal-stored-resource-types* :test #'equal)
(defun patch-node-call (server name command)
  (let* ((request (make-instance 'gr8s.node.v1::operation-request
                                  :operation-id (gr8s.patch::identifier)
                                  :kind gr8s.node.v1::+operationkind-operation_kind_patch+
                                  :patch-command-json (gr8s.patch::octets (com.inuoe.jzon:stringify command))))
         (operation (request-node-operation server name request :timeout 120))
         (bytes (gr8s.controllers::node-operation-channel-data operation gr8s.node.v1::+streamchannel-stream_channel_stdout+))
         (response (gr8s.apiserver::pending-node-operation-response operation)))
    (unless (and response (zerop (slot-value response 'gr8s.node.v1::exit-code)))
      (error "Node patch operation failed: ~A" (if response (slot-value response 'gr8s.node.v1::error-message) name)))
    (com.inuoe.jzon:parse (gr8s.patch::text (coerce bytes '(vector (unsigned-byte 8)))))))
(defun patch-member-call (member peer command)
  (let ((channel (gr8s::make-raft-channel
                  (gr8s.raft.transport::raft-member-credentials member)
                  (gethash "host" peer) (gethash "port" peer) 15)))
    (unwind-protect
         (let ((response
                 (gr8s.node.v1::raft-transport-patch-management
                  (gr8s.node.v1::make-raft-transport-stub channel)
                  (make-instance 'gr8s.node.v1::patch-management-request
                                 :command-json (gr8s.patch::octets (com.inuoe.jzon:stringify command))) :timeout 120)))
           (when (plusp (length (gr8s.node.v1::error-message response)))
             (error "Member patch operation: ~A" (gr8s.node.v1::error-message response)))
           (com.inuoe.jzon:parse (gr8s.patch::text (gr8s.node.v1::result-json response))))
      (ag-grpc:channel-close channel))))
(defun patch-members (ha)
  (when ha
    (let ((member (gr8s.ha:ha-control-plane-member ha)))
      (bt:with-lock-held ((gr8s.raft.transport::raft-member-lock member))
        (let* ((node (gr8s.raft.transport::raft-member-node member))
               (self (gr8s.raft:raft-node-id node)))
          (loop for (id . role) in (gr8s.raft:raft-current-config node)
                for address = (gethash id (gr8s.raft:raft-node-peer-addresses node))
                collect (gr8s.patch::object "id" (concatenate 'string "member:" id) "memberID" id
                                            "role" (if (eq role :witness) "witness" "control-plane")
                                            "voter" (eq role :voter) "witness" (eq role :witness)
                                            "leader" (equal id (gr8s.raft:raft-node-leader-id node))
                                            "local" (equal id self) "host" (first address) "port" (second address))))))))
(defun start-patch-coordinator (store server ha)
  (setf *patch-ha* ha)
  (labels ((call-peer (peer command)
             (cond ((if (gethash "memberID" peer)
                         (and ha (equal (gethash "memberID" peer)
                                        (gr8s.raft:raft-node-id (gr8s.raft.transport::raft-member-node
                                                               (gr8s.ha:ha-control-plane-member ha)))))
                         (and (gethash "local" peer) (equal (gethash "id" peer) (manager-name-for-patches))))
                    (if (and (equal "ready-to-apply" (gethash "action" command))
                             ha (gr8s.ha:ha-control-plane-leader-p ha)
                             (patch-transfer-leadership ha))
                        (gr8s.patch::object "transferring" t)
                        (gr8s.patch:handle-command gr8s.patch:*manager* command)))
                   ((gethash "memberID" peer) (patch-member-call (gr8s.ha:ha-control-plane-member ha) peer command))
                   (t (patch-node-call server (gethash "node" peer) command))))
           (inventory-peers ()
             (let* ((members (patch-members ha))
                    (self (or (find-if (lambda (p) (gethash "local" p)) members)
                              (gr8s.patch::object "id" (manager-name-for-patches) "local" t "role" "control-plane")))
                    (peers (or members (list self)))
                    (boots (make-hash-table :test 'equal)))
               (dolist (peer peers)
                 (setf (gethash (gethash "bootID" (call-peer peer (gr8s.patch::object "action" "inventory"))) boots) t))
               ;; Persisted Node inventory includes offline nodes; do not silently omit them.
               (dolist (node (list-nodes store))
                 (let* ((name (node-record-name node))
                        (peer (gr8s.patch::object "id" name "node" name "role" "worker"))
                        (report (call-peer peer (gr8s.patch::object "action" "inventory")))
                        (boot (gethash "bootID" report)))
                   (unless (gethash boot boots)
                     (setf (gethash boot boots) t) (push peer peers))))
               peers)))
    (setf *patch-coordinator*
          (gr8s.patch:start-coordinator
           (gr8s.patch:make-coordinator
            :manager gr8s.patch:*manager* :read-state (lambda () (patch-store-state store))
            :update-state (lambda (function) (update-patch-store-state store function))
            :participants #'inventory-peers :call #'call-peer
            :leader-p (lambda () (or (null ha) (gr8s.ha:ha-control-plane-leader-p ha))))))))
(defun manager-name-for-patches () (gr8s.patch::manager-name gr8s.patch:*manager*))
(defun stop-patch-coordinator ()
  (when *patch-coordinator* (gr8s.patch:stop-coordinator *patch-coordinator*) (setf *patch-coordinator* nil))
  (setf *patch-ha* nil))
(defun dispatch-patch-command (command)
  (if (and *patch-ha* (not (gr8s.ha:ha-control-plane-leader-p *patch-ha*)))
      (let ((leader (find-if (lambda (peer) (gethash "leader" peer)) (patch-members *patch-ha*))))
        (unless leader (error "No patch coordinator leader is available"))
        (patch-member-call (gr8s.ha:ha-control-plane-member *patch-ha*) leader
                           (gr8s.patch::object "action" "coordinate" "command" command)))
      (gr8s.patch:coordinator-command *patch-coordinator* command)))
(defun patch-transfer-leadership (ha)
  (let* ((member (gr8s.ha:ha-control-plane-member ha))
         (candidate
           (bt:with-lock-held ((gr8s.raft.transport::raft-member-lock member))
             (let* ((node (gr8s.raft.transport::raft-member-node member))
                    (self (gr8s.raft:raft-node-id node)))
               (loop for (id . role) in (gr8s.raft:raft-current-config node)
                     when (and (eq role :voter) (not (equal id self))
                               (>= (gethash id (gr8s.raft:raft-node-match-index node) 0)
                                   (gr8s.raft:raft-node-commit-index node)))
                       return id)))))
    ;; A one-member cluster cannot transfer leadership and declares a local pause.
    (when (> (length (gr8s.raft.transport:raft-cluster-members member)) 1)
      (unless candidate (error "No caught-up voter available for patch leadership transfer"))
      (let* ((peer (find candidate (patch-members ha) :key (lambda (p) (gethash "memberID" p)) :test #'equal))
             (report (patch-member-call member peer (gr8s.patch::object "action" "inventory"))))
        (unless (and (equal "healthy" (gethash "state" report))
                     (>= (gethash "loadedLevel" report) (1+ (gr8s.patch::manager-loaded-level gr8s.patch:*manager*))))
          (error "Leadership transfer target is not healthy and patch-compatible"))
        (patch-member-call member peer (gr8s.patch::object "action" "campaign")))
      ;; The new leader resumes the committed plan. Do not create a grant in the old term.
      t)))

(in-package #:gr8s.patch)
(defun handle-member-command (member peer request)
  (let* ((command (com.inuoe.jzon:parse (text (gr8s.node.v1::command-json request))))
         (action (gethash "action" command)))
    (handler-case
        (let ((result
                (progn
                  (bt:with-lock-held ((gr8s.raft.transport::raft-member-lock member))
                    (let ((node (gr8s.raft.transport::raft-member-node member)))
                      (unless (and (assoc peer (gr8s.raft:raft-current-config node) :test #'equal)
                                   (eq :voter (gr8s.raft:raft-member-role node peer)))
                        (error "Patch management requires an enrolled control-plane voter"))
                      (unless (or (member action '("inventory" "history" "coordinate") :test #'equal)
                                  (equal peer (gr8s.raft:raft-node-leader-id node)))
                        (error "Only the current leader may deliver a patch management command"))
                      (when (equal action "campaign")
                        (unless (and (eq :voter (gr8s.raft:raft-node-self-role node))
                                     (not (gr8s.raft:raft-leader-p node)))
                          (error "Only a follower voter may accept leadership transfer"))
                        (gr8s.raft:raft-become-candidate node))))
                  (cond ((equal action "campaign") (object "campaigning" t))
                        ((equal action "coordinate")
                         (unless (and gr8s.server::*patch-coordinator*
                                      (gr8s.raft.transport:raft-member-leader-p member))
                           (error "Patch coordinator leadership changed; retry the command"))
                         (coordinator-command gr8s.server::*patch-coordinator* (gethash "command" command)))
                        (t (unless *manager* (error "Patch loader is unavailable"))
                           (handle-command *manager* command))))))
          (make-instance 'gr8s.node.v1::patch-management-response :result-json (octets (com.inuoe.jzon:stringify result))))
      (error (condition)
        (make-instance 'gr8s.node.v1::patch-management-response :error-message (princ-to-string condition))))))
(defun start-node-patch-operation (request emit)
  (bt:make-thread
   (lambda ()
     (handler-case
         (let ((result (progn (unless *manager* (error "Patch loader is unavailable"))
                              (handle-command *manager* (com.inuoe.jzon:parse (text (slot-value request 'gr8s.node.v1::patch-command-json)))))))
           (funcall emit :operation-stream
                    (make-instance 'gr8s.node.v1::operation-stream
                                   :operation-id (slot-value request 'gr8s.node.v1::operation-id)
                                   :channel gr8s.node.v1::+streamchannel-stream_channel_stdout+
                                   :data (octets (com.inuoe.jzon:stringify result)) :eof t))
           (funcall emit :operation-response
                    (make-instance 'gr8s.node.v1::operation-response :operation-id (slot-value request 'gr8s.node.v1::operation-id)
                                   :status gr8s.node.v1::+operationstatus-operation_status_complete+ :exit-code 0)))
       (error (condition)
         (funcall emit :operation-response
                  (make-instance 'gr8s.node.v1::operation-response :operation-id (slot-value request 'gr8s.node.v1::operation-id)
                                 :status gr8s.node.v1::+operationstatus-operation_status_failed+
                                 :exit-code 1 :error-message (princ-to-string condition)))))) :name "gr8s patch management"))

(in-package #:gr8s.apiserver)
(defun serve-patch-request (store method)
  (unless (member method '(:get :post)) (core-resource-error 405 "MethodNotAllowed" "Patch commands require GET or POST"))
  (unless gr8s.server::*patch-coordinator* (core-resource-error 503 "ServiceUnavailable" "Patch coordinator is unavailable"))
  (let* ((raw (when (eq method :post) (hunchentoot:raw-post-data :force-text t)))
         (command (if raw (com.inuoe.jzon:parse raw) (gr8s.patch::object "action" "status")))
         (action (gethash "action" command)))
    (if *authenticated-api-identity*
        (unless (service-account-authorized-p store *authenticated-api-identity* "create" "gr8s.io"
                                              (format nil "patchrollouts/~A" action) nil nil nil)
          (core-resource-error 403 "Forbidden" "Patch action ~A requires explicit upgrade authority" action))
        (let* ((header (hunchentoot:header-in* :authorization))
               (expected gr8s.server::*patch-admin-token*))
          (unless (and expected header
                       (ironclad:constant-time-equal (gr8s.patch::octets header)
                                                    (gr8s.patch::octets (concatenate 'string "Bearer " expected))))
            (core-resource-error 401 "Unauthorized" "Patch management requires the local patch admin token or authenticated upgrade authority"))))
    (setf (gethash "requester" command)
          (if *authenticated-api-identity* (api-identity-username *authenticated-api-identity*) "system:local-patch-admin"))
    (handler-case
        (json-response (gr8s.server::dispatch-patch-command command))
      (error (condition) (core-resource-error 409 "Conflict" "~A" condition)))))

(in-package #:gr8s.server)
(defun validate-patch-admission (store bytes)
  (let* ((state (patch-store-state store))
         (minimum (gethash "policyLevel" state 0)))
    (when (plusp minimum)
      (let ((report (and (plusp (length bytes)) (com.inuoe.jzon:parse (gr8s.patch::text bytes)))))
        (unless (and report (equal "healthy" (gethash "state" report))
                     (equal gr8s.patch:*build-id* (gethash "buildID" report))
                     (>= (gethash "loadedLevel" report 0) minimum)
                     (let ((chains (gethash "chains" report)))
                       (and (vectorp chains) (>= (length chains) minimum)
                            (equal (gethash "policyChain" state) (aref chains (1- minimum))))))
          (error "Process must recover/import patch level ~D before cluster admission" minimum)))) t))
(defun validate-member-patch-admission (member bytes)
  (declare (ignore member))
  (when *patch-coordinator*
    (let* ((state (gr8s.patch::cluster-state *patch-coordinator*))
           (minimum (gethash "policyLevel" state 0)))
      (when (or (plusp minimum) (gr8s.patch::active-plan-id state))
        (when (gr8s.patch::active-plan-id state) (error "Raft membership is frozen during a patch rollout"))
        (let ((report (and (plusp (length bytes)) (com.inuoe.jzon:parse (gr8s.patch::text bytes)))))
          (unless (and report (equal gr8s.patch:*build-id* (gethash "buildID" report))
                       (equal "healthy" (gethash "state" report))
                       (>= (gethash "loadedLevel" report 0) minimum)
                       (or (zerop minimum)
                           (let ((chains (gethash "chains" report)))
                             (and (vectorp chains) (>= (length chains) minimum)
                                  (equal (gethash "policyChain" state) (aref chains (1- minimum)))))))
            (error "Member does not meet the committed patch policy")))))))
