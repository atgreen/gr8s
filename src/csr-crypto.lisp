;;;; Purpose:
;;;; Parse actual PKCS#10 PEM/DER requests and verify their signatures with the
;;;; declared public key. Extract signed subjects and requested SANs for approved
;;;; signing, and validate real PEM certificate chains submitted to CSR status.
;;;; No certificate or successful verification is inferred from object fields.

(in-package #:gr8s)

(defstruct parsed-certificate-request
  "Retain only cryptographically verified request material for signer policy."
  subject subject-der spki spki-der sans san-extension)

(defun csr-invalid (control &rest arguments)
  "Report Kubernetes admission failure without exposing private PKI material."
  (apply #'core-resource-error 422 "Invalid" control arguments))

(defun der-element-end (bytes start limit depth)
  "Return where the DER element at START ends, or NIL unless it lies within LIMIT
   with every nested element inside its parent."
  (when (or (> depth 64) (>= start limit)) (return-from der-element-end nil))
  (let ((position (1+ start)) (constructed (logbitp 5 (aref bytes start))))
    (when (= 31 (logand (aref bytes start) 31))
      (loop (when (>= position limit) (return-from der-element-end nil))
            (unless (logbitp 7 (aref bytes position)) (incf position) (return))
            (incf position)))
    (when (>= position limit) (return-from der-element-end nil))
    (let ((first (aref bytes position)) (length 0))
      (incf position)
      (cond ((< first #x80) (setf length first))
            ((or (= first #x80) (> (logand first #x7f) 4)) (return-from der-element-end nil))
            (t (dotimes (i (logand first #x7f))
                 (when (>= position limit) (return-from der-element-end nil))
                 (setf length (logior (ash length 8) (aref bytes position)))
                 (incf position))))
      (let ((end (+ position length)))
        (when (> end limit) (return-from der-element-end nil))
        (when constructed
          (loop while (< position end)
                do (setf position (or (der-element-end bytes position end (1+ depth))
                                      (return-from der-element-end nil)))))
        end))))

(defun der-well-formed-p (bytes)
  "True when BYTES is exactly one DER element whose nested lengths all fit.
   pure-tls's DER parser loops without end on a truncated constructed element,
   so untrusted DER is checked here before it is parsed."
  (and (plusp (length bytes))
       (eql (length bytes) (der-element-end bytes 0 (length bytes) 0))))

(defun csr-pem-blocks (bytes)
  "Decode actual complete PEM blocks, retaining labels and rejecting PEM headers."
  (let ((text (trivial-utf-8:utf-8-bytes-to-string bytes)) (offset 0) (blocks nil))
    (loop for begin = (search "-----BEGIN " text :start2 offset) while begin
          do (let* ((label-start (+ begin 11)) (label-end (search "-----" text :start2 label-start))
                    (label (and label-end (subseq text label-start label-end)))
                    (end-marker (and label (format nil "-----END ~A-----" label)))
                    (end (and end-marker (search end-marker text :start2 (+ label-end 5)))))
               (unless end (csr-invalid "Malformed PEM block"))
               (let* ((encoded (subseq text (+ label-end 5) end))
                      (clean (remove-if (lambda (character) (find character '(#\Space #\Tab #\Return #\Linefeed))) encoded)))
                 (when (find #\: clean) (csr-invalid "PEM headers are not permitted"))
                 (push (cons label (handler-case (core-base64-bytes clean "PEM block")
                                    (kubernetes-error () (csr-invalid "Invalid PEM block encoding")))) blocks))
               (setf offset (+ end (length end-marker)))))
    (nreverse blocks)))

(defun validate-csr-san-extension (extension)
  "Validate actual GeneralName DER and IA5/IP forms before admitting a signed request."
  (let* ((fields (pure-tls::asn1-children extension))
         (bytes (pure-tls::asn1-node-value (car (last fields))))
         (root (pure-tls::parse-der bytes)))
    (unless (and (pure-tls::asn1-sequence-p root) (equalp bytes (pure-tls::asn1-node-raw-bytes root)))
      (csr-invalid "Invalid subjectAltName extension encoding"))
    (dolist (name (pure-tls::asn1-children root))
      (let ((tag (pure-tls::asn1-node-tag name)) (value (pure-tls::asn1-node-value name)))
        (unless (= 2 (pure-tls::asn1-node-class name)) (csr-invalid "Invalid GeneralName class"))
        (when (member tag '(1 2 6 7))
          (when (pure-tls::asn1-node-constructed name) (csr-invalid "Invalid constructed SAN value"))
          (if (= tag 7)
              (unless (member (length value) '(4 16)) (csr-invalid "IP SAN must contain 4 or 16 address bytes"))
              (unless (every (lambda (byte) (< byte 128)) value) (csr-invalid "DNS/email/URI SAN must contain ASCII IA5 data")))
          (when (= tag 6)
            (handler-case (puri:parse-uri (map 'string #'code-char value))
              (error () (csr-invalid "Invalid URI SAN")))))))))

(defun csr-requested-extensions (info)
  "Extract signed extensionRequest attributes and reject duplicate extension OIDs."
  (let ((extensions nil) (seen (make-hash-table :test #'equal)))
    (dolist (attribute (and (fourth (pure-tls::asn1-children info))
                           (pure-tls::asn1-children (fourth (pure-tls::asn1-children info)))))
      (let ((parts (pure-tls::asn1-children attribute)))
        (unless (and (pure-tls::asn1-sequence-p attribute) (= 2 (length parts))
                     (= 6 (pure-tls::asn1-node-tag (first parts))) (= 0 (pure-tls::asn1-node-class (first parts)))
                     (= 17 (pure-tls::asn1-node-tag (second parts))) (= 0 (pure-tls::asn1-node-class (second parts))))
          (csr-invalid "Invalid CSR attribute"))
        (when (equal '(1 2 840 113549 1 9 14) (pure-tls::asn1-node-value (first parts)))
          (dolist (extension-list (pure-tls::asn1-children (second parts)))
            (dolist (extension (pure-tls::asn1-children extension-list))
              (let* ((fields (pure-tls::asn1-children extension))
                     (oid (pure-tls::asn1-node-value (first fields))))
                (unless (and (pure-tls::asn1-sequence-p extension) (member (length fields) '(2 3)) (listp oid)
                             (= 0 (pure-tls::asn1-node-class (first fields))) (= 6 (pure-tls::asn1-node-tag (first fields)))
                             (= 0 (pure-tls::asn1-node-class (car (last fields)))) (= 4 (pure-tls::asn1-node-tag (car (last fields))))
                             (or (= 2 (length fields)) (and (= 0 (pure-tls::asn1-node-class (second fields))) (= 1 (pure-tls::asn1-node-tag (second fields))))))
                  (csr-invalid "Invalid requested CSR extension"))
                (when (gethash oid seen) (csr-invalid "Duplicate requested CSR extension"))
                (setf (gethash oid seen) t)
                (when (equal oid '(2 5 29 17)) (validate-csr-san-extension extension))
                ;; Parsing also validates known SAN/usage/basic constraint DER.
                (pure-tls::parse-x509-extension extension)
                (push extension extensions)))))))
    (nreverse extensions)))

(defun validate-csr-pss-parameters (algorithm parameters)
  "Match Go x509 PSS rules instead of inferring salt or ignoring MGF parameters."
  (let* ((node (second (pure-tls::asn1-children algorithm)))
         (fields (and node (pure-tls::asn1-children node)))
         (seen (make-hash-table))
         (hash-size (cdr (assoc (getf parameters :hash) '((:sha256 . 32) (:sha384 . 48) (:sha512 . 64))))))
    (unless (and node (pure-tls::asn1-sequence-p node) hash-size) (csr-invalid "Unsupported RSA-PSS hash parameters"))
    (dolist (field fields)
      (let ((tag (pure-tls::asn1-node-tag field)))
        (unless (and (pure-tls::asn1-context-p field tag) (<= 0 tag 3) (not (gethash tag seen))
                     (= 1 (length (pure-tls::asn1-children field))))
          (csr-invalid "Invalid RSA-PSS parameter structure"))
        (setf (gethash tag seen) (first (pure-tls::asn1-children field)))))
    (let* ((hash (gethash 0 seen)) (mask (gethash 1 seen)) (salt (gethash 2 seen)) (trailer (gethash 3 seen))
           (mask-parts (and mask (pure-tls::asn1-children mask))))
      (unless (and hash mask salt (= 2 (length mask-parts))
                   (equal '(1 2 840 113549 1 1 8) (pure-tls::asn1-node-value (first mask-parts)))
                   (equal (pure-tls::asn1-node-value (first (pure-tls::asn1-children hash)))
                          (pure-tls::asn1-node-value (first (pure-tls::asn1-children (second mask-parts)))))
                   (eql hash-size (pure-tls::asn1-node-value salt))
                   (or (not trailer) (eql 1 (pure-tls::asn1-node-value trailer))))
        (csr-invalid "RSA-PSS requires matching MGF1/hash, digest-length salt and trailer 1")))))

(defun csr-subject-name (node)
  "Decode actual X.509 RDN strings, including BMP forms used in signer restrictions."
  (unless (pure-tls::asn1-sequence-p node) (csr-invalid "CSR subject must be a Name sequence"))
  (let ((rdns nil))
    (dolist (set (pure-tls::asn1-children node))
      (unless (and (= 0 (pure-tls::asn1-node-class set)) (= 17 (pure-tls::asn1-node-tag set))
                   (pure-tls::asn1-children set)) (csr-invalid "Invalid subject RDN set"))
      (dolist (attribute (pure-tls::asn1-children set))
        (let* ((parts (pure-tls::asn1-children attribute)) (oid (first parts)) (value (second parts))
               (tag (and value (pure-tls::asn1-node-tag value)))
               (decoded (and value (pure-tls::asn1-node-value value))))
          (unless (and (pure-tls::asn1-sequence-p attribute) (= 2 (length parts))
                       (= 0 (pure-tls::asn1-node-class oid)) (= 6 (pure-tls::asn1-node-tag oid))
                       (= 0 (pure-tls::asn1-node-class value)) (member tag '(12 18 19 20 22 30)))
            (csr-invalid "Invalid subject attribute encoding"))
          (setf decoded
                (cond ((stringp decoded) decoded)
                      ((= tag 30)
                       (unless (evenp (length decoded)) (csr-invalid "Invalid BMP subject string"))
                       (when (and (>= (length decoded) 2) (zerop (aref decoded (1- (length decoded))))
                                  (zerop (aref decoded (- (length decoded) 2))))
                         (setf decoded (subseq decoded 0 (- (length decoded) 2))))
                       (coerce (loop for index from 0 below (length decoded) by 2
                                     for code = (+ (ash (aref decoded index) 8) (aref decoded (1+ index)))
                                     do (when (or (<= #xd800 code #xdfff) (<= #xfdd0 code #xfdef) (member code '(#xfffe #xffff))) (csr-invalid "Invalid BMP character"))
                                     collect (or (code-char code) (csr-invalid "Invalid BMP character"))) 'string))
                      (t (map 'string #'code-char decoded))))
          (when (and (member tag '(18 19 22)) (some (lambda (character) (> (char-code character) 127)) decoded))
            (csr-invalid "Invalid non-ASCII subject attribute"))
          (when (and (= tag 18) (not (every (lambda (character) (or (digit-char-p character) (char= character #\Space))) decoded)))
            (csr-invalid "Invalid NumericString subject attribute"))
          (when (and (= tag 19) (not (every (lambda (character) (or (alphanumericp character) (find character " '()+,-./:=?*&"))) decoded)))
            (csr-invalid "Invalid PrintableString subject attribute"))
          (push (cons (pure-tls::oid-name (pure-tls::asn1-node-value oid)) decoded) rdns))))
    (pure-tls::make-x509-name :rdns (nreverse rdns))))

(defun csr-subject-common-name (subject)
  "Use the last signed common-name attribute, matching Go pkix.Name.FillFromRDNSequence."
  (cdr (assoc :common-name (reverse (pure-tls::x509-name-rdns subject)))))

(defun validate-csr-public-key-algorithm (algorithm algorithm-node spki-node spki)
  "Require the declared public-key family to match the real signature algorithm."
  (let* ((key-algorithm (getf spki :algorithm))
         (key-parts (pure-tls::asn1-children spki-node))
         (rsa (member algorithm '(:sha256-with-rsa-encryption :sha384-with-rsa-encryption :sha512-with-rsa-encryption :rsa-pss :rsassa-pss)))
         (ec (member algorithm '(:ecdsa-with-sha256 :ecdsa-with-sha384 :ecdsa-with-sha512))))
    (unless (and (pure-tls::asn1-sequence-p spki-node) (= 2 (length key-parts))
                 (= 0 (pure-tls::asn1-node-class (second key-parts)))
                 (= pure-tls::+asn1-bit-string+ (pure-tls::asn1-node-tag (second key-parts)))
                 (eql 0 (getf (pure-tls::asn1-node-value (second key-parts)) :unused-bits))
                 (or (and rsa (eq key-algorithm :rsa-encryption))
                     (and ec (member key-algorithm '(:prime256v1 :secp384r1 :secp521r1)))
                     (and (eq algorithm :ed25519) (eq key-algorithm :ed25519)
                          (= 1 (length (pure-tls::asn1-children algorithm-node)))
                          (= 1 (length (pure-tls::asn1-children (first key-parts)))))))
      (csr-invalid "Unsupported or inconsistent CSR key/signature algorithm"))))

(defun parse-and-verify-certificate-request (bytes)
  "Validate PKCS#10 structure and its actual RSA/ECDSA/EdDSA proof of possession."
  (handler-case
      (let* ((blocks (csr-pem-blocks bytes)) (block (first blocks)))
        (unless (and block (equal "CERTIFICATE REQUEST" (car block)))
          (csr-invalid "spec.request must contain a CERTIFICATE REQUEST PEM block"))
        (unless (der-well-formed-p (cdr block)) (csr-invalid "Invalid PKCS#10 request structure"))
        (let* ((der (cdr block)) (root (pure-tls::parse-der der))
               (children (pure-tls::asn1-children root))
               (info (first children)) (parts (and info (pure-tls::asn1-children info)))
               (signature (third children)))
          (unless (and (pure-tls::asn1-sequence-p root) (= 3 (length children))
                       (equalp der (pure-tls::asn1-node-raw-bytes root))
                       (pure-tls::asn1-sequence-p info) (<= 3 (length parts) 4)
                       (= 0 (pure-tls::asn1-node-class (first parts)))
                       (= 2 (pure-tls::asn1-node-tag (first parts)))
                       (eql 0 (pure-tls::asn1-node-value (first parts)))
                       (or (= 3 (length parts)) (pure-tls::asn1-context-p (fourth parts) 0))
                       (pure-tls::asn1-sequence-p (second children))
                       (= 0 (pure-tls::asn1-node-class signature))
                       (= pure-tls::+asn1-bit-string+ (pure-tls::asn1-node-tag signature))
                       (eql 0 (getf (pure-tls::asn1-node-value signature) :unused-bits)))
            (csr-invalid "Invalid PKCS#10 request structure"))
          (multiple-value-bind (algorithm parameters)
              (pure-tls::parse-algorithm-identifier-with-params (second children))
            (when (member algorithm '(:rsa-pss :rsassa-pss))
              (validate-csr-pss-parameters (second children) parameters))
            (let* ((spki (pure-tls::parse-subject-public-key-info (third parts)))
                   (verified (progn
                               (validate-csr-public-key-algorithm algorithm (second children) (third parts) spki)
                               (pure-tls::verify-certificate-signature
                              (pure-tls::make-x509-certificate
                               :tbs-raw (pure-tls::asn1-node-raw-bytes info) :signature-algorithm algorithm
                               :signature-algorithm-params parameters :signature (getf (pure-tls::asn1-node-value signature) :data))
                              (pure-tls::make-x509-certificate :subject-public-key-info spki))))
                   (extensions (and verified (csr-requested-extensions info)))
                   (san (find '(2 5 29 17) extensions :test #'equal
                              :key (lambda (extension) (pure-tls::asn1-node-value (first (pure-tls::asn1-children extension)))))))
              (unless verified (csr-invalid "CSR signature verification failed"))
              (make-parsed-certificate-request
               :subject (csr-subject-name (second parts)) :subject-der (pure-tls::asn1-node-raw-bytes (second parts))
               :spki spki :spki-der (pure-tls::asn1-node-raw-bytes (third parts))
               :sans (and san (pure-tls::x509-extension-value (pure-tls::parse-x509-extension san)))
               :san-extension (and san (pure-tls::asn1-node-raw-bytes san)))))))
    (kubernetes-error (condition) (error condition))
    (error (condition) (csr-invalid "Could not parse or verify CSR: ~A" condition))))

(defun validate-csr-certificate-der (bytes)
  "Validate each actual X.509 DER object, including SAN forms and complete consumption."
  (loop with offset = 0 while (< offset (length bytes))
        do (let* ((remaining (subseq bytes offset))
                  (root (if (der-element-end remaining 0 (length remaining) 0)
                            (pure-tls::parse-der remaining)
                            (csr-invalid "Invalid certificate DER structure")))
                  (raw (pure-tls::asn1-node-raw-bytes root))
                  (parts (pure-tls::asn1-children root))
                  (tbs (and (first parts) (pure-tls::asn1-children (first parts))))
                  (version (and tbs (pure-tls::asn1-context-p (first tbs) 0))))
             (unless (and (pure-tls::asn1-sequence-p root) (= 3 (length parts)) (plusp (length raw)))
               (csr-invalid "Invalid certificate DER structure"))
             (pure-tls:parse-certificate raw)
             (when (minusp (pure-tls::asn1-node-value (nth (if version 1 0) tbs)))
               (csr-invalid "Certificate serial number cannot be negative"))
             (csr-subject-name (nth (if version 3 2) tbs))
             (csr-subject-name (nth (if version 5 4) tbs))
             (dolist (field tbs)
               (when (pure-tls::asn1-context-p field 3)
                 (dolist (extension (pure-tls::asn1-children (first (pure-tls::asn1-children field))))
                   (when (equal '(2 5 29 17) (pure-tls::asn1-node-value (first (pure-tls::asn1-children extension))))
                     (validate-csr-san-extension extension)))))
             (incf offset (length raw))))
  bytes)

(defun validate-csr-certificate-chain (bytes)
  "Require actual X.509 certificates in every PEM block without imposing signer policy."
  (unless (zerop (length bytes))
    (handler-case
        (let ((blocks (csr-pem-blocks bytes)))
          (unless blocks (csr-invalid "status.certificate requires at least one certificate PEM block"))
          (dolist (block blocks)
            (unless (equal "CERTIFICATE" (car block)) (csr-invalid "Only CERTIFICATE PEM blocks are allowed"))
            (validate-csr-certificate-der (cdr block))))
      (kubernetes-error (condition) (error condition))
      (error (condition) (csr-invalid "Invalid certificate data: ~A" condition))))
  bytes)
